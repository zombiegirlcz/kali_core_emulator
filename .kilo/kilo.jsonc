{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/deepseek/deepseek-v4-flash:free",
  "small_model": "kilo/deepseek/deepseek-v4-flash:free",
  "agent": {
    "plan": {
      "model": "kilo/deepseek/deepseek-v4-pro"
    },
    "debug": {
      "model": "kilo/deepseek/deepseek-v4-pro"
    },
    "orchestrator": {
      "model": "kilo/deepseek/deepseek-v3.1-terminus"
    },
    "code": {
      "model": "kilo/deepseek/deepseek-v3.1-terminus"
    }
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "external_directory": "allow"
  },
  "share": "auto",
  "remote_control": true,
  "experimental": {
    "batch_tool": true,
    "codebase_search": true,
    "semantic_indexing": true,
    "agent_manager_tool": true,
    "openTelemetry": true,
    "continue_loop_on_deny": true
  },
  "disabled_providers": []
}