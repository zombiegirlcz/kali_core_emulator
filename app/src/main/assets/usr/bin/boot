# ─── Guest shell discovery helper ────────────────────────
find_sh() {
    # $1 = ROOTFS path; prints relative shell path or empty
    local _rootfs="$1"
    for _cand in "$_rootfs/bin/sh" "$_rootfs/usr/bin/sh"; do
        if [ -x "$_cand" ]; then echo "${_cand#"$_rootfs"}"; return 0; fi
    done
    return 1
}

# ─── Assemble bind mounts ───────────────────────────────
build_binds() {
    # $1 = distro name for sysdata/shm
    local distro="${1:-kali}"
    local _binds="-b /dev -b /proc -b /sys"
    local SYSROOT="$FILES_DIR/nh"

    # sysdata + shm (skip in minimal mode)
    if [ "$NH_MINIMAL" = "0" ]; then
        _binds="$_binds -b $SYSROOT/sysdata/$distro/loadavg:/proc/loadavg"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/stat:/proc/stat"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/uptime:/proc/uptime"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/version:/proc/version"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/vmstat:/proc/vmstat"
        # Individual sysctl substitutes (bind files, not the whole /proc/sys).
        _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/kernel/cap_last_cap:/proc/sys/kernel/cap_last_cap"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/fs/inotify/max_user_watches:/proc/sys/fs/inotify/max_user_watches"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/kernel/overflowuid:/proc/sys/kernel/overflowuid"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/kernel/overflowgid:/proc/sys/kernel/overflowgid"
        _binds="$_binds -b $SYSROOT/sysdata/$distro/sys_empty:/sys/fs/selinux"
        _binds="$_binds -b $SYSROOT/shm/$distro:/dev/shm"
    fi

    # Device fixes are part of the non-minimal stack (minimal = bare
    # /dev, /proc, /sys only).
    if [ "$NH_MINIMAL" = "0" ]; then
        # Standard /dev fixes (Android lacks /dev/random, /dev/fd, etc.)
        [ -e /dev/random ] || _binds="$_binds -b /dev/urandom:/dev/random"
        [ -e /dev/fd ] || _binds="$_binds -b /proc/self/fd:/dev/fd"
        [ -e /dev/stdin ] || _binds="$_binds -b /proc/self/fd/0:/dev/stdin"
        [ -e /dev/stdout ] || _binds="$_binds -b /proc/self/fd/1:/dev/stdout"
        [ -e /dev/stderr ] || _binds="$_binds -b /proc/self/fd/2:/dev/stderr"
    fi

    # Host paths are visible only outside isolated mode. Isolated sessions
    # deliberately see just /dev, /proc and /sys.
    if [ "$NH_ISOLATED" = "0" ]; then
        for _p in /apex /odm /product /system /system_ext /vendor; do
            [ -d "$_p" ] && [ -x "$_p" ] && _binds="$_binds -b $_p"
        done
        [ -f /linkerconfig/ld.config.txt ] && _binds="$_binds -b /linkerconfig/ld.config.txt"
        [ -f /linkerconfig/com.android.art/ld.config.txt ] && _binds="$_binds -b /linkerconfig/com.android.art/ld.config.txt"
        [ -f /plat_property_contexts ] && _binds="$_binds -b /plat_property_contexts"
        [ -f /property_contexts ] && _binds="$_binds -b /property_contexts"

        [ -d /storage ] && _binds="$_binds -b /storage"
        [ -d /storage/emulated/0 ] && _binds="$_binds -b /storage/emulated/0"
        [ -d /sdcard ] && _binds="$_binds -b /sdcard"
        [ -d /mnt/sdcard ] && _binds="$_binds -b /mnt/sdcard"
        [ -d /data/app ] && _binds="$_binds -b /data/app"
        [ -d /data/dalvik-cache ] && _binds="$_binds -b /data/dalvik-cache"
    fi
    # Host-side tools live in $FILES_DIR/usr/{bin,lib} (deployed by ProotManager);
    # no host app prefix is bound into the guest.

    # App-managed dirs (skip in isolated/minimal mode)
    if [ "$NH_ISOLATED" = "0" ]; then
        _binds="$_binds -b $FILES_DIR/tmp:$FILES_DIR/tmp"
        _binds="$_binds -b $FILES_DIR/ipc:/run/host_ipc"
        mkdir -p "$FILES_DIR/share" 2>/dev/null || true
        _binds="$_binds -b $FILES_DIR/share:/root/share"
    fi
    [ "$NH_MOUNT_STORAGE" = "1" ] && [ "$NH_ISOLATED" = "0" ] && _binds="$_binds -b /sdcard"

    # Extra binds from preferences / CLI
    [ -n "${NH_EXTRA_MOUNTS:-}" ] && _binds="$_binds $NH_EXTRA_MOUNTS"
    [ -n "${NH_EXTRA_BINDS:-}" ] && _binds="$_binds $NH_EXTRA_BINDS"

    echo "$_binds"
}

# ─── Host-shell image detection ─────────────────────────
is_termux_image() {
    # $1 = ROOTFS
    [ -f "$1/data/data/com.termux/files/usr/bin/login" ]
}

# ─── Profile injection for host-shell images only ─
inject_profile() {
    # $1 = ROOTFS
    # Skip for regular images (Kali/Parrot manage their own /etc).
    local ROOTFS="$1"
    is_termux_image "$ROOTFS" || return 0
    local PROFILE_DIR="$ROOTFS/etc/profile.d"
    mkdir -p "$PROFILE_DIR"
    cat > "$PROFILE_DIR/termux-profile.sh" << 'PROF'
#!/bin/sh
# NetHunter: obnovení PATH a env proměnných při každém login shellu
export PATH="/data/data/com.termux/files/usr/bin:/data/data/com.termux/files/usr/sbin:$PATH"
export HOME="${HOME:-/root}"
export PREFIX="/data/data/com.termux/files/usr"
export LD_LIBRARY_PATH="/system/lib64:/system/lib:$PREFIX/lib:$LD_LIBRARY_PATH"
export USER="${USER:-root}"
export SHELL="${SHELL:-/bin/bash}"
export TERM="${TERM:-xterm-256color}"
export MOZ_FAKE_NO_SANDBOX=1
PROF
    chmod 644 "$PROFILE_DIR/termux-profile.sh" 2>/dev/null || true
}

# ─── inject_env: guest-wide environment (host-shell images only) ─
inject_env() {
    # $1 = ROOTFS
    # Skip for regular images — Kali/Parrot keep their own /etc.
    local ROOTFS="$1"
    is_termux_image "$ROOTFS" || return 0
    local ETC_DIR="$ROOTFS/etc"

    mkdir -p "$ETC_DIR"
    cat > "$ETC_DIR/environment" << 'ENVEOF'
PATH="/data/data/com.termux/files/usr/bin:/data/data/com.termux/files/usr/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
HOME="/root"
LANG="en_US.UTF-8"
LC_ALL="en_US.UTF-8"
ENVEOF

    mkdir -p "$ETC_DIR/profile.d"
    cat > "$ETC_DIR/profile.d/env.sh" << 'ENVEOF'
#!/bin/sh
# NetHunter: host-forwarded environment
export USER="root"
export SHELL="/bin/bash"
export TERM="${TERM:-xterm-256color}"
export MOZ_FAKE_NO_SANDBOX=1
ENVEOF
    chmod 644 "$ETC_DIR/profile.d/env.sh" 2>/dev/null || true
}

# ─── boot_classic: kali / parrot ────────────────────────
boot_classic() {
    local distro="$1"; shift || true
    local ROOTFS="$FILES_DIR/nh/distro/$distro"

    if [ ! -d "$ROOTFS" ]; then
        err "Rootfs not found: $ROOTFS (hint: pull $distro first)"
        return 1
    fi

    local GUEST_SH
    GUEST_SH=$(find_sh "$ROOTFS") || {
        err "Guest shell not found in $ROOTFS (tried: bin/sh, usr/bin/sh)"
        return 1
    }
    log "distro=$distro rootfs=$ROOTFS shell=$GUEST_SH"
    nh_session_start "$distro"
    trap 'nh_session_stop "$distro"' EXIT

    # Prepare sysdata/shm before binds
    setup_sysdata_shm "$distro"

    local BINDS
    BINDS=$(build_binds "$distro")

    # Bootstrap (first run only)
    if [ -x "$ROOTFS/root/bootstrap.sh" ] && \
       { [ -f "$ROOTFS/root/.bootstrap_required" ] || [ ! -f "$ROOTFS/root/.setup_done" ]; }; then
        echo "[boot] First run detected — running bootstrap..." >&2
        if "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w /root $BINDS \
            "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; exec /bin/bash /root/bootstrap.sh'; then
            rm -f "$ROOTFS/root/.bootstrap_required"
        else
            echo "[boot] WARNING: bootstrap failed — keeping .bootstrap_required" >&2
        fi
    fi

    # su_daemon re-entry mode: boot <distro> -- <cmd> [args...]
    if [ "${1:-}" = "--" ]; then
        shift
        local NH_CWD="${NH_CWD:-/root}"
        local GUEST_PATH
        GUEST_PATH=$(build_path "$ROOTFS") || true
        export PATH="$GUEST_PATH"
        log "re-entry: cwd=$NH_CWD path=$GUEST_PATH args=$*"
        if [ $# -eq 0 ]; then
            # Bare `su` -> interactive root login shell
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH='"$GUEST_PATH"'; if command -v zsh >/dev/null 2>&1; then exec zsh --login; elif command -v bash >/dev/null 2>&1; then exec bash --login; else exec /bin/sh -l; fi'
        else
            # Map /bin/sh or /system/bin/sh to guest shell
            if [ "$1" = "/bin/sh" ] || [ "$1" = "/system/bin/sh" ]; then
                shift
                set -- "$GUEST_SH" "$@"
            fi
            # Route through guest shell to strip host LD_PRELOAD/PROOT_LOADER,
            # then exec the exact args verbatim (no shell re-quoting loss)
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH='"$GUEST_PATH"'; exec "$@"' -- "$@"
        fi
    fi

    # Normal boot: entrypoint or login shell
    if [ -f "$ROOTFS/root/entrypoint.sh" ]; then
        exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w /root $BINDS \
            "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; exec /bin/sh /root/entrypoint.sh "$@"' -- "$@"
    else
        exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w /root $BINDS \
            "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; cd /root && exec /bin/bash --login "$@"' -- "$@"
    fi
}

# ─── boot_docker: container-style images ────────────────
boot_docker() {
    local image_name="${1:-}"
    [ -z "$image_name" ] && { err "Usage: boot docker <image-name> [-- cmd args...]"; return 1; }
    shift || true

    local ROOTFS="$FILES_DIR/nh/distro/docker/$image_name"
    if [ ! -d "$ROOTFS" ]; then
        err "Docker rootfs not found: $ROOTFS (hint: pull image first)"
        return 1
    fi

    # Detect host-shell style image by rootfs structure (NOT host path)
    local IS_TERMUX_IMAGE=0
    if is_termux_image "$ROOTFS"; then
        IS_TERMUX_IMAGE=1
    fi

    # Inject environment variables
    inject_env "$ROOTFS"

    # Find guest shell — prefer known paths, fallback to find
    local GUEST_SH=""
    if [ "$IS_TERMUX_IMAGE" = "1" ]; then
        for _cand in "$ROOTFS/data/data/com.termux/files/usr/bin/bash" \
                     "$ROOTFS/data/data/com.termux/files/usr/bin/sh" \
                     "$ROOTFS/system/bin/sh"; do
            [ -x "$_cand" ] && GUEST_SH="${_cand#"$ROOTFS"}" && break
        done
    else
        GUEST_SH=$(find_sh "$ROOTFS") || true
    fi

    # Fallback: search with find (Alpine busybox, custom layouts)
    if [ -z "$GUEST_SH" ]; then
        log "Known shell paths failed, falling back to find"
        local found
        found=$(find "$ROOTFS" -maxdepth 6 -type f \( -name 'sh' -o -name 'bash' \) -perm -u+x 2>/dev/null | head -1)
        [ -n "$found" ] && GUEST_SH="${found#"$ROOTFS"}"
    fi

    if [ -z "$GUEST_SH" ]; then
        err "No shell found in $ROOTFS"
        return 1
    fi

    # Track this session
    nh_session_start "$image_name"
    trap 'nh_session_stop "$image_name"' EXIT

    if [ -z "$GUEST_SH" ]; then
        err "Rootfs structure:"
        find "$ROOTFS" -maxdepth 2 -type d 2>/dev/null | head -20 >&2
        return 1
    fi
    log "Docker image=$image_name shell=$GUEST_SH hostshell=$IS_TERMUX_IMAGE"

    # Prepare sysdata/shm before binds
    setup_sysdata_shm "docker/$image_name"

    local BINDS
    BINDS=$(build_binds "docker/$image_name")

    # Find entrypoint
    local ENTRYPOINT=""
    for _cand in /entrypoint.sh /entrypoint_root.sh /docker-entrypoint.sh \
                 /start.sh /init.sh /run.sh; do
        [ -x "$ROOTFS$_cand" ] && ENTRYPOINT="$_cand" && break
    done
    log "Entrypoint: ${ENTRYPOINT:-(none, will use login shell)}"

    # Build guest PATH
    local GUEST_PATH
    GUEST_PATH=$(build_path "$ROOTFS")
    # Only add the host-shell prefix for actual host-shell images.
    [ "$IS_TERMUX_IMAGE" = "1" ] && [ -d "$ROOTFS/data/data/com.termux/files/usr/bin" ] && \
        GUEST_PATH="$GUEST_PATH:/data/data/com.termux/files/usr/bin"
    [ -z "$GUEST_PATH" ] && GUEST_PATH="/usr/bin:/bin"

    # Working directory
    local PROOT_CWD="/root"
    [ ! -d "$ROOTFS/root" ] && PROOT_CWD="/"

    # su_daemon re-entry mode
    if [ "${1:-}" = "--" ]; then
        shift
        local NH_CWD="${NH_CWD:-$PROOT_CWD}"
        export PATH="$GUEST_PATH"
        log "docker re-entry: cwd=$NH_CWD path=$GUEST_PATH args=$*"
        if [ $# -eq 0 ]; then
            # Bare `su` -> interactive root login shell
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH='"$GUEST_PATH"'; if command -v zsh >/dev/null 2>&1; then exec zsh --login; elif command -v bash >/dev/null 2>&1; then exec bash --login; else exec /bin/sh -l; fi'
        else
            # Map /bin/sh or /system/bin/sh to guest shell
            if [ "$1" = "/bin/sh" ] || [ "$1" = "/system/bin/sh" ]; then
                shift
                set -- "$GUEST_SH" "$@"
            fi
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH='"$GUEST_PATH"'; exec "$@"' -- "$@"
        fi
    fi

    # Normal docker boot
    if [ "$IS_TERMUX_IMAGE" = "1" ]; then
        # Host-shell image: inject profile + use login binary
        inject_profile "$ROOTFS"
        if [ -n "$ENTRYPOINT" ]; then
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH=$GUEST_PATH; cd $PROOT_CWD 2>/dev/null || cd /; exec $ENTRYPOINT \"\$@\"" -- "$@"
        else
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH=$GUEST_PATH; cd $PROOT_CWD 2>/dev/null || cd /; exec /data/data/com.termux/files/usr/bin/login \"\$@\"" -- "$@"
        fi
    else
        # Normal image: entrypoint or login shell
        if [ -n "$ENTRYPOINT" ]; then
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH=$GUEST_PATH; cd $PROOT_CWD 2>/dev/null || cd /; exec $ENTRYPOINT \"\$@\"" -- "$@"
        else
            exec "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "unset LD_PRELOAD PROOT_LOADER LD_LIBRARY_PATH; export PATH=$GUEST_PATH; cd $PROOT_CWD 2>/dev/null || cd /; exec $GUEST_SH --login \"\$@\"" -- "$@"
        fi
    fi
}

# ─── Re-entry dispatch: boot -- cmd args... (su_daemon) ──
# Distro resolution order: NH_DISTRO env > .active_distro marker > auto-scan.
boot_reentry() {
    local spec="${NH_DISTRO:-}"
    if [ -z "$spec" ] && [ -f "$FILES_DIR/nh/.active_distro" ]; then
        spec=$(head -n1 "$FILES_DIR/nh/.active_distro" 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -z "$spec" ]; then
        # Auto-scan fallback: prefer kali, then parrot, then first docker image
        if [ -d "$FILES_DIR/nh/distro/kali" ]; then
            spec="kali"
        elif [ -d "$FILES_DIR/nh/distro/parrot" ]; then
            spec="parrot"
        else
            local _d
            for _d in "$FILES_DIR"/nh/distro/docker/*/; do
                [ -d "$_d" ] && spec="docker:$(basename "$_d")" && break
            done
        fi
    fi
    if [ -z "$spec" ]; then
        err "Re-entry mode: no distro found (set NH_DISTRO or create nh/.active_distro)"
        return 1
    fi
    log "re-entry spec=$spec"
    case "$spec" in
        docker:*)
            boot_docker "${spec#docker:}" "$@"
            ;;
        kali|parrot)
            boot_classic "$spec" "$@"
            ;;
        *)
            err "Re-entry mode: unknown distro spec '$spec'"
            return 1
            ;;
    esac
}

# ─── Main dispatch ──────────────────────────────────────
main() {
    # Pre-parse --bind options from anywhere in args
    local _newargs=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bind)
                shift
                [ $# -gt 0 ] || { err "--bind requires a src:dest argument"; return 1; }
                NH_EXTRA_BINDS="${NH_EXTRA_BINDS:+$NH_EXTRA_BINDS }-b $1"
                shift
                continue
                ;;
            --bind=*)
                NH_EXTRA_BINDS="${NH_EXTRA_BINDS:+$NH_EXTRA_BINDS }-b ${1#--bind=}"
                shift
                continue
                ;;
        esac
        _newargs="$_newargs '$(printf '%s' "$1" | sed "s/'/'\\\\''/g")'"
        shift
    done
    [ -n "${NH_EXTRA_BINDS:-}" ] && export NH_EXTRA_BINDS
    eval "set -- $_newargs"

    # Guest environment (HOME/USER/TERM/...).
    export_guest_env

    case "${1:-}" in
        kali|parrot)
            boot_classic "$@"
            ;;
        docker)
            shift
            boot_docker "$@"
            ;;
        --)
            boot_reentry "$@"
            ;;
        --help|-h)
            echo "Usage: boot {kali|parrot} [--bind src:dest] [-- cmd args...]"
            echo "       boot docker <image-name> [--bind src:dest] [-- cmd args...]"
            echo "       boot -- cmd args...   (su_daemon re-entry, auto-detect distro)"
            echo "       boot [--bind src:dest]  (auto-detect active distro)"
            echo ""
            echo "Options:"
            echo "  --bind src:dest    Extra bind mount (repeatable)"
            echo "  --bind=src:dest    Same, equals-sign form"
            echo ""
            echo "Env vars: PREFIX, FILES_DIR, NH_MOUNT_STORAGE, NH_EXTRA_MOUNTS,"
            echo "          NH_EXTRA_BINDS, NH_CWD, NH_DISTRO, BOOT_DEBUG"
            ;;
        "")
            # No distro specified — auto-detect and boot interactively
            local _spec=""
            if [ -f "$FILES_DIR/nh/.active_distro" ]; then
                _spec=$(head -n1 "$FILES_DIR/nh/.active_distro" 2>/dev/null | tr -d '[:space:]')
            fi
            if [ -z "$_spec" ]; then
                if [ -d "$FILES_DIR/nh/distro/kali" ]; then _spec="kali"
                elif [ -d "$FILES_DIR/nh/distro/parrot" ]; then _spec="parrot"
                else
                    local _d
                    for _d in "$FILES_DIR"/nh/distro/docker/*/; do
                        [ -d "$_d" ] && _spec="docker:$(basename "$_d")" && break
                    done
                fi
            fi
            if [ -z "$_spec" ]; then
                err "No distro found (set NH_DISTRO or create nh/.active_distro)"
                return 1
            fi
            log "auto-detect distro=$_spec"
            case "$_spec" in
                docker:*) boot_docker "${_spec#docker:}" ;;
                *)        boot_classic "$_spec" ;;
            esac
            ;;
        *)
            err "Unknown command: $1"
            echo "Usage: boot {kali|parrot|docker} [--bind src:dest] ..." >&2
            return 1
            ;;
    esac
}

main "$@"
