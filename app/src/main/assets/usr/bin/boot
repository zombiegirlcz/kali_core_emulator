# ─── Guest shell discovery helper ────────────────────────
find_sh() {
    # $1 = ROOTFS path; prints relative shell path or empty
    local _rootfs="$1"
    for _cand in "$_rootfs/bin/sh" "$_rootfs/usr/bin/sh"; do
        if [ -x "$_cand" ]; then echo "${_cand#"$_rootfs"}"; return 0; fi
    done
    return 1
}

# ─── Build guest PATH from rootfs structure ──────────────
build_path() {
    # $1 = ROOTFS path; prints colon-joined guest PATH of existing dirs
    local _rootfs="$1" _p _gp=""
    for _p in /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -d "$_rootfs$_p" ] && _gp="${_gp:+$_gp:}$_p"
    done
    echo "$_gp"
}

# ─── Assemble bind mounts ───────────────────────────────
build_binds() {
    # $1 = distro name for sysdata/shm
    local distro="${1:-kali}"
    local _binds="-b /dev -b /proc -b /sys"
    local SYSROOT="$FILES_DIR/nh"

    # MINIMAL (M): jen /dev /proc /sys (+ explicitní extra bindy níže).
    if [ "$NH_MINIMAL" = "0" ]; then
        _binds="$_binds -b /dev/urandom:/dev/random"
        # Fake /proc + /sys overlay (D i I, lze vypnout NH_FAKE_SYS=0).
        if [ "$NH_FAKE_EFFECTIVE" = "1" ]; then
            _binds="$_binds -b $SYSROOT/sysdata/$distro/sys_empty:/sys/fs/selinux"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/loadavg:/proc/loadavg"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/stat:/proc/stat"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/uptime:/proc/uptime"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/version:/proc/version"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/vmstat:/proc/vmstat"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/kernel/cap_last_cap:/proc/sys/kernel/cap_last_cap"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/fs/inotify/max_user_watches:/proc/sys/fs/inotify/max_user_watches"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/kernel/overflowuid:/proc/sys/kernel/overflowuid"
            _binds="$_binds -b $SYSROOT/sysdata/$distro/sysctl/kernel/overflowgid:/proc/sys/kernel/overflowgid"
        fi
        _binds="$_binds -b $SYSROOT/shm/$distro:/dev/shm"
        # Jen na zařízeních, kde tyhle uzly chybí.
        [ -e /dev/fd ] || _binds="$_binds -b /proc/self/fd:/dev/fd"
        [ -e /dev/stdin ] || _binds="$_binds -b /proc/self/fd/0:/dev/stdin"
        [ -e /dev/stdout ] || _binds="$_binds -b /proc/self/fd/1:/dev/stdout"
        [ -e /dev/stderr ] || _binds="$_binds -b /proc/self/fd/2:/dev/stderr"
    fi

    # DEFAULT (D): host cesty. ISOLATED (I) je nemá.
    if [ "$NH_MINIMAL" = "0" ] && [ "$NH_ISOLATED" = "0" ]; then
        [ -d /data/app ] && _binds="$_binds -b /data/app"
        [ -d /data/dalvik-cache ] && _binds="$_binds -b /data/dalvik-cache"
        [ -d /data/misc/apexdata/com.android.art/dalvik-cache ] && \
            _binds="$_binds -b /data/misc/apexdata/com.android.art/dalvik-cache"
        # Storage: jeden zdroj /storage/self/primary do všech cílů, žádný bind
        # celého /storage (tak to dělá proot-distro).
        if [ "$NH_MOUNT_STORAGE" = "1" ] && [ -d /storage/self/primary ]; then
            for _t in /mnt/sdcard /sdcard /storage/emulated/0 /storage/self/primary; do
                _binds="$_binds -b /storage/self/primary:$_t"
            done
        fi
        for _p in /apex /odm /product /system /system_ext /vendor; do
            [ -d "$_p" ] && [ -x "$_p" ] && _binds="$_binds -b $_p"
        done
        [ -f /linkerconfig/ld.config.txt ] && _binds="$_binds -b /linkerconfig/ld.config.txt"
        [ -f /linkerconfig/com.android.art/ld.config.txt ] && _binds="$_binds -b /linkerconfig/com.android.art/ld.config.txt"

        # App-managed dirs (nejsou v referenci, potřebují je nh nástroje).
        _binds="$_binds -b $FILES_DIR/ipc:/run/host_ipc"
        mkdir -p "$FILES_DIR/share" 2>/dev/null || true
        _binds="$_binds -b $FILES_DIR/share:/root/share"
    fi

    # --shared-tmp (jako proot-distro): hostitelský $FILES_DIR/tmp jako guest /tmp,
    # sdílený mezi sessions a appkou. Platí ve všech módech.
    if [ "$NH_SHARED_TMP" = "1" ]; then
        mkdir -p "$FILES_DIR/tmp" 2>/dev/null || true
        _binds="$_binds -b $FILES_DIR/tmp:/tmp"
    fi

    # Attach session: řídicí adresář jako /run/host_ipc/sessions/<sid>. V D je
    # vidět přes bind celého ipc výše; v I/M se bindne jen tenhle podadresář
    # („fake host_ipc“ — su_daemon/magisk sockety z ipc izolovaný guest nevidí).
    if [ -n "${NH_ATTACH_SID:-}" ] && { [ "$NH_MINIMAL" != "0" ] || [ "$NH_ISOLATED" != "0" ]; }; then
        _binds="$_binds -b $SESS_IPC/$NH_ATTACH_SID:/run/host_ipc/sessions/$NH_ATTACH_SID"
    fi

    # Extra binds from preferences / CLI
    [ -n "${NH_EXTRA_MOUNTS:-}" ] && _binds="$_binds $NH_EXTRA_MOUNTS"
    [ -n "${NH_EXTRA_BINDS:-}" ] && _binds="$_binds $NH_EXTRA_BINDS"

    dedupe_binds "$_binds"
}

# Odstraní opakované `-b src:dest` (stejný zdroj i cíl, `-b /x` == `-b /x:/x`),
# např. extra bind /system z Root Bridge v módu D, kde ho boot už přidal.
# Různé zdroje do stejného cíle nechává — pozdější bind je uživatelský override.
dedupe_binds() {
    local _out="" _seen=" " _next=0 _t _k
    for _t in $1; do
        if [ "$_next" = "1" ]; then
            _next=0
            case "$_t" in *:*) _k="$_t" ;; *) _k="$_t:$_t" ;; esac
            case "$_seen" in *" $_k "*) log "duplicitní bind vynechán: $_t"; continue ;; esac
            _seen="$_seen$_k "
            _out="$_out -b $_t"
        elif [ "$_t" = "-b" ]; then
            _next=1
        else
            _out="$_out $_t"
        fi
    done
    echo "${_out# }"
}

# ─── Host-shell image detection ─────────────────────────
is_termux_image() {
    # $1 = ROOTFS
    [ -f "$1/data/data/com.termux/files/usr/bin/login" ]
}

# ─── Profile injection for host-shell images only ─
inject_profile() {
    # $1 = ROOTFS
    # Skip for regular images (Kali/Parrot manage their own /etc).
    local ROOTFS="$1"
    is_termux_image "$ROOTFS" || return 0
    local PROFILE_DIR="$ROOTFS/etc/profile.d"
    mkdir -p "$PROFILE_DIR"
    cat > "$PROFILE_DIR/termux-profile.sh" << 'PROF'
#!/bin/sh
# NetHunter: obnovení PATH a env proměnných při každém login shellu
export PATH="/data/data/com.termux/files/usr/bin:/data/data/com.termux/files/usr/sbin:$PATH"
export HOME="${HOME:-/root}"
export PREFIX="/data/data/com.termux/files/usr"
export LD_LIBRARY_PATH="/system/lib64:/system/lib:$PREFIX/lib:$LD_LIBRARY_PATH"
export USER="${USER:-root}"
export SHELL="${SHELL:-/bin/bash}"
export TERM="${TERM:-xterm-256color}"
export MOZ_FAKE_NO_SANDBOX=1
PROF
    chmod 644 "$PROFILE_DIR/termux-profile.sh" 2>/dev/null || true
}

# ─── inject_env: guest-wide environment (host-shell images only) ─
inject_env() {
    # $1 = ROOTFS
    # Skip for regular images — Kali/Parrot keep their own /etc.
    local ROOTFS="$1"
    is_termux_image "$ROOTFS" || return 0
    local ETC_DIR="$ROOTFS/etc"

    mkdir -p "$ETC_DIR"
    cat > "$ETC_DIR/environment" << 'ENVEOF'
PATH="/data/data/com.termux/files/usr/bin:/data/data/com.termux/files/usr/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
HOME="/root"
LANG="en_US.UTF-8"
LC_ALL="en_US.UTF-8"
ENVEOF

    mkdir -p "$ETC_DIR/profile.d"
    cat > "$ETC_DIR/profile.d/env.sh" << 'ENVEOF'
#!/bin/sh
# NetHunter: host-forwarded environment
export USER="root"
export SHELL="/bin/bash"
export TERM="${TERM:-xterm-256color}"
export MOZ_FAKE_NO_SANDBOX=1
ENVEOF
    chmod 644 "$ETC_DIR/profile.d/env.sh" 2>/dev/null || true
}

# ─── boot_classic: kali / parrot ────────────────────────
boot_classic() {
    local distro="$1"; shift || true
    local ROOTFS="$FILES_DIR/nh/distro/$distro"

    if [ ! -d "$ROOTFS" ]; then
        err "Rootfs not found: $ROOTFS (hint: pull $distro first)"
        return 1
    fi

    local GUEST_SH
    GUEST_SH=$(find_sh "$ROOTFS") || {
        err "Guest shell not found in $ROOTFS (tried: bin/sh, usr/bin/sh)"
        return 1
    }
    log "distro=$distro rootfs=$ROOTFS shell=$GUEST_SH"
    nh_session_start "$distro"
    trap 'nh_session_stop "$distro"' EXIT
    if [ -n "${NH_ATTACH_CHILD:-}" ]; then session_prepare "$distro" || return 1; fi

    # Prepare sysdata/shm before binds
    setup_sysdata_shm "$distro"

    local BINDS
    BINDS=$(build_binds "$distro")

    # Bootstrap (first run only)
    if [ -x "$ROOTFS/root/bootstrap.sh" ] && \
       { [ -f "$ROOTFS/root/.bootstrap_required" ] || [ ! -f "$ROOTFS/root/.setup_done" ]; }; then
        echo "[boot] First run detected — running bootstrap..." >&2
        if env -i $(guest_env) "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w /root $BINDS \
            "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; exec /bin/bash /root/bootstrap.sh'; then
            rm -f "$ROOTFS/root/.bootstrap_required"
        else
            echo "[boot] WARNING: bootstrap failed — keeping .bootstrap_required" >&2
        fi
    fi

    # boot <distro> --attach: command server místo shellu
    if [ -n "${NH_ATTACH_SID:-}" ]; then
        session_server_exec "$ROOTFS" "$GUEST_SH" "$(build_path "$ROOTFS")" /root "$BINDS" "" ""
    fi

    # su_daemon re-entry mode: boot <distro> -- <cmd> [args...]
    if [ "${1:-}" = "--" ]; then
        shift
        local NH_CWD="${NH_CWD:-/root}"
        local GUEST_PATH
        GUEST_PATH=$(build_path "$ROOTFS") || true
        export PATH="$GUEST_PATH"
        log "re-entry: cwd=$NH_CWD path=$GUEST_PATH args=$*"
        if [ $# -eq 0 ]; then
            # Bare `su` -> interactive root login shell
            exec env -i $(guest_env) "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; export PATH="$1"; if command -v zsh >/dev/null 2>&1; then exec zsh --login; elif command -v bash >/dev/null 2>&1; then exec bash --login; else exec /bin/sh -l; fi' "$GUEST_SH" "$GUEST_PATH"
        else
            # Map /bin/sh or /system/bin/sh to guest shell
            if [ "$1" = "/bin/sh" ] || [ "$1" = "/system/bin/sh" ]; then
                shift
                set -- "$GUEST_SH" "$@"
            fi
            # Route through guest shell to strip host LD_PRELOAD/PROOT_LOADER,
            # then exec the exact args verbatim (no shell re-quoting loss)
            exec env -i $(guest_env) "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c "$REENTRY_WRAP" "$GUEST_SH" "$GUEST_PATH" "$@"
        fi
    fi

    # Normal boot: entrypoint or login shell
    if [ -f "$ROOTFS/root/entrypoint.sh" ]; then
        exec env -i $(guest_env) "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w /root $BINDS \
            "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; exec /bin/sh /root/entrypoint.sh "$@"' -- "$@"
    else
        exec env -i $(guest_env) "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w /root $BINDS \
            "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; cd /root && exec /bin/bash --login "$@"' -- "$@"
    fi
}

# ─── boot_docker: container-style images ────────────────
# ─── Rootfs manifest (/.nh/manifest) ────────────────────
# Distro plug-in (repo ROOTFS-for-proot) popisuje, jak image spustit. Formát
# KEY=VALUE po řádcích, nic se nespouští (čte se jen `read`). Viz AGENTS.md
# v ROOTFS-for-proot. Klíče:
#   NH_SHELL=/bin/sh           login shell (cesta v guestu)
#   NH_ENTRYPOINT=/root/x.sh   spustitelný skript místo login shellu (volitelné)
#   NH_BOOTSTRAP=/bootstrap.sh jednorázový první start, značka /.nh/bootstrap.done
#   NH_PATH=...                PATH v guestu
#   NH_WORKDIR=/root           pracovní adresář
#   NH_ENV=KEY=VAL             proměnná navíc (opakovatelné, bez mezer)
#   NH_BIND=/src[:/dest]       bind navíc (opakovatelné, absolutní host cesta;
#                              jen uvnitř rootfs nebo z allowlistu manifest_bind_ok)
#   NH_PKG / NH_LIBC / NH_INTEGRATION čte appka (ProotManager), boot je ignoruje.
# Manifest pochází ze staženého rootfs (katalog), takže mu nevěříme: NH_BIND
# smí mířit jen do vlastního rootfs nebo na systémové cesty, které guest
# beztak vidí (build_binds). Appková data, /data, / atd. se odmítnou.
manifest_bind_ok() {
    # $1 = ROOTFS, $2 = hodnota NH_BIND
    local _src="${2%%:*}" _dst=""
    case "$2" in *:*) _dst="${2#*:}" ;; esac
    case "$_src$_dst" in *..*|*"	"*) return 1 ;; esac
    [ -n "$_dst" ] && case "$_dst" in /*) ;; *) return 1 ;; esac
    case "$_src" in
        "$1"/*)
            # symlink uvnitř rootfs by se na hostu vyhodnotil ven z rootfs
            local _real _root
            _real=$(readlink -f "$_src" 2>/dev/null) || return 1
            _root=$(readlink -f "$1" 2>/dev/null) || return 1
            case "$_real" in "$_root"/*) return 0 ;; esac
            return 1 ;;
        /dev|/dev/*|/proc|/proc/*|/sys|/sys/*) return 0 ;;
        /system|/system/*|/vendor|/vendor/*|/product|/product/*) return 0 ;;
        /apex|/apex/*|/linkerconfig/*) return 0 ;;
        "$FILES_DIR/share"|"$FILES_DIR/share/"*) return 0 ;;
    esac
    return 1
}

# NH_PATH jde do guest PATH; povolit jen běžné znaky cest.
manifest_path_ok() {
    case "$1" in ''|*[!A-Za-z0-9_./:+-]*) return 1 ;; esac
    return 0
}

MF_PRESENT=0 MF_SHELL="" MF_ENTRY="" MF_BOOTSTRAP="" MF_PATH="" MF_WORKDIR="" MF_ENV="" MF_BINDS=""
read_manifest() {
    # $1 = ROOTFS
    local _f="$1/.nh/manifest" _line _k _v
    [ -f "$_f" ] || return 0
    MF_PRESENT=1
    while IFS= read -r _line || [ -n "$_line" ]; do
        case "$_line" in ''|'#'*) continue ;; *=*) ;; *) continue ;; esac
        _k="${_line%%=*}"
        _v="${_line#*=}"
        _v="${_v#\"}"; _v="${_v%\"}"
        case "$_k" in
            NH_SHELL) MF_SHELL="$_v" ;;
            NH_ENTRYPOINT) MF_ENTRY="$_v" ;;
            NH_BOOTSTRAP) MF_BOOTSTRAP="$_v" ;;
            NH_PATH)
                if manifest_path_ok "$_v"; then MF_PATH="$_v"
                else err "manifest: NH_PATH s neplatnými znaky ignorováno: $_v"; fi ;;
            NH_WORKDIR) MF_WORKDIR="$_v" ;;
            NH_ENV)
                case "$_v" in
                    *" "*|*"	"*) err "manifest: NH_ENV s mezerou ignorováno: $_v" ;;
                    [A-Za-z_]*=*) MF_ENV="$MF_ENV $_v" ;;
                    *) err "manifest: neplatné NH_ENV: $_v" ;;
                esac ;;
            NH_BIND)
                case "$_v" in
                    *" "*) err "manifest: NH_BIND s mezerou ignorováno: $_v" ;;
                    /*)
                        if manifest_bind_ok "$1" "$_v"; then
                            MF_BINDS="$MF_BINDS -b $_v"
                        else
                            err "manifest: NH_BIND mimo rootfs/allowlist přeskočeno: $_v"
                        fi ;;
                    *) err "manifest: NH_BIND musí být absolutní cesta: $_v" ;;
                esac ;;
        esac
    done < "$_f"
    log "manifest: shell=$MF_SHELL entry=$MF_ENTRY bootstrap=$MF_BOOTSTRAP binds=$MF_BINDS"
}

# Vyhodnotí guest cestu uvnitř rootfs včetně symlinků (i absolutních, které by
# se na hostu vyhodnotily proti Androidu, např. Alpine /bin/sh -> /bin/busybox).
# Vypíše výslednou guest cestu, nebo vrátí 1, když neexistuje.
rootfs_resolve() {
    # $1 = ROOTFS, $2 = absolutní guest cesta
    local _r="$1" _rest="${2#/}" _cur="" _c _t _n=0
    while [ -n "$_rest" ]; do
        _c="${_rest%%/*}"
        case "$_rest" in */*) _rest="${_rest#*/}" ;; *) _rest="" ;; esac
        case "$_c" in
            ''|.) continue ;;
            ..) _cur="${_cur%/*}"; continue ;;
        esac
        if [ -L "$_r$_cur/$_c" ]; then
            _n=$((_n + 1))
            [ "$_n" -gt 40 ] && return 1
            _t=$(readlink "$_r$_cur/$_c") || return 1
            case "$_t" in /*) _cur=""; _t="${_t#/}" ;; esac
            _rest="$_t${_rest:+/$_rest}"
        else
            _cur="$_cur/$_c"
        fi
    done
    [ -e "$_r$_cur" ] || return 1
    echo "${_cur:-/}"
}

# Je guest cesta spustitelný soubor (po vyhodnocení symlinků v rootfs)?
rootfs_is_exec() {
    local _res
    _res=$(rootfs_resolve "$1" "$2") || return 1
    [ -f "$1$_res" ] && [ -x "$1$_res" ]
}

boot_docker() {
    local image_name="${1:-}"
    [ -z "$image_name" ] && { err "Usage: boot docker <image-name> [-- cmd args...]"; return 1; }
    shift || true

    local ROOTFS="$FILES_DIR/nh/distro/docker/$image_name"
    if [ ! -d "$ROOTFS" ]; then
        err "Docker rootfs not found: $ROOTFS (hint: pull image first)"
        return 1
    fi

    # Detect host-shell style image by rootfs structure (NOT host path)
    local IS_TERMUX_IMAGE=0
    if is_termux_image "$ROOTFS"; then
        IS_TERMUX_IMAGE=1
    fi

    # Inject environment variables
    inject_env "$ROOTFS"
    read_manifest "$ROOTFS"

    # Find guest shell — manifest, then known paths, fallback to find
    local GUEST_SH=""
    if [ -n "$MF_SHELL" ]; then
        if rootfs_is_exec "$ROOTFS" "$MF_SHELL"; then
            GUEST_SH="$MF_SHELL"
        else
            err "manifest NH_SHELL=$MF_SHELL v rootfs neexistuje nebo není spustitelný"
        fi
    fi
    if [ -n "$GUEST_SH" ]; then
        :
    elif [ "$IS_TERMUX_IMAGE" = "1" ]; then
        for _cand in "$ROOTFS/data/data/com.termux/files/usr/bin/bash" \
                     "$ROOTFS/data/data/com.termux/files/usr/bin/sh" \
                     "$ROOTFS/system/bin/sh"; do
            [ -x "$_cand" ] && GUEST_SH="${_cand#"$ROOTFS"}" && break
        done
    else
        # Symlinky vyhodnocujeme uvnitř rootfs, exec jde přes původní cestu
        # (proot ji v guestu vyhodnotí sám), aby busybox dostal argv0 "sh".
        for _cand in /bin/sh /usr/bin/sh /bin/bash /usr/bin/bash /bin/ash; do
            rootfs_is_exec "$ROOTFS" "$_cand" && GUEST_SH="$_cand" && break
        done
    fi

    # Fallback: search with find (custom layouts)
    if [ -z "$GUEST_SH" ]; then
        log "Known shell paths failed, falling back to find"
        local found
        found=$(find "$ROOTFS" -maxdepth 6 \( -type f -o -type l \) \( -name 'sh' -o -name 'bash' -o -name 'ash' \) 2>/dev/null | head -1)
        [ -n "$found" ] && GUEST_SH="${found#"$ROOTFS"}"
    fi

    if [ -z "$GUEST_SH" ]; then
        err "No shell found in $ROOTFS"
        return 1
    fi

    # Track this session
    nh_session_start "$image_name"
    trap 'nh_session_stop "$image_name"' EXIT

    if [ -z "$GUEST_SH" ]; then
        err "Rootfs structure:"
        find "$ROOTFS" -maxdepth 2 -type d 2>/dev/null | head -20 >&2
        return 1
    fi
    log "Docker image=$image_name shell=$GUEST_SH hostshell=$IS_TERMUX_IMAGE"
    # Docker sessions se do nh/sessions zapisují jen v attach režimu.
    if [ -n "${NH_ATTACH_CHILD:-}" ]; then
        nh_session_start "docker/$image_name"
        trap 'nh_session_stop "docker/$image_name"' EXIT
        session_prepare "docker/$image_name" || return 1
    fi

    # Prepare sysdata/shm before binds
    setup_sysdata_shm "docker/$image_name"

    local BINDS
    BINDS=$(build_binds "docker/$image_name")
    [ -n "$MF_BINDS" ] && BINDS=$(dedupe_binds "$BINDS$MF_BINDS")

    # Find entrypoint (manifest má přednost; bez manifestu staré konvence)
    local ENTRYPOINT="" BOOTSTRAP=""
    if [ "$MF_PRESENT" = "1" ]; then
        if [ -n "$MF_ENTRY" ]; then
            if rootfs_is_exec "$ROOTFS" "$MF_ENTRY"; then
                ENTRYPOINT="$MF_ENTRY"
            else
                err "manifest NH_ENTRYPOINT=$MF_ENTRY chybí nebo není spustitelný, použije se login shell"
            fi
        fi
        if [ -n "$MF_BOOTSTRAP" ] && [ ! -f "$ROOTFS/.nh/bootstrap.done" ]; then
            if rootfs_resolve "$ROOTFS" "$MF_BOOTSTRAP" >/dev/null; then
                BOOTSTRAP="$MF_BOOTSTRAP"
            else
                err "manifest NH_BOOTSTRAP=$MF_BOOTSTRAP v rootfs chybí"
            fi
        fi
    else
        for _cand in /entrypoint.sh /entrypoint_root.sh /docker-entrypoint.sh \
                     /start.sh /init.sh /run.sh; do
            rootfs_is_exec "$ROOTFS" "$_cand" && ENTRYPOINT="$_cand" && break
        done
    fi
    log "Entrypoint: ${ENTRYPOINT:-(none, will use login shell)} bootstrap: ${BOOTSTRAP:-(none)}"

    # Build guest PATH
    local GUEST_PATH
    GUEST_PATH="${MF_PATH:-$(build_path "$ROOTFS")}"
    # Only add the host-shell prefix for actual host-shell images.
    [ "$IS_TERMUX_IMAGE" = "1" ] && [ -d "$ROOTFS/data/data/com.termux/files/usr/bin" ] && \
        GUEST_PATH="$GUEST_PATH:/data/data/com.termux/files/usr/bin"
    [ -z "$GUEST_PATH" ] && GUEST_PATH="/usr/bin:/bin"

    # Working directory
    local PROOT_CWD="${MF_WORKDIR:-/root}"
    rootfs_resolve "$ROOTFS" "$PROOT_CWD" >/dev/null || PROOT_CWD="/"

    # boot docker <image> --attach: command server místo shellu
    if [ -n "${NH_ATTACH_SID:-}" ]; then
        session_server_exec "$ROOTFS" "$GUEST_SH" "$GUEST_PATH" "$PROOT_CWD" "$BINDS" "$BOOTSTRAP" "$MF_ENV"
    fi

    # su_daemon re-entry mode
    if [ "${1:-}" = "--" ]; then
        shift
        local NH_CWD="${NH_CWD:-$PROOT_CWD}"
        export PATH="$GUEST_PATH"
        log "docker re-entry: cwd=$NH_CWD path=$GUEST_PATH args=$*"
        if [ $# -eq 0 ]; then
            # Bare `su` -> interactive root login shell
            exec env -i $(guest_env) $MF_ENV "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c 'unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; export PATH="$1"; if command -v zsh >/dev/null 2>&1; then exec zsh --login; elif command -v bash >/dev/null 2>&1; then exec bash --login; else exec /bin/sh -l; fi' "$GUEST_SH" "$GUEST_PATH"
        else
            # Map /bin/sh or /system/bin/sh to guest shell
            if [ "$1" = "/bin/sh" ] || [ "$1" = "/system/bin/sh" ]; then
                shift
                set -- "$GUEST_SH" "$@"
            fi
            exec env -i $(guest_env) $MF_ENV "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$NH_CWD" $BINDS \
                "$GUEST_SH" -c "$REENTRY_WRAP" "$GUEST_SH" "$GUEST_PATH" "$@"
        fi
    fi

    # Normal docker boot
    if [ "$IS_TERMUX_IMAGE" = "1" ]; then
        # Host-shell image: inject profile + use login binary
        inject_profile "$ROOTFS"
        # Hodnoty z manifestu jdou jako argumenty ($1 = PATH, $2 = cwd,
        # zbytek = příkaz), nic se necituje do -c řetězce (jako _launch níže).
        local _tlaunch='unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; export PATH="$1"; cd "$2" 2>/dev/null || cd /; shift 2; exec "$@"'
        if [ -n "$ENTRYPOINT" ]; then
            exec env -i $(guest_env) $MF_ENV "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "$_tlaunch" "$GUEST_SH" "$GUEST_PATH" "$PROOT_CWD" "$ENTRYPOINT" "$@"
        else
            exec env -i $(guest_env) $MF_ENV "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "$_tlaunch" "$GUEST_SH" "$GUEST_PATH" "$PROOT_CWD" /data/data/com.termux/files/usr/bin/login "$@"
        fi
    else
        # Normal image: (jednorázový bootstrap) + entrypoint nebo login shell.
        # Guest wrapper dostává hodnoty jako argumenty ($0 = shell, $1 = PATH,
        # $2 = cwd, $3 = bootstrap), takže se nic necituje do -c řetězce.
        # Login shell přes -l: busybox/dash `--login` neznají.
        local _launch='unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; export PATH="$1"; cd "$2" 2>/dev/null || cd /; b="$3"; shift 3; if [ -n "$b" ] && [ -f "$b" ] && [ ! -f /.nh/bootstrap.done ]; then echo "[*] První start: $b"; if "$0" "$b"; then mkdir -p /.nh && : > /.nh/bootstrap.done; else echo "[!] $b selhal, zkusí se znovu při dalším startu" >&2; fi; fi; exec "$@"'
        if [ -n "$ENTRYPOINT" ]; then
            exec env -i $(guest_env) $MF_ENV "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "$_launch" "$GUEST_SH" "$GUEST_PATH" "$PROOT_CWD" "$BOOTSTRAP" "$ENTRYPOINT" "$@"
        else
            exec env -i $(guest_env) $MF_ENV "$PROOT" $PROOT_FLAGS -r "$ROOTFS" -w "$PROOT_CWD" $BINDS \
                "$GUEST_SH" -c "$_launch" "$GUEST_SH" "$GUEST_PATH" "$PROOT_CWD" "$BOOTSTRAP" "$GUEST_SH" -l "$@"
        fi
    fi
}

# ─── Re-entry dispatch: boot -- cmd args... (su_daemon) ──
# Distro resolution order: NH_DISTRO env > .active_distro marker > auto-scan.
boot_reentry() {
    local spec="${NH_DISTRO:-}"
    if [ -z "$spec" ] && [ -f "$FILES_DIR/nh/.active_distro" ]; then
        spec=$(head -n1 "$FILES_DIR/nh/.active_distro" 2>/dev/null | tr -d '[:space:]')
    fi
    if [ -z "$spec" ]; then
        # Auto-scan fallback: prefer kali, then parrot, then first docker image
        if [ -d "$FILES_DIR/nh/distro/kali" ]; then
            spec="kali"
        elif [ -d "$FILES_DIR/nh/distro/parrot" ]; then
            spec="parrot"
        else
            local _d
            for _d in "$FILES_DIR"/nh/distro/docker/*/; do
                [ -d "$_d" ] && spec="docker:$(basename "$_d")" && break
            done
        fi
    fi
    if [ -z "$spec" ]; then
        err "Re-entry mode: no distro found (set NH_DISTRO or create nh/.active_distro)"
        return 1
    fi
    log "re-entry spec=$spec"
    case "$spec" in
        docker:*)
            boot_docker "${spec#docker:}" "$@"
            ;;
        kali|parrot)
            boot_classic "$spec" "$@"
            ;;
        *)
            err "Re-entry mode: unknown distro spec '$spec'"
            return 1
            ;;
    esac
}

# ─── CPU pin (NH_CPU_PIN=1: ikona CPU na kartě distra, `nh cpu`) ──
# Každý syscall, který proot zachytí, je ptrace výměna guest ↔ proot. Když
# běží na různých jádrech, čeká se na probuzení druhého jádra (~320 µs na
# syscall); na jednom velkém jádru ~70–100 µs (shell/apt/git 2–5× rychleji).
# Daň: celý guest jede na jednom jádru (make -j, john, xz -T0 → `nh cpu all`).
# Pin se nastaví na vlastní PID před exec, proot i guest ho zdědí. Stav je v
# $FILES_DIR/nh/cpu/pin.<pid> (maska); hlídač ho obnoví, když Android při
# změně cpusetu (appka do pozadí/popředí) affinity přepíše.
CPU_DIR="$FILES_DIR/nh/cpu"
TASKSET_BIN=/system/bin/taskset

# `nh cpu bench` naměřil, že trasovaný syscall (ptrace výměna guest↔proot) je
# na little jádru ~2× rychlejší než na big (frekvence nerozhoduje, rozhoduje
# mezijádrová ptrace latence) a že dvě sessions na DVOU RŮZNÝCH big jádrech
# jsou 100–200× pomalejší než cokoliv jiného (proot a guest se přepínají mezi
# jádry přes ptrace na každý syscall). Proto: vyber jádro s NEJNIŽŠÍ
# cpuinfo_max_freq (little cluster) a VŽDY stejné jedno konkrétní jádro —
# žádný round-robin mezi sessions. Sdílení jednoho jádra více sessions je podle
# benche pořád řádově lepší než rozjetí na dvě různá jádra.
cpu_pick_core() {
    local best= c f core=
    local on
    for c in /sys/devices/system/cpu/cpu[0-9]*; do
        { read -r f < "$c/cpufreq/cpuinfo_max_freq"; } 2>/dev/null || continue
        { read -r on < "$c/online"; } 2>/dev/null || on=1
        [ "$on" = "1" ] || continue
        c=${c##*cpu}
        if [ -z "$best" ] || [ "$f" -lt "$best" ]; then best=$f; core=$c
        elif [ "$f" -eq "$best" ] && [ "$c" -lt "$core" ]; then core=$c; fi
    done
    echo "${core:-0}"
}

# Potomci PID (včetně něj), bez podstromů uvedených v $CPU_DIR/free.<root>.
cpu_tree() {
    local root=$1 all="" p pp line todo out free
    for p in /proc/[0-9]*; do
        { read -r line < "$p/stat"; } 2>/dev/null || continue
        line=${line##*) }
        set -- $line
        all="$all ${p#/proc/}:$2"
    done
    free=" "
    [ -f "$CPU_DIR/free.$root" ] && while read -r p; do free="$free$p "; done < "$CPU_DIR/free.$root"
    todo=$root out=""
    while [ -n "$todo" ]; do
        set -- $todo; p=$1; shift; todo="$*"
        case "$free" in *" $p "*) continue ;; esac
        out="$out $p"
        for pp in $all; do
            [ "${pp#*:}" = "$p" ] && todo="$todo ${pp%%:*}"
        done
    done
    echo $out
}

# /proc/<pid>/{cmdline,environ} → řádky. NIKDY ne `tr … < /proc/…`: když
# proces mezitím zanikne, toybox tr dostává z read() chybu místo EOF a točí
# se v ní navždy (~50 % jádra), hlídač visí na $(…) a přežije svou session.
# `dd count=1` udělá přesně jedno read() a skončí i při chybě; timeout je
# pojistka pro případ, že by visel i dd.
proc_lines() {  # <soubor v /proc>
    [ -r "$1" ] || return 0
    if command -v timeout >/dev/null 2>&1; then
        timeout 2 dd if="$1" bs=131072 count=1 2>/dev/null
    else
        dd if="$1" bs=131072 count=1 2>/dev/null
    fi | tr '\0' '\n'
}

# CPU_ALL v prostředí procesu v guestu = programy, které mají jet na všech
# jádrech (make, cargo, john, xz, …). Slova oddělená mezerou/čárkou/řádkem;
# slovo s cestou (/…, ~/…) je soubor se seznamem, doslovné '$(cat SOUBOR)'
# (hodnota v jednoduchých uvozovkách) se čte stejně. Cesty jsou v guestu.
cpu_all_words() {  # <pid> <rootfs>
    local v w
    v=$(proc_lines "/proc/$1/environ" | sed -n 's/^CPU_ALL=//p' | head -n 1)
    [ -n "$v" ] || return 0
    v=$(echo "$v" | sed 's/\$(cat[[:space:]]*\([^)]*\))/\1/g' | tr ',;' '  ')
    for w in $v; do
        case "$w" in "~/"*) w="/root/${w#??}" ;; esac
        case "$w" in
            /*) [ -f "$2$w" ] && tr ',;' '  ' < "$2$w" ;;
            *)  echo "$w" ;;
        esac
    done
}

# Root daemon (Magisk nh_cpuctl) žije = heartbeat $CPU_DIR/cpuctld < 15 s.
cpu_daemon_fresh() {
    local _p _t _r _now
    [ -f "$CPU_DIR/cpuctld" ] || return 1
    { read -r _p _t _r < "$CPU_DIR/cpuctld"; } 2>/dev/null || return 1
    case "$_t" in ''|*[!0-9]*) return 1 ;; esac
    _now=$(date +%s) || return 1
    [ $(( _now - _t )) -lt 15 ]
}

cpu_pin_watch() {
    # Hlídač dědí `set -e` z boot; v mksh by ho zabil první neúspěšný test
    # na konci smyčky (a hlídač by tiše zmizel). Tady se chyby řeší ručně.
    set +e
    local pid=$1 file="$CPU_DIR/pin.$1" mask cur t n=0 seen=" " rootfs all_mask comm argv w
    all_mask=0
    for t in /sys/devices/system/cpu/cpu[0-9]*; do all_mask=$(( all_mask | (1 << ${t##*cpu}) )); done
    all_mask=$(printf '%x' "$all_mask")
    while kill -0 "$pid" 2>/dev/null && [ -f "$file" ]; do
        # Root daemon pin drží sám (netlink/fallback) → hlídač jen spí. Spouští
        # se ale vždy: když daemon za běhu session spadne, hlídač převezme
        # (dřív se při čerstvém heartbeatu nespustil vůbec a session pak zůstala
        # bez obnovy pinu).
        if cpu_daemon_fresh; then sleep 5; continue; fi
        # rootfs z příkazové řádky proot (-r <cesta>) kvůli souborům v CPU_ALL;
        # hned po startu je $pid ještě boot (exec proot proběhne až potom)
        [ -n "$rootfs" ] || rootfs=$(proc_lines "/proc/$pid/cmdline" | sed -n '/^-r$/{n;p;q}')
        # nové procesy s CPU_ALL, jejichž jméno je na seznamu → všechna jádra
        for t in $(cpu_tree "$pid"); do
            case "$seen" in *" $t "*) continue ;; esac
            seen="$seen$t "
            [ "$t" = "$pid" ] && continue
            w=$(cpu_all_words "$t" "$rootfs")
            [ -n "$w" ] || continue
            { read -r comm < "/proc/$t/comm"; } 2>/dev/null || continue
            argv=$(proc_lines "/proc/$t/cmdline" | head -n 1); argv=${argv##*/}
            case " $(echo $w) " in
                *" $comm "*|*" $argv "*)
                    $TASKSET_BIN -p "$all_mask" "$t" >/dev/null 2>&1 && echo "$t" >> "$CPU_DIR/free.$pid"
                    ;;
            esac
        done
        # každých ~10 s: Android při změně cpusetu přepsal affinity → obnovit
        n=$(( n + 1 ))
        if [ $(( n % 5 )) -eq 0 ]; then
            { read -r mask < "$file"; } 2>/dev/null || mask=""
            cur=$($TASKSET_BIN -p "$pid" 2>/dev/null); cur=${cur##*: }
            if [ -n "$mask" ] && [ "$cur" != "$mask" ]; then
                for t in $(cpu_tree "$pid"); do $TASKSET_BIN -p "$mask" "$t" >/dev/null 2>&1; done
            fi
            seen=" "        # PIDy se recyklují
        fi
        sleep 2
    done
    rm -f "$file" "$CPU_DIR/free.$pid"
}

cpu_pin_isolate_host() {
    # Přesunout host procesy z proot jádra na zbylá jádra.
    # $1 = hex maska proot jádra
    local proot_mask=$1 all_mask avoid p comm
    all_mask=0
    for p in /sys/devices/system/cpu/cpu[0-9]*; do
        all_mask=$(( all_mask | (1 << ${p##*cpu}) ))
    done
    avoid=$(printf '%x' $(( all_mask & ~0x$proot_mask )))
    [ "$avoid" != "0" ] || return 0
    # `read`, ne `$(cat …)`: pod rootem (sudo re-entry) je vidět ~900 procesů
    # a fork+exec catu na každý stál ~16–25 s při KAŽDÉM sudo (2026-10-10).
    for p in /proc/[0-9]*/comm; do
        { read -r comm < "$p"; } 2>/dev/null || continue
        case "$comm" in
            com.linux_core*|linux_core*|nethunter*|dropbear|sshd)
                local pid=${p#/proc/}; pid=${pid%/comm}
                # if, ne `&&`: proces mohl mezitím zaniknout a taskset selže;
                # návratová hodnota by pak se `set -e` ukončila celý boot
                if $TASKSET_BIN -p "$avoid" "$pid" >/dev/null 2>&1; then
                    log "CPU isolate: $comm ($pid) → 0x$avoid"
                fi
                ;;
        esac
    done
    return 0
}

cpu_pin_apply() {
    [ "${NH_CPU_PIN:-0}" = "1" ] && [ -x "$TASKSET_BIN" ] || return 0
    local core mask
    mkdir -p "$CPU_DIR" 2>/dev/null || true
    # úklid po mrtvých sessions (if, ne `&&`: boot běží se `set -e` a mksh
    # skončí i na smyčce, jejíž poslední `[ … ] && …` neprojde)
    for f in "$CPU_DIR"/pin.*; do
        if [ -f "$f" ] && ! kill -0 "${f##*.}" 2>/dev/null; then
            rm -f "$f" "$CPU_DIR/free.${f##*.}"
        fi
    done
    core=${NH_CPU_PIN_CORE:-$(cpu_pick_core)}
    mask=$(printf '%x' $((1 << core)))
    if $TASKSET_BIN -p "$mask" $$ >/dev/null 2>&1; then
        echo "$mask" > "$CPU_DIR/pin.$$"
        log "CPU pin: cpu$core (mask $mask)"
        # isolate: přesunout host procesy (appku, agenta) z proot jádra
        cpu_pin_isolate_host "$mask"
        # Root daemon (cpuctld) pin obnovuje sám; hlídač se přesto spustí
        # jako záloha a dokud daemon žije, jen spí (viz cpu_pin_watch).
        if cpu_daemon_fresh; then
            log "CPU pin: root daemon active, mksh watcher on standby"
        fi
        # Hlídač odpojený od tohoto procesu (po exec je $$ proot, dítě by
        # proot sklízel jako neznámý tracee) → dvojitý fork, rodič je init.
        ( cpu_pin_watch $$ </dev/null >/dev/null 2>&1 & )
    else
        err "CPU pin: taskset selhal, běžím bez pinu"
    fi
    return 0
}

# ─── Main dispatch ──────────────────────────────────────
main() {
    # Volby kdekoli před `--`. Vše od `--` dál je guest příkaz a projde
    # beze změny (jinak by třeba `boot -- ls -i` sebralo -i jako mód).
    local _newargs="" _rest=0 _q _pre="" _post="" _dd=0
    while [ $# -gt 0 ]; do
        if [ "$_rest" = "0" ]; then
            case "$1" in
                --attach) NH_ATTACH=1; shift; continue ;;
                --attach=*)
                    NH_ATTACH=1; NH_ATTACH_NAME="${1#--attach=}"
                    case "$NH_ATTACH_NAME" in
                        ""|*[!A-Za-z0-9_.-]*) err "jméno session smí obsahovat jen A-Z a-z 0-9 _ . -"; return 2 ;;
                    esac
                    shift; continue ;;
                --attach-child=*) NH_ATTACH_CHILD="${1#--attach-child=}"; shift; continue ;;
                -p|--pid)
                    shift
                    [ -n "${1:-}" ] || { err "-p/--pid vyžaduje <pid|sid|jméno>"; return 2; }
                    NH_CLIENT="$1"; shift; continue ;;
                --pid=*) NH_CLIENT="${1#--pid=}"; shift; continue ;;
                --drain=*) NH_DRAIN="${1#--drain=}"; shift; continue ;;
                -q|--quiet) NH_QUIET=1; shift; continue ;;
                --kill) NH_KILL=1; shift; continue ;;
                -b|--bind)
                    shift
                    [ -n "${1:-}" ] || { err "-b/--bind requires a src:dest argument"; return 1; }
                    NH_EXTRA_BINDS="${NH_EXTRA_BINDS:+$NH_EXTRA_BINDS }-b $1"
                    shift
                    continue
                    ;;
                --bind=*)
                    NH_EXTRA_BINDS="${NH_EXTRA_BINDS:+$NH_EXTRA_BINDS }-b ${1#--bind=}"
                    shift
                    continue
                    ;;
                -d) NH_ISOLATED=0; NH_MINIMAL=0; shift; continue ;;
                -i) NH_ISOLATED=1; NH_MINIMAL=0; shift; continue ;;
                -m) NH_ISOLATED=1; NH_MINIMAL=1; shift; continue ;;
                --shared-tmp) NH_SHARED_TMP=1; shift; continue ;;
                --) _rest=1 ;;
            esac
        fi
        _q="'$(printf '%s' "$1" | sed "s/'/'\\\\''/g")'"
        _newargs="$_newargs $_q"
        if [ "$_rest" = "0" ]; then
            _pre="$_pre $_q"
        elif [ "$_dd" = "1" ]; then
            _post="$_post $_q"
        else
            _dd=1
        fi
        shift
    done
    # boot -p … / --attach: klient a rodič nebootují ani nepinují CPU
    if [ -n "${NH_DRAIN:-}" ]; then
        session_drain "$NH_CLIENT" "$NH_DRAIN"
        return 0
    fi
    if [ -n "${NH_CLIENT:-}" ]; then
        eval "set -- $_post"
        session_client "$NH_CLIENT" "$@"
        return
    fi
    if [ "${NH_ATTACH:-0}" = "1" ] && [ -z "${NH_ATTACH_CHILD:-}" ]; then
        [ "$_dd" = "1" ] && [ -z "$_post" ] && { err "--attach: prázdný příkaz za --"; return 2; }
        session_attach_parent "$_pre" "$_post"
        return
    fi
    [ -n "${NH_ATTACH_CHILD:-}" ] && session_ready "pid $$"
    [ -n "${NH_EXTRA_BINDS:-}" ] && export NH_EXTRA_BINDS
    eval "set -- $_newargs"
    apply_mode
    cpu_pin_apply

    case "${1:-}" in
        kali|parrot)
            boot_classic "$@"
            ;;
        docker)
            shift
            boot_docker "$@"
            ;;
        --)
            boot_reentry "$@"
            ;;
        --help|-h)
            echo "Usage: boot [options] {kali|parrot} [-- cmd args...]"
            echo "       boot [options] docker <image-name> [-- cmd args...]"
            echo "       boot -- cmd args...   (su_daemon re-entry, auto-detect distro)"
            echo "       boot [options]        (auto-detect active distro)"
            echo "       boot [options] <distro> --attach[=jméno] [-- příkaz]   session na pozadí"
            echo "       boot -p <pid|sid|jméno> [-q] -- příkaz                 příkaz do session"
            echo "       boot -p <pid|sid|jméno> --kill                         ukončit session"
            echo ""
            echo "Options (kdekoli před --):"
            echo "  -d                 DEFAULT mód: host bindy, fake /proc+/sys, Android env"
            echo "  -i                 ISOLATED mód: bez host bindů, fake /proc+/sys"
            echo "  -m                 MINIMAL mód: jen /dev /proc /sys, bez --sysvipc"
            echo "  -b src:dest        Extra bind mount (opakovatelné), = --bind src:dest"
            echo "  --bind=src:dest    Totéž, forma s rovnítkem"
            echo "  --shared-tmp       Hostitelský \$FILES_DIR/tmp jako guest /tmp"
            echo "  --attach[=jméno]   Session na pozadí s command serverem, vypíše PID/SID"
            echo "  -p, --pid X        Pošle příkaz do attach session (PID, SID nebo jméno)"
            echo "  -q, --quiet        S -p: bez výstupu (do \$FILES_DIR/tmp/boot-<sid>.log), hned exit 0"
            echo "  --kill             S -p: ukončí session"
            echo ""
            echo "Jeden argument za -- se shellovou syntaxí běží přes sh -c:"
            echo "  boot kali -- \"ls / | grep usr && echo ok\""
            echo ""
            echo "Env vars: PREFIX, FILES_DIR, NH_ISOLATED, NH_MINIMAL, NH_FAKE_SYS,"
            echo "          NH_MOUNT_STORAGE, NH_SHARED_TMP, NH_EXTRA_MOUNTS, NH_EXTRA_BINDS,"
            echo "          NH_CWD, NH_DISTRO, BOOT_DEBUG"
            ;;
        "")
            # No distro specified — auto-detect and boot interactively
            local _spec=""
            if [ -f "$FILES_DIR/nh/.active_distro" ]; then
                _spec=$(head -n1 "$FILES_DIR/nh/.active_distro" 2>/dev/null | tr -d '[:space:]')
            fi
            if [ -z "$_spec" ]; then
                if [ -d "$FILES_DIR/nh/distro/kali" ]; then _spec="kali"
                elif [ -d "$FILES_DIR/nh/distro/parrot" ]; then _spec="parrot"
                else
                    local _d
                    for _d in "$FILES_DIR"/nh/distro/docker/*/; do
                        [ -d "$_d" ] && _spec="docker:$(basename "$_d")" && break
                    done
                fi
            fi
            if [ -z "$_spec" ]; then
                err "No distro found (set NH_DISTRO or create nh/.active_distro)"
                return 1
            fi
            log "auto-detect distro=$_spec"
            case "$_spec" in
                docker:*) boot_docker "${_spec#docker:}" ;;
                *)        boot_classic "$_spec" ;;
            esac
            ;;
        *)
            err "Unknown command: $1"
            echo "Usage: boot {kali|parrot|docker} [--bind src:dest] ..." >&2
            return 1
            ;;
    esac
}

main "$@"
