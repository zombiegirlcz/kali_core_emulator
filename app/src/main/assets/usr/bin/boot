ctxt 140223
btime 1680020856
processes 772
procs_running 2
procs_blocked 0
softirq 75663 0 5903 6 25375 10774 0 243 11685 0 21677
NH_FAKE_STAT

    cat > "$SYSDATA_DIR/vmstat" <<'NH_FAKE_VMSTAT'
nr_free_pages 1743136
nr_zone_inactive_anon 179281
nr_zone_active_anon 7183
