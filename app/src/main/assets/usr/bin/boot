    # Fake /sys files: sys_empty dir + the individual sysctl entries.
    mkdir -p "$SYSDATA_DIR/sys_empty"
    mkdir -p "$SYSDATA_DIR/sysctl/kernel"
    mkdir -p "$SYSDATA_DIR/sysctl/fs/inotify"
    printf '40\n' > "$SYSDATA_DIR/sysctl/kernel/cap_last_cap"
    printf '4096\n' > "$SYSDATA_DIR/sysctl/fs/inotify/max_user_watches"
