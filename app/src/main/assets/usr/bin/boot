#!/system/bin/sh
# boot — universal PRoot launcher for NetHunter AI Operator
# Deployed to: $PREFIX/bin/boot (filesDir/usr/bin/boot)
# Usage: boot {kali|parrot} [-- cmd args...]
#        boot docker <image-name> [-- cmd args...]
#        boot -- cmd args...   (su_daemon re-entry; distro from .active_distro marker)
#        boot --help
#
# Env vars (set by caller or defaulted):
#   PREFIX      — host usr prefix (default: /data/user/0/com.linux_core/files/usr)
#   FILES_DIR   — app filesDir    (default: /data/user/0/com.linux_core/files)
#   NH_MOUNT_STORAGE — "1" to bind /sdcard
#   NH_EXTRA_MOUNTS  — additional -b flags (from root_settings)
#   NH_EXTRA_BINDS   — additional -b flags (from nh distro login --bind)
#   NH_CWD           — working dir override (su_daemon re-entry)
#   NH_DISTRO        — distro override for "--" re-entry mode (kali|parrot|docker:<image>)
#   BOOT_DEBUG       — "1" for verbose logging

set -e

PREFIX="${PREFIX:-/data/user/0/com.linux_core/files/usr}"
FILES_DIR="${FILES_DIR:-/data/user/0/com.linux_core/files}"
PROOT="$PREFIX/bin/proot"
# Loader: prefer new path (usr/bin/loader from deployArchBinaries), fallback to old (filesDir/loader)
LOADER="$PREFIX/bin/loader"
[ ! -x "$LOADER" ] && LOADER="$FILES_DIR/loader"
TALLOC="$PREFIX/lib/libtalloc.so.2"
[ ! -f "$TALLOC" ] && TALLOC="$FILES_DIR/libtalloc.so.2"

export LD_LIBRARY_PATH="$PREFIX/lib:/system/lib64:/system/lib"
export PROOT_LOADER="$LOADER"
export PROOT_TMP_DIR="$FILES_DIR/tmp"
export TMPDIR="$FILES_DIR/tmp"

# link2symlink support (hardlink emulation, required by dpkg)
# Note: actual path is set per-container in setup_sysdata_shm()

# proot extensions, split so minimal mode can drop the optional extras
# (--sysvipc and --kernel-release are omitted in minimal mode).
PROOT_FLAGS_BASE="-v 0 --kill-on-exit -0 --link2symlink -L"
PROOT_FLAGS_EXTRA="--sysvipc --kernel-release=\\Linux\\localhost\\6.17.0-nethunter\\6.17.0-nethunter\\aarch64\\localdomain\\-1\\"
PROOT_FLAGS="$PROOT_FLAGS_BASE $PROOT_FLAGS_EXTRA"

log() { [ -n "$BOOT_DEBUG" ] && echo "[boot] $*" >&2 || true; }
err() { echo "[boot] ERROR: $*" >&2; }

# ─── Session tracking ───────────────────────────────────
nh_session_start() {
    # $1 = distro name
    local distro="$1"
    local SESSION_DIR="$FILES_DIR/nh/sessions"
    mkdir -p "$SESSION_DIR"
    # JSON session metadata
    cat > "$SESSION_DIR/$$.json" << SESSIONEOF
{"pid": $$, "container": "$distro", "kind": "login", "command": [], "user": "root", "start_time": $(date +%s), "isolated": ${NH_ISOLATED:-0}, "minimal": ${NH_MINIMAL:-0}, "detach": false}
SESSIONEOF
}

nh_session_stop() {
    local distro="$1"
    rm -f "$FILES_DIR/nh/sessions/$distro.pid" "$FILES_DIR/nh/sessions/$distro.info" 2>/dev/null || true
}

nh_lock() {
    # $1 = lock name (e.g. "pull", "bootstrap")
    local lock="$1"
    local LOCK_DIR="$FILES_DIR/nh/locks"
    mkdir -p "$LOCK_DIR"
    local lockfile="$LOCK_DIR/$lock.lock"
    if [ -f "$lockfile" ]; then
        local pid
        pid=$(cat "$lockfile" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            err "Operation '$lock' already in progress (PID $pid)"
            return 1
        fi
        # Stale lock — remove
        rm -f "$lockfile"
    fi
    echo "$$" > "$lockfile"
    return 0
}

nh_unlock() {
    rm -f "$FILES_DIR/nh/locks/$1.lock" 2>/dev/null || true
}

# ─── Validate proot stack ───────────────────────────────
if [ ! -x "$PROOT" ]; then
    err "proot not found or not executable: $PROOT"
    exit 1
fi

# ─── Mode flags (set by UI or env) ───────────────────────
# NH_ISOLATED=1 → no host binds, only /dev /proc /sys
# NH_MINIMAL=1  → minimal proot config (no sysvipc, no fake sysdata)
# Note: isolated and minimal are independent flags
NH_ISOLATED="${NH_ISOLATED:-0}"
NH_MINIMAL="${NH_MINIMAL:-0}"

# minimal mode = bare proot config: no --sysvipc, no --kernel-release
if [ "$NH_MINIMAL" = "1" ]; then
    PROOT_FLAGS="$PROOT_FLAGS_BASE"
fi
export PROOT_FLAGS

# ─── Guest environment ──────────────────────────────────
export_guest_env() {
    # Browser/audio hints belong to the default environment, not the
    # stripped-down minimal one.
    if [ "$NH_MINIMAL" = "0" ]; then
        export MOZ_FAKE_NO_SANDBOX=1
        export PULSE_SERVER=127.0.0.1
    fi
    # HOME/USER/LOGNAME jsou potřeba VŽDY (i v minimal/isolated módu) — jinak
    # shell zdědí HOME=/ a prázdný LOGNAME z hostitelského prostředí.
    export HOME=/root
    export USER=root
    export LOGNAME=root
    # Android prostředí — jen neizolovaný (DEFAULT) mód. Potřeba pro bionic
    # binárky (linker64, ART, linux-x11). Hodnoty dědíme z host procesu,
    # fallback na standardní cesty (stejně jako androidHostEnv v ProotManager).
    if [ "$NH_ISOLATED" = "0" ]; then
        export ANDROID_ROOT="${ANDROID_ROOT:-/system}"
        export ANDROID_DATA="${ANDROID_DATA:-/data}"
        export ANDROID_ART_ROOT="${ANDROID_ART_ROOT:-/apex/com.android.art}"
        export ANDROID_I18N_ROOT="${ANDROID_I18N_ROOT:-/apex/com.android.i18n}"
        export ANDROID_TZDATA_ROOT="${ANDROID_TZDATA_ROOT:-/apex/com.android.tzdata}"
        export EXTERNAL_STORAGE="${EXTERNAL_STORAGE:-/sdcard}"
    fi
    export TERM="${TERM:-xterm-256color}"
    if [ -n "${COLORTERM:-}" ]; then
        export COLORTERM
    fi
}

# ─── sysdata + shm setup ────────────────────────────────
setup_sysdata_shm() {
    # $1 = distro name (kali|parrot|docker/<image>)
    local distro="${1:-kali}"
    local SYSROOT="$FILES_DIR/nh"
    local SYSDATA_DIR="$SYSROOT/sysdata/$distro"
    local SHM_DIR="$SYSROOT/shm/$distro"

    mkdir -p "$SYSDATA_DIR" "$SHM_DIR"

    # Set PROOT_L2S_DIR to a safe location inside rootfs
    # This avoids race conditions when multiple sessions start simultaneously.
    local L2S_DIR="$ROOTFS/.l2s"
    mkdir -p "$L2S_DIR" 2>/dev/null || true
    export PROOT_L2S_DIR="$L2S_DIR"

    # Skip fake sysdata in minimal mode
    if [ "$NH_MINIMAL" = "1" ]; then
        log "minimal mode: skipping fake sysdata"
        return 0
