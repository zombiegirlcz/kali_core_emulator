#!/system/bin/sh
# boot — universal PRoot launcher for NetHunter AI Operator
# Deployed to: $PREFIX/bin/boot (filesDir/usr/bin/boot)
# Usage: boot {kali|parrot} [-- cmd args...]
#        boot docker <image-name> [-- cmd args...]
#        boot -- cmd args...   (su_daemon re-entry; distro from .active_distro marker)
#        boot --help
#
# Env vars (set by caller or defaulted):
#   PREFIX      — host usr prefix (default: /data/user/0/com.linux_core/files/usr)
#   FILES_DIR   — app filesDir    (default: /data/user/0/com.linux_core/files)
#   NH_MOUNT_STORAGE — "1" to bind /storage/self/primary (/sdcard, /storage/emulated/0, ...)
#   NH_EXTRA_MOUNTS  — additional -b flags (from root_settings)
#   NH_EXTRA_BINDS   — additional -b flags (from nh distro login --bind)
#   NH_CWD           — working dir override (su_daemon re-entry)
#   NH_DISTRO        — distro override for "--" re-entry mode (kali|parrot|docker:<image>)
#   BOOT_DEBUG       — "1" for verbose logging
#   NH_FAKE_SYS      — "0" disables the fake /proc + /sys overlay (real kernel view)
#   NH_CPU_PIN       — "1" pins proot + guest to one fast core (NH_CPU_PIN_CORE overrides);
#                      guest env CPU_ALL="make,cargo,~/list.txt" = programs left on all cores

set -e

PREFIX="${PREFIX:-/data/user/0/com.linux_core/files/usr}"
FILES_DIR="${FILES_DIR:-/data/user/0/com.linux_core/files}"
PROOT="$PREFIX/bin/proot"
# Loader: prefer new path (usr/bin/loader from deployArchBinaries), fallback to old (filesDir/loader)
LOADER="$PREFIX/bin/loader"
[ ! -x "$LOADER" ] && LOADER="$FILES_DIR/loader"
# talloc se nepouziva: proot-static je slinkovany staticky s libtalloc.a

export LD_LIBRARY_PATH="$PREFIX/lib:/system/lib64:/system/lib"
export PROOT_LOADER="$LOADER"
export PROOT_TMP_DIR="$FILES_DIR/tmp"
export TMPDIR="$FILES_DIR/tmp"

# link2symlink support (hardlink emulation, required by dpkg)
# Note: actual path is set per-container in setup_sysdata_shm()

# Flagy a bindy kopírují referenční příkazy proot-distro (docs/proot-cmd-mod.md).
# Minimal vynechává --sysvipc a --kernel-release.
PROOT_FLAGS_BASE="--kill-on-exit --link2symlink -L --change-id=0:0"
PROOT_SYSVIPC="--sysvipc"
PROOT_KERNEL_RELEASE="--kernel-release=\\Linux\\localhost\\6.17.0-nethunter\\6.17.0-nethunter\\aarch64\\localdomain\\-1\\"
PROOT_FLAGS_EXTRA="$PROOT_SYSVIPC $PROOT_KERNEL_RELEASE"
PROOT_FLAGS="$PROOT_FLAGS_BASE $PROOT_FLAGS_EXTRA"

log() { [ -n "$BOOT_DEBUG" ] && echo "[boot] $*" >&2 || true; }
err() { echo "[boot] ERROR: $*" >&2; }

# ─── App settings fallback (su_daemon re-entry) ─────
# The app passes the session settings via env, but `sudo` inside the guest
# goes through su_daemon, which exec()s this script under real root and
# inherits only the daemon's environment. ProotManager keeps the settings in
# nh/root_env so a sudo session matches the session the user actually started
# (notably the /data bind and the fake /proc + /sys switch).
# Explicit caller env wins: the app sets NH_ENV_FROM_APP=1.
if [ "${NH_ENV_FROM_APP:-0}" != "1" ]; then
    ROOT_ENV_FILE="$FILES_DIR/nh/root_env"
    if [ -r "$ROOT_ENV_FILE" ]; then
        . "$ROOT_ENV_FILE" || true
        log "applied session settings from $ROOT_ENV_FILE"
    fi
fi

# ─── Session tracking ───────────────────────────────────
# Formát čte MainActivity (karta „Active Sessions"): nh/sessions/<id>.pid
# (PID) + <id>.info (popis). <id> = <distro>.<PID>, aby souběžné session
# stejného distra nepřepisovaly jedna druhou. PID zůstává platný i po exec
# do proot (exec PID nemění), takže kill z UI zasáhne proot. EXIT trap po exec
# neběží -> mrtvé záznamy uklízí až další start (kill -0) a UI je ignoruje.
nh_session_id() {
    # $1 = distro name (docker image může obsahovat '/')
    local _d
    _d=$(echo "$1" | tr '/: ' '___')
    echo "$_d.$$"
}

nh_session_start() {
    # $1 = distro name
    local distro="$1" _f _p
    local SESSION_DIR="$FILES_DIR/nh/sessions"
    local sid
    sid=$(nh_session_id "$distro")
    mkdir -p "$SESSION_DIR"
    # úklid záznamů mrtvých sessions + starý nečtený formát <pid>.json
    for _f in "$SESSION_DIR"/*.pid; do
        [ -f "$_f" ] || continue
        _p=$(cat "$_f" 2>/dev/null || echo "")
        if [ -z "$_p" ] || ! kill -0 "$_p" 2>/dev/null; then
            _f=${_f##*/}
            session_purge "${_f%.pid}"
        fi
    done
    # řídicí adresáře attach sessions bez .pid (sirotci)
    for _f in "$SESS_IPC"/*; do
        [ -d "$_f" ] || continue
        [ -f "$SESSION_DIR/${_f##*/}.pid" ] || session_purge "${_f##*/}"
    done
    rm -f "$SESSION_DIR"/*.json 2>/dev/null || true
    echo "$$" > "$SESSION_DIR/$sid.pid"
    echo "$distro isolated=${NH_ISOLATED:-0} minimal=${NH_MINIMAL:-0} start=$(date +%s)" \
        > "$SESSION_DIR/$sid.info"
}

nh_session_stop() {
    # Volá se jen z EXIT trapu, tj. když boot skončí PŘED exec do proot.
    local sid
    sid=$(nh_session_id "$1")
    session_purge "$sid"
}

nh_lock() {
    # $1 = lock name (e.g. "pull", "bootstrap")
    local lock="$1"
    local LOCK_DIR="$FILES_DIR/nh/locks"
    mkdir -p "$LOCK_DIR"
    local lockfile="$LOCK_DIR/$lock.lock"
    if [ -f "$lockfile" ]; then
        local pid
        pid=$(cat "$lockfile" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            err "Operation '$lock' already in progress (PID $pid)"
            return 1
        fi
        # Stale lock — remove
        rm -f "$lockfile"
    fi
    echo "$$" > "$lockfile"
    return 0
}

nh_unlock() {
    rm -f "$FILES_DIR/nh/locks/$1.lock" 2>/dev/null || true
}

# ─── Attach sessions: boot --attach / boot -p ───────────
# Spec: docs/superpowers/specs/2026-10-10-boot-sessions-design.md
# Evidence (.pid/.info, name.<jméno>) je v nh/sessions, řídicí adresář
# ipc/sessions/<sid>/ (ctl FIFO + req/<rid>/) vidí guest jako
# /run/host_ipc/sessions/<sid>. Prvním procesem v proot je SESSION_SERVER:
# čte z ctl řádky `run <rid>` / `exit` (< PIPE_BUF → atomické). Každý run
# spustí req/<rid>/cmd na pozadí se stdout/stderr do FIFO out/err a exit kód
# zapíše do rc. Dokud server žije, proot (--kill-on-exit) žije taky.
SESS_DIR="$FILES_DIR/nh/sessions"
SESS_IPC="$FILES_DIR/ipc/sessions"

# Guest strana: $0 = guest shell, $1 = PATH, $2 = sid, $3 = bootstrap (docker).
SESSION_SERVER='unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; export PATH="$1"
S="/run/host_ipc/sessions/$2"; b="$3"
if [ -n "$b" ] && [ -f "$b" ] && [ ! -f /.nh/bootstrap.done ]; then
    "$0" "$b" >&2 && mkdir -p /.nh && : > /.nh/bootstrap.done
fi
exec 3<>"$S/ctl" || exit 1
while read -r op rid <&3; do
    case "$op" in
        run)
            d="$S/req/$rid"
            [ -f "$d/cmd" ] || continue
            ( c=/root; [ -f "$d/cwd" ] && read -r c < "$d/cwd"; cd "$c" 2>/dev/null || cd /
              "$0" "$d/cmd" </dev/null >"$d/out" 2>"$d/err" &
              echo $! > "$d/pid.t"; mv "$d/pid.t" "$d/pid"
              wait $!; echo $? > "$d/rc.t"; mv "$d/rc.t" "$d/rc" ) 3<&- &
            ;;
        exit) exit 0 ;;
    esac
done'

# Guest wrapper pro `boot <distro> -- …` (i sudo/su_daemon re-entry):
# $0 = guest shell, $1 = PATH, zbytek = příkaz. Jediný argument se shellovou
# syntaxí (mezera/metaznak), který není existující příkaz, jde přes `sh -c`.
# Víc argumentů vždy verbatim — su_daemon předává argv.
REENTRY_WRAP='unset LD_PRELOAD PROOT_LOADER PROOT_TMP_DIR LD_LIBRARY_PATH; export PATH="$1"; shift
if [ $# -eq 1 ] && ! command -v "$1" >/dev/null 2>&1; then
    case "$1" in
        *[" 	|&;<>()\$\`*?{}~"]*|*"["*|*"]"*|*"
"*) exec "$0" -c "$1" ;;
    esac
fi
exec "$@"'

# Úklid evidence jedné session.
session_purge() {
    local sid="$1" _n _v
    [ -n "$sid" ] || return 0
    rm -f "$SESS_DIR/$sid.pid" "$SESS_DIR/$sid.info" "$FILES_DIR/tmp/boot-$sid.log" 2>/dev/null
    rm -rf "$SESS_IPC/$sid" 2>/dev/null
    for _n in "$SESS_DIR"/name.*; do
        [ -f "$_n" ] || continue
        _v=""
        { read -r _v < "$_n"; } 2>/dev/null || true
        if [ "$_v" = "$sid" ]; then rm -f "$_n"; fi
    done
    return 0
}

# Hlášení rodiči (boot --attach čeká na řádek `sid …` nebo `err …`).
session_ready() {
    echo "$*" >> "$SESS_DIR/attach.${NH_ATTACH_CHILD%%,*}.ready" 2>/dev/null || true
}

# Dítě: připraví řídicí adresář a evidenci, nastaví NH_ATTACH_SID (čte
# build_binds). Volá se po nh_session_start, před build_binds.
session_prepare() {
    local sid name="${NH_ATTACH_CHILD#*,}" d _old _p _i
    [ "$name" = "$NH_ATTACH_CHILD" ] && name=""
    sid=$(nh_session_id "$1")
    d="$SESS_IPC/$sid"
    if [ -n "$name" ] && [ -f "$SESS_DIR/name.$name" ]; then
        _old="" _p=""
        { read -r _old < "$SESS_DIR/name.$name"; } 2>/dev/null || true
        { read -r _p < "$SESS_DIR/$_old.pid"; } 2>/dev/null || true
        if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null; then
            session_ready "err jméno '$name' už používá session $_old"
            return 1
        fi
    fi
    if ! { mkdir -p "$d/req" && chmod 700 "$d" && mkfifo -m 600 "$d/ctl"; }; then
        session_ready "err nelze vytvořit $d"
        return 1
    fi
    [ -n "$name" ] && echo "$sid" > "$SESS_DIR/name.$name"
    { read -r _i < "$SESS_DIR/$sid.info"; } 2>/dev/null || _i="$1"
    echo "$_i attach=1 name=$name" > "$SESS_DIR/$sid.info"
    NH_ATTACH_SID="$sid"
}

# Dítě: exec proot se serverem jako prvním procesem.
# $1 ROOTFS  $2 GUEST_SH  $3 GUEST_PATH  $4 cwd  $5 BINDS  $6 bootstrap  $7 env navíc
session_server_exec() {
    session_ready "sid $NH_ATTACH_SID"
    exec env -i $(guest_env) $7 "$PROOT" $PROOT_FLAGS -r "$1" -w "$4" $5 \
        "$2" -c "$SESSION_SERVER" "$2" "$3" "$NH_ATTACH_SID" "$6"
}

# Rodič `boot … --attach`: spustí sám sebe odpojeně (setsid, stdin /dev/null)
# a čeká, až dítě nahlásí sid. $1 / $2 = quotované argumenty před / za `--`.
session_attach_parent() {
    set +e
    local ready="$SESS_DIR/attach.$$.ready" log="$FILES_DIR/tmp/boot-attach.$$.log"
    local _k _l _pid="" _sid="" _err="" _t=0 _v _post="$2"
    mkdir -p "$SESS_DIR" "$FILES_DIR/tmp"
    : > "$ready"
    # Dítě dostane hotové hodnoty v env, root_env znovu nečte (přebil by -d/-i/-m).
    export NH_ENV_FROM_APP=1
    for _v in NH_ISOLATED NH_MINIMAL NH_FAKE_SYS NH_MOUNT_STORAGE NH_SHARED_TMP \
              NH_EXTRA_MOUNTS NH_EXTRA_BINDS NH_CPU_PIN NH_CPU_PIN_CORE NH_DISTRO CPU_ALL; do
        if eval "[ -n \"\${$_v+x}\" ]"; then export "$_v"; fi
    done
    eval "set -- $1"
    setsid /system/bin/sh "$0" --attach-child="$$${NH_ATTACH_NAME:+,$NH_ATTACH_NAME}" "$@" \
        </dev/null >"$log" 2>&1 &
    while :; do
        while read -r _k _l; do
            case "$_k" in
                pid) _pid=$_l ;;
                sid) _sid=$_l ;;
                err) _err=$_l ;;
            esac
        done < "$ready"
        [ -n "$_sid" ] || [ -n "$_err" ] && break
        if [ -n "$_pid" ]; then
            kill -0 "$_pid" 2>/dev/null || { _err="session skončila při startu"; break; }
        elif [ "$_t" -ge 50 ]; then
            _err="session se nespustila"; break
        fi
        [ "$_t" = 25 ] && echo "[boot] čekám na start session (první start / bootstrap)…" >&2
        _t=$((_t + 1))
        sleep 0.2
    done
    rm -f "$ready"
    if [ -z "$_sid" ]; then
        err "${_err:-session se nespustila}"
        tail -n 15 "$log" >&2 2>/dev/null
        return 1
    fi
    echo "PID=$_pid SID=$_sid${NH_ATTACH_NAME:+ NAME=$NH_ATTACH_NAME}"
    # proot vypisuje varování (bindy) do logu jen při startu
    rm -f "$log"
    if [ -n "$_post" ]; then
        eval "set -- $_post"
        NH_QUIET=1
        session_client "$_sid" "$@"
    fi
    return 0
}

# <pid|sid|jméno> → sid na stdout; 2 = nenalezeno.
session_resolve() {
    local x="$1" f p
    case "$x" in
        ""|*[!A-Za-z0-9_.-]*) return 2 ;;
        *[!0-9]*) ;;
        *)
            for f in "$SESS_DIR"/*.pid; do
                [ -f "$f" ] || continue
                p=""
                { read -r p < "$f"; } 2>/dev/null || continue
                if [ "$p" = "$x" ]; then f=${f##*/}; echo "${f%.pid}"; return 0; fi
            done
            return 2
            ;;
    esac
    if [ -f "$SESS_DIR/name.$x" ]; then
        { read -r p < "$SESS_DIR/name.$x"; } 2>/dev/null && [ -n "$p" ] && { echo "$p"; return 0; }
    fi
    [ -f "$SESS_DIR/$x.pid" ] && { echo "$x"; return 0; }
    return 2
}

# Argumenty → jeden shellový řetězec ('…' + '\'').
session_quote() {
    local a out=""
    for a in "$@"; do
        out="$out '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"
    done
    echo "${out# }"
}

# Zápis řádku do ctl. timeout: open FIFO bez čtenáře by visel navždy.
session_send() {  # $1 ctl, $2 řádek
    timeout 15 /system/bin/sh -c 'echo "$1" > "$2"' _ "$2" "$1"
}

session_wait_rc() {  # $1 req dir, $2 PID session → rc na stdout
    local rc=""
    while [ ! -f "$1/rc" ]; do
        kill -0 "$2" 2>/dev/null || { echo 255; return 0; }
        sleep 0.1
    done
    { read -r rc < "$1/rc"; } 2>/dev/null
    echo "${rc:-255}"
}

# Guest procesy jsou obyčejné procesy hosta (proot = ptrace) se stejným UID,
# takže strom příkazu jde zabít přímo odsud — bez job control v guest shellu.
session_kill_tree() {  # $1 PID, $2 signál; potomci dřív než rodič
    local c
    for c in $(pgrep -P "$1" 2>/dev/null); do session_kill_tree "$c" "$2"; done
    kill -"$2" "$1" 2>/dev/null || true
}

session_interrupt() {  # $1 req dir (Ctrl-C v klientovi)
    local p="" i=0
    { read -r p < "$1/pid"; } 2>/dev/null
    [ -n "$p" ] && session_kill_tree "$p" TERM
    while [ ! -f "$1/rc" ] && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
    [ -f "$1/rc" ] || { [ -n "$p" ] && session_kill_tree "$p" KILL; }
    rm -rf "$1"
    exit 130
}

session_kill() {  # $1 sid, $2 PID
    local i=0
    session_send "$SESS_IPC/$1/ctl" exit
    while kill -0 "$2" 2>/dev/null && [ "$i" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
    kill -0 "$2" 2>/dev/null && kill -TERM "$2" 2>/dev/null
    session_purge "$1"
    echo "[boot] session $1 ukončena"
}

# Klient `boot -p <cíl> [-q] -- příkaz…` / `boot -p <cíl> --kill`.
session_client() {
    set +e
    local target="$1" sid pid="" d req cmd distro cwd=/root co ce rc
    shift
    sid=$(session_resolve "$target") || { err "session '$target' neexistuje"; return 2; }
    { read -r pid < "$SESS_DIR/$sid.pid"; } 2>/dev/null
    d="$SESS_IPC/$sid"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        err "session $sid neběží (PID ${pid:-?}), uklízím"
        session_purge "$sid"
        return 3
    fi
    [ -p "$d/ctl" ] || { err "session $sid není --attach session (chybí $d/ctl)"; return 3; }
    if [ "${NH_KILL:-0}" = "1" ]; then session_kill "$sid" "$pid"; return 0; fi
    [ $# -gt 0 ] || { err "chybí příkaz: boot -p $target -- <příkaz>"; return 2; }
    if [ $# -eq 1 ]; then cmd="$1"; else cmd=$(session_quote "$@"); fi
    # cwd klienta, pokud v rootfs existuje (1. slovo .info = distro)
    { read -r distro _ < "$SESS_DIR/$sid.info"; } 2>/dev/null
    [ -n "$PWD" ] && [ -n "$distro" ] && [ -d "$FILES_DIR/nh/distro/$distro$PWD" ] && cwd="$PWD"
    req="$d/req/$$.$RANDOM"
    mkdir "$req" || { err "nelze vytvořit $req"; return 1; }
    echo "$cmd" > "$req/cmd"
    echo "$cwd" > "$req/cwd"
    mkfifo -m 600 "$req/out" "$req/err" || { rm -rf "$req"; err "mkfifo selhal"; return 1; }
    if ! session_send "$d/ctl" "run ${req##*/}"; then
        rm -rf "$req"; err "session $sid neodpovídá"; return 1
    fi
    if [ "${NH_QUIET:-0}" = "1" ]; then
        setsid /system/bin/sh "$0" --pid="$sid" --drain="${req##*/}" </dev/null >/dev/null 2>&1 &
        return 0
    fi
    trap 'session_interrupt "$req"' INT TERM HUP
    # oba cat na pozadí: `wait` přeruší signál hned, popředí by trap odložilo
    cat "$req/out" & co=$!
    cat "$req/err" >&2 & ce=$!
    wait "$co"; wait "$ce"
    rc=$(session_wait_rc "$req" "$pid")
    trap - INT TERM HUP
    rm -rf "$req"
    return "$rc"
}

# `-q`: odpojený čtenář out/err → tmp/boot-<sid>.log.
session_drain() {  # $1 sid, $2 rid
    set +e
    local req="$SESS_IPC/$1/req/$2" log="$FILES_DIR/tmp/boot-$1.log" pid="" co ce c=""
    { read -r pid < "$SESS_DIR/$1.pid"; } 2>/dev/null
    { read -r c < "$req/cmd"; } 2>/dev/null
    echo "--- $2 $c" >> "$log"
    cat "$req/out" >> "$log" & co=$!
    cat "$req/err" >> "$log" & ce=$!
    wait "$co"; wait "$ce"
    echo "--- $2 rc=$(session_wait_rc "$req" "$pid")" >> "$log"
    rm -rf "$req"
}

# ─── Validate proot stack ───────────────────────────────
if [ ! -x "$PROOT" ]; then
    err "proot not found or not executable: $PROOT"
    exit 1
fi

# ─── Mode flags (env NH_* nebo CLI -d/-i/-m) ─────────────
# D: NH_ISOLATED=0 NH_MINIMAL=0 | I: 1/0 | M: 1/1
# NH_FAKE_SYS=0 -> no fake /proc + /sys overlay: the guest sees Android's real
# /proc/{version,stat,uptime,vmstat,loadavg}, the real /proc/sys and the real
# /sys/fs/selinux, and `uname -r` reports the real kernel. Tooling that
# inspects the real kernel/process view (e.g. Frida) needs this. --sysvipc and
# the /dev fixes stay enabled, only the fake view is dropped.
# Volá se až po parsování argumentů v main(), aby CLI flagy přebily env.
apply_mode() {
    NH_ISOLATED="${NH_ISOLATED:-0}"
    NH_MINIMAL="${NH_MINIMAL:-0}"
    NH_FAKE_SYS="${NH_FAKE_SYS:-1}"
    NH_SHARED_TMP="${NH_SHARED_TMP:-0}"
    # Fake /proc + /sys overlay: DEFAULT i ISOLATED ho mají (jako proot-distro),
    # MINIMAL nikdy. Přepínač NH_FAKE_SYS=0 ho vypne pro D i I.
    if [ "$NH_MINIMAL" = "1" ] || [ "$NH_FAKE_SYS" != "1" ]; then
        NH_FAKE_EFFECTIVE=0
    else
        NH_FAKE_EFFECTIVE=1
    fi
    # minimal mode = bare proot config: no --sysvipc, no --kernel-release
    if [ "$NH_MINIMAL" = "1" ]; then
        PROOT_FLAGS="$PROOT_FLAGS_BASE"
    else
        PROOT_FLAGS="$PROOT_FLAGS_BASE $PROOT_SYSVIPC"
        # --kernel-release is part of the fake view; without it `uname -r` reports
        # the actual Android kernel.
        [ "$NH_FAKE_EFFECTIVE" = "1" ] && PROOT_FLAGS="$PROOT_FLAGS $PROOT_KERNEL_RELEASE"
    fi
    export NH_ISOLATED NH_MINIMAL NH_FAKE_SYS NH_FAKE_EFFECTIVE NH_SHARED_TMP PROOT_FLAGS
}

# ─── Guest environment ──────────────────────────────────
# proot se spouští přes `env -i` s explicitním seznamem proměnných (jako
# proot-distro), guest tedy nedědí prostředí appky. Vypisuje slova VAR=VAL
# pro word-splitting; hodnoty nesmí obsahovat mezery.
guest_env() {
    # proot si PROOT_LOADER/PROOT_TMP_DIR čte sám; guest wrapper je hned unsetne
    # (PROOT_L2S_DIR v guestu zůstává, čte ho guest `ashell`).
    local _e="PROOT_LOADER=$LOADER PROOT_TMP_DIR=$FILES_DIR/tmp"
    [ -n "${PROOT_L2S_DIR:-}" ] && _e="$_e PROOT_L2S_DIR=$PROOT_L2S_DIR"
    _e="$_e HOME=/root USER=root LOGNAME=root"
    _e="$_e TERM=${TERM:-xterm-256color} COLORTERM=${COLORTERM:-truecolor}"
    # Mimo referenci: UTF-8 locale pro glibc a proměnné, které čte guest `nh`.
    [ -n "${LANG:-}" ] && _e="$_e LANG=$LANG"
    [ -n "${LC_CTYPE:-}" ] && _e="$_e LC_CTYPE=$LC_CTYPE"
    [ -n "${NETHUNTER_SESSION_ID:-}" ] && _e="$_e NETHUNTER_SESSION_ID=$NETHUNTER_SESSION_ID"
    [ -n "${NH_DISTRO:-}" ] && _e="$_e NH_DISTRO=$NH_DISTRO"

    # CPU_ALL default whitelist je v /usr/share/nh/cpu_all.conf (exportuje ho
    # zshrc.kali/parrot uvnitř guestu). Tady jen propagujeme app/root_env hodnotu.
    if [ -n "${CPU_ALL:-}" ]; then
        # Mezery → čárky: guest_env() se word-splittuje, hodnoty nesmí mít mezery.
        # cpu_all_words() čárky zpátky rozsekne na slova.
        _e="$_e CPU_ALL=$(echo "$CPU_ALL" | tr ' ' ',')"
    fi

    local _path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/games:/usr/games"
    if [ "$NH_MINIMAL" = "1" ]; then
        echo "$_e PATH=$_path"
        return 0
    fi
    _e="$_e PATH=$_path:/system/bin:/system/xbin MOZ_FAKE_NO_SANDBOX=1 PULSE_SERVER=127.0.0.1"
    if [ "$NH_ISOLATED" = "0" ]; then
        _e="$_e ANDROID_ART_ROOT=${ANDROID_ART_ROOT:-/apex/com.android.art}"
        _e="$_e ANDROID_DATA=${ANDROID_DATA:-/data}"
        _e="$_e ANDROID_I18N_ROOT=${ANDROID_I18N_ROOT:-/apex/com.android.i18n}"
        _e="$_e ANDROID_ROOT=${ANDROID_ROOT:-/system}"
        _e="$_e ANDROID_TZDATA_ROOT=${ANDROID_TZDATA_ROOT:-/apex/com.android.tzdata}"
        [ -n "${BOOTCLASSPATH:-}" ] && _e="$_e BOOTCLASSPATH=$BOOTCLASSPATH"
        [ -n "${DEX2OATBOOTCLASSPATH:-}" ] && _e="$_e DEX2OATBOOTCLASSPATH=$DEX2OATBOOTCLASSPATH"
        [ "$NH_MOUNT_STORAGE" = "1" ] && _e="$_e EXTERNAL_STORAGE=/storage/emulated/0"
    fi
    echo "$_e"
}

# ─── sysdata + shm setup ────────────────────────────────
setup_sysdata_shm() {
    # $1 = distro name (kali|parrot|docker/<image>)
    local distro="${1:-kali}"
    local SYSROOT="$FILES_DIR/nh"
    local SYSDATA_DIR="$SYSROOT/sysdata/$distro"
    local SHM_DIR="$SYSROOT/shm/$distro"

    mkdir -p "$SYSDATA_DIR" "$SHM_DIR"

    # Set PROOT_L2S_DIR to a safe location inside rootfs
    # This avoids race conditions when multiple sessions start simultaneously.
    local L2S_DIR="$ROOTFS/.l2s"
    mkdir -p "$L2S_DIR" 2>/dev/null || true
    export PROOT_L2S_DIR="$L2S_DIR"

    # Skip fake sysdata in minimal mode
    if [ "$NH_MINIMAL" = "1" ]; then
        log "minimal mode: skipping fake sysdata"
        return 0
    fi

    # Overlay disabled (isolated/minimal mode or the UI switch) -> the guest
    # must see the real /proc + /sys, so there is nothing to generate.
    # (PROOT_L2S_DIR above is already set.)
    if [ "$NH_FAKE_EFFECTIVE" != "1" ]; then
        log "fake-sys disabled: skipping fake sysdata"
        return 0
    fi

    # Fake /proc files (Android blocks/limits these).
    # Content is static so tools that read these files (top, htop, dpkg)
    # get consistent values on Android.
    printf '0.12 0.07 0.02 2/165 765\n' > "$SYSDATA_DIR/loadavg"
    printf '124.08 932.80\n' > "$SYSDATA_DIR/uptime"
    printf '%s\n' "Linux version 6.17.0-nethunter (nethunter@localhost) (gcc (GCC) 13.3.0, GNU ld (GNU Binutils) 2.42) #1 SMP PREEMPT_DYNAMIC Fri, 10 Oct 2025 00:00:00 +0000" > "$SYSDATA_DIR/version"

    cat > "$SYSDATA_DIR/stat" <<'NH_FAKE_STAT'
