#!/system/bin/sh
# boot — universal PRoot launcher for NetHunter AI Operator
# Deployed to: $PREFIX/bin/boot (filesDir/usr/bin/boot)
# Usage: boot {kali|parrot} [-- cmd args...]
#        boot docker <image-name> [-- cmd args...]
#        boot -- cmd args...   (su_daemon re-entry; distro from .active_distro marker)
#        boot --help
#
# Env vars (set by caller or defaulted):
#   PREFIX      — host usr prefix (default: /data/user/0/com.linux_core/files/usr)
#   FILES_DIR   — app filesDir    (default: /data/user/0/com.linux_core/files)
#   NH_MOUNT_STORAGE — "1" to bind /storage/self/primary (/sdcard, /storage/emulated/0, ...)
#   NH_EXTRA_MOUNTS  — additional -b flags (from root_settings)
#   NH_EXTRA_BINDS   — additional -b flags (from nh distro login --bind)
#   NH_CWD           — working dir override (su_daemon re-entry)
#   NH_DISTRO        — distro override for "--" re-entry mode (kali|parrot|docker:<image>)
#   BOOT_DEBUG       — "1" for verbose logging
#   NH_FAKE_SYS      — "0" disables the fake /proc + /sys overlay (real kernel view)
#   NH_CPU_PIN       — "1" pins proot + guest to one fast core (NH_CPU_PIN_CORE overrides)

set -e

PREFIX="${PREFIX:-/data/user/0/com.linux_core/files/usr}"
FILES_DIR="${FILES_DIR:-/data/user/0/com.linux_core/files}"
PROOT="$PREFIX/bin/proot"
# Loader: prefer new path (usr/bin/loader from deployArchBinaries), fallback to old (filesDir/loader)
LOADER="$PREFIX/bin/loader"
[ ! -x "$LOADER" ] && LOADER="$FILES_DIR/loader"
# talloc se nepouziva: proot-static je slinkovany staticky s libtalloc.a

export LD_LIBRARY_PATH="$PREFIX/lib:/system/lib64:/system/lib"
export PROOT_LOADER="$LOADER"
export PROOT_TMP_DIR="$FILES_DIR/tmp"
export TMPDIR="$FILES_DIR/tmp"

# link2symlink support (hardlink emulation, required by dpkg)
# Note: actual path is set per-container in setup_sysdata_shm()

# Flagy a bindy kopírují referenční příkazy proot-distro (docs/proot-cmd-mod.md).
# Minimal vynechává --sysvipc a --kernel-release.
PROOT_FLAGS_BASE="--kill-on-exit --link2symlink -L --change-id=0:0"
PROOT_SYSVIPC="--sysvipc"
PROOT_KERNEL_RELEASE="--kernel-release=\\Linux\\localhost\\6.17.0-nethunter\\6.17.0-nethunter\\aarch64\\localdomain\\-1\\"
PROOT_FLAGS_EXTRA="$PROOT_SYSVIPC $PROOT_KERNEL_RELEASE"
PROOT_FLAGS="$PROOT_FLAGS_BASE $PROOT_FLAGS_EXTRA"

log() { [ -n "$BOOT_DEBUG" ] && echo "[boot] $*" >&2 || true; }
err() { echo "[boot] ERROR: $*" >&2; }

# ─── App settings fallback (su_daemon re-entry) ─────
# The app passes the session settings via env, but `sudo` inside the guest
# goes through su_daemon, which exec()s this script under real root and
# inherits only the daemon's environment. ProotManager keeps the settings in
# nh/root_env so a sudo session matches the session the user actually started
# (notably the /data bind and the fake /proc + /sys switch).
# Explicit caller env wins: the app sets NH_ENV_FROM_APP=1.
if [ "${NH_ENV_FROM_APP:-0}" != "1" ]; then
    ROOT_ENV_FILE="$FILES_DIR/nh/root_env"
    if [ -r "$ROOT_ENV_FILE" ]; then
        . "$ROOT_ENV_FILE" || true
        log "applied session settings from $ROOT_ENV_FILE"
    fi
fi

# ─── Session tracking ───────────────────────────────────
nh_session_start() {
    # $1 = distro name
    local distro="$1"
    local SESSION_DIR="$FILES_DIR/nh/sessions"
    mkdir -p "$SESSION_DIR"
    # JSON session metadata
    cat > "$SESSION_DIR/$$.json" << SESSIONEOF
{"pid": $$, "container": "$distro", "kind": "login", "command": [], "user": "root", "start_time": $(date +%s), "isolated": ${NH_ISOLATED:-0}, "minimal": ${NH_MINIMAL:-0}, "detach": false}
SESSIONEOF
}

nh_session_stop() {
    local distro="$1"
    rm -f "$FILES_DIR/nh/sessions/$distro.pid" "$FILES_DIR/nh/sessions/$distro.info" 2>/dev/null || true
}

nh_lock() {
    # $1 = lock name (e.g. "pull", "bootstrap")
    local lock="$1"
    local LOCK_DIR="$FILES_DIR/nh/locks"
    mkdir -p "$LOCK_DIR"
    local lockfile="$LOCK_DIR/$lock.lock"
    if [ -f "$lockfile" ]; then
        local pid
        pid=$(cat "$lockfile" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            err "Operation '$lock' already in progress (PID $pid)"
            return 1
        fi
        # Stale lock — remove
        rm -f "$lockfile"
    fi
    echo "$$" > "$lockfile"
    return 0
}

nh_unlock() {
    rm -f "$FILES_DIR/nh/locks/$1.lock" 2>/dev/null || true
}

# ─── Validate proot stack ───────────────────────────────
if [ ! -x "$PROOT" ]; then
    err "proot not found or not executable: $PROOT"
    exit 1
fi

# ─── Mode flags (env NH_* nebo CLI -d/-i/-m) ─────────────
# D: NH_ISOLATED=0 NH_MINIMAL=0 | I: 1/0 | M: 1/1
# NH_FAKE_SYS=0 -> no fake /proc + /sys overlay: the guest sees Android's real
# /proc/{version,stat,uptime,vmstat,loadavg}, the real /proc/sys and the real
# /sys/fs/selinux, and `uname -r` reports the real kernel. Tooling that
# inspects the real kernel/process view (e.g. Frida) needs this. --sysvipc and
# the /dev fixes stay enabled, only the fake view is dropped.
# Volá se až po parsování argumentů v main(), aby CLI flagy přebily env.
apply_mode() {
    NH_ISOLATED="${NH_ISOLATED:-0}"
    NH_MINIMAL="${NH_MINIMAL:-0}"
    NH_FAKE_SYS="${NH_FAKE_SYS:-1}"
    NH_SHARED_TMP="${NH_SHARED_TMP:-0}"
    # Fake /proc + /sys overlay: DEFAULT i ISOLATED ho mají (jako proot-distro),
    # MINIMAL nikdy. Přepínač NH_FAKE_SYS=0 ho vypne pro D i I.
    if [ "$NH_MINIMAL" = "1" ] || [ "$NH_FAKE_SYS" != "1" ]; then
        NH_FAKE_EFFECTIVE=0
    else
        NH_FAKE_EFFECTIVE=1
    fi
    # minimal mode = bare proot config: no --sysvipc, no --kernel-release
    if [ "$NH_MINIMAL" = "1" ]; then
        PROOT_FLAGS="$PROOT_FLAGS_BASE"
    else
        PROOT_FLAGS="$PROOT_FLAGS_BASE $PROOT_SYSVIPC"
        # --kernel-release is part of the fake view; without it `uname -r` reports
        # the actual Android kernel.
        [ "$NH_FAKE_EFFECTIVE" = "1" ] && PROOT_FLAGS="$PROOT_FLAGS $PROOT_KERNEL_RELEASE"
    fi
    export NH_ISOLATED NH_MINIMAL NH_FAKE_SYS NH_FAKE_EFFECTIVE NH_SHARED_TMP PROOT_FLAGS
}

# ─── Guest environment ──────────────────────────────────
# proot se spouští přes `env -i` s explicitním seznamem proměnných (jako
# proot-distro), guest tedy nedědí prostředí appky. Vypisuje slova VAR=VAL
# pro word-splitting; hodnoty nesmí obsahovat mezery.
guest_env() {
    # proot si PROOT_LOADER/PROOT_TMP_DIR čte sám; guest wrapper je hned unsetne
    # (PROOT_L2S_DIR v guestu zůstává, čte ho guest `ashell`).
    local _e="PROOT_LOADER=$LOADER PROOT_TMP_DIR=$FILES_DIR/tmp"
    [ -n "${PROOT_L2S_DIR:-}" ] && _e="$_e PROOT_L2S_DIR=$PROOT_L2S_DIR"
    _e="$_e HOME=/root USER=root LOGNAME=root"
    _e="$_e TERM=${TERM:-xterm-256color} COLORTERM=${COLORTERM:-truecolor}"
    # Mimo referenci: UTF-8 locale pro glibc a proměnné, které čte guest `nh`.
    [ -n "${LANG:-}" ] && _e="$_e LANG=$LANG"
    [ -n "${LC_CTYPE:-}" ] && _e="$_e LC_CTYPE=$LC_CTYPE"
    [ -n "${NETHUNTER_SESSION_ID:-}" ] && _e="$_e NETHUNTER_SESSION_ID=$NETHUNTER_SESSION_ID"
    [ -n "${NH_DISTRO:-}" ] && _e="$_e NH_DISTRO=$NH_DISTRO"

    local _path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/games:/usr/games"
    if [ "$NH_MINIMAL" = "1" ]; then
        echo "$_e PATH=$_path"
        return 0
    fi
    _e="$_e PATH=$_path:/system/bin:/system/xbin MOZ_FAKE_NO_SANDBOX=1 PULSE_SERVER=127.0.0.1"
    if [ "$NH_ISOLATED" = "0" ]; then
        _e="$_e ANDROID_ART_ROOT=${ANDROID_ART_ROOT:-/apex/com.android.art}"
        _e="$_e ANDROID_DATA=${ANDROID_DATA:-/data}"
        _e="$_e ANDROID_I18N_ROOT=${ANDROID_I18N_ROOT:-/apex/com.android.i18n}"
        _e="$_e ANDROID_ROOT=${ANDROID_ROOT:-/system}"
        _e="$_e ANDROID_TZDATA_ROOT=${ANDROID_TZDATA_ROOT:-/apex/com.android.tzdata}"
        [ -n "${BOOTCLASSPATH:-}" ] && _e="$_e BOOTCLASSPATH=$BOOTCLASSPATH"
        [ -n "${DEX2OATBOOTCLASSPATH:-}" ] && _e="$_e DEX2OATBOOTCLASSPATH=$DEX2OATBOOTCLASSPATH"
        [ "$NH_MOUNT_STORAGE" = "1" ] && _e="$_e EXTERNAL_STORAGE=/storage/emulated/0"
    fi
    echo "$_e"
}

# ─── sysdata + shm setup ────────────────────────────────
setup_sysdata_shm() {
    # $1 = distro name (kali|parrot|docker/<image>)
    local distro="${1:-kali}"
    local SYSROOT="$FILES_DIR/nh"
    local SYSDATA_DIR="$SYSROOT/sysdata/$distro"
    local SHM_DIR="$SYSROOT/shm/$distro"

    mkdir -p "$SYSDATA_DIR" "$SHM_DIR"

    # Set PROOT_L2S_DIR to a safe location inside rootfs
    # This avoids race conditions when multiple sessions start simultaneously.
    local L2S_DIR="$ROOTFS/.l2s"
    mkdir -p "$L2S_DIR" 2>/dev/null || true
    export PROOT_L2S_DIR="$L2S_DIR"

    # Skip fake sysdata in minimal mode
    if [ "$NH_MINIMAL" = "1" ]; then
        log "minimal mode: skipping fake sysdata"
        return 0
    fi

    # Overlay disabled (isolated/minimal mode or the UI switch) -> the guest
    # must see the real /proc + /sys, so there is nothing to generate.
    # (PROOT_L2S_DIR above is already set.)
    if [ "$NH_FAKE_EFFECTIVE" != "1" ]; then
        log "fake-sys disabled: skipping fake sysdata"
        return 0
    fi

    # Fake /proc files (Android blocks/limits these).
    # Content is static so tools that read these files (top, htop, dpkg)
    # get consistent values on Android.
    printf '0.12 0.07 0.02 2/165 765\n' > "$SYSDATA_DIR/loadavg"
    printf '124.08 932.80\n' > "$SYSDATA_DIR/uptime"
    printf '%s\n' "Linux version 6.17.0-nethunter (nethunter@localhost) (gcc (GCC) 13.3.0, GNU ld (GNU Binutils) 2.42) #1 SMP PREEMPT_DYNAMIC Fri, 10 Oct 2025 00:00:00 +0000" > "$SYSDATA_DIR/version"

    cat > "$SYSDATA_DIR/stat" <<'NH_FAKE_STAT'
