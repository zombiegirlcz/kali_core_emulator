network_map() {
    echo "[*] Fetching current location..."
    api_get "/map" | fmt "
import sys, json
try:
    d=json.load(sys.stdin)
    if d.get('success'):
        print(f'📍 Location: {d[\"latitude\"]}, {d[\"longitude\"]}')
        print('🗺️  Starting TerminalMap...')
    else: print(d.get('error','Unknown error'))
except: print('Error')
"
    echo "[*] Controls: arrow keys/hjkl=pan, a/+/-=zoom, c=braille/ASCII, n=labels, g=tour, w=world, q=quit"
    command -v terminalmap >/dev/null 2>&1 && terminalmap || echo "[-] terminalmap binary not found"
