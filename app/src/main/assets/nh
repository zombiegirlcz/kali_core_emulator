cpu_trace() {
    local dur=${1:-60} logfile="${2:-/tmp/cpu_trace_$(date +%Y%m%d_%H%M%S).log}"
    local tp interval=2
    tp=$(cpu_tracer)
    if [ -z "$tp" ] || [ "$tp" = "0" ]; then
        echo "  mimo proot, trace nelze"; return 1
    fi
    local mask=$(cpu_getaff "$tp")
    local pinned_cores=$(python3 -c "m=int('$mask',16); print(' '.join(str(i) for i in range(64) if m>>i&1))" 2>/dev/null)
    printf "${WHITE}${BOLD}CPU TRACE${RST} — %ss → %s\n" "$dur" "$logfile"
    printf "  proot pid: %s  maska: 0x%s  jádra: [%s]\n\n" "$tp" "$mask" "$pinned_cores"

    cat > "$logfile" <<HEADER
# nh cpu trace — $(date)
# proot=$tp mask=0x$mask pinned=[$pinned_cores] dur=${dur}s interval=${interval}s
#
# ts,syscall_us,proot_core,core_freq_mhz,pinned_proc_count,procs_on_core
HEADER

    local elapsed=0
    while [ "$elapsed" -lt "$dur" ]; do
        python3 - "$tp" "$mask" "$logfile" "$pinned_cores" <<'PYEOF'
import os, sys, time

tp = sys.argv[1]
mask = int(sys.argv[2], 16)
logfile = sys.argv[3]
pinned = set(sys.argv[4].split())

ts = time.strftime("%H:%M:%S")

# 1) syscall latency — os.stat() is actually traced by proot (unlike getpid which glibc caches)
n = 100
t0 = time.monotonic()
for _ in range(n): os.stat("/proc/self/stat")
lat = (time.monotonic() - t0) * 1e6 / n

# 2) which core is proot actually on
try:
    with open(f"/proc/{tp}/stat") as f:
        proot_core = f.read().split(")")[1].split()[36]
except: proot_core = "?"

# 3) freq of that core
try:
    with open(f"/sys/devices/system/cpu/cpu{proot_core}/cpufreq/scaling_cur_freq") as f:
        freq = int(f.read().strip()) // 1000
except: freq = 0

# 4) scan ALL host procs: who's on our pinned core(s) + delta CPU time
on_pinned = []
for d in os.listdir("/proc"):
    if not d.isdigit(): continue
    try:
        with open(f"/proc/{d}/stat") as f:
            raw = f.read()
        comm_end = raw.rindex(")")
        comm = raw[raw.index("(")+1:comm_end]
        fields = raw[comm_end+2:].split()
        utime, stime = int(fields[11]), int(fields[12])
        proc_core = fields[36]
        state = fields[0]
        if proc_core in pinned:
            on_pinned.append((utime + stime, d, comm, state))
    except: pass

on_pinned.sort(reverse=True)

# format: comm:pid:cputicks:state (top 12)
pinned_str = " ".join(f"{c}:{p}:{t}:{s}" for t, p, c, s in on_pinned[:12])

with open(logfile, "a") as f:
    f.write(f"{ts},{lat:.0f},{proot_core},{freq},{len(on_pinned)},{pinned_str}\n")

# live output
if lat < 150:   col = "\033[1;32m"
elif lat < 300: col = "\033[1;33m"
else:           col = "\033[1;31m"
rst, dim, yel = "\033[0m", "\033[2m", "\033[1;33m"

sys.stdout.write(f"\r  {ts} {col}{lat:5.0f}µs{rst}  core:{proot_core} {freq}MHz  {len(on_pinned)} procs")

# noise: non-proot processes with significant CPU time on pinned core
noise = [(t, p, c) for t, p, c, s in on_pinned
         if c not in ("python3", "sh", "cat", "sleep", "proot", "nh") and p != tp and t > 10][:3]
if noise:
    sys.stdout.write(f"  {yel}noise: {' '.join(f'{c}({t})' for t,p,c in noise)}{rst}")
sys.stdout.write("   ")
sys.stdout.flush()
PYEOF
        sleep "$interval"
        elapsed=$(( elapsed + interval ))
    done

    echo ""
    echo ""
    printf "${WHITE}${BOLD}=== TRACE SUMMARY ===${RST}\n"

    python3 - "$logfile" "$tp" <<'PYSUM'
import sys, collections

logfile = sys.argv[1]
proot_pid = sys.argv[2]

lines = []
for l in open(logfile):
    l = l.strip()
    if not l or l.startswith("#"): continue
    parts = l.split(",", 5)
    if len(parts) < 5: continue
    try:
        ts, lat, core, freq, n_pinned = parts[0], int(parts[1]), parts[2], int(parts[3]), int(parts[4])
        procs_raw = parts[5] if len(parts) > 5 else ""
        lines.append((ts, lat, core, freq, n_pinned, procs_raw))
    except: pass

if not lines:
    print("  (prázdný log)"); sys.exit(0)

lats = [l[1] for l in lines]
cores = collections.Counter(l[2] for l in lines)
freqs_by_core = collections.defaultdict(list)
for l in lines:
    freqs_by_core[l[2]].append(l[3])

print(f"\n  Syscall latence (os.stat, trasovaný prootem):")
print(f"    min={min(lats)}µs  max={max(lats)}µs  avg={sum(lats)//len(lats)}µs  median={sorted(lats)[len(lats)//2]}µs")
slow = sum(1 for l in lats if l > 300)
print(f"    vzorků: {len(lats)}  pomalých >300µs: {slow} ({100*slow//max(len(lats),1)}%)")

# trend: first vs last quarter
q = max(len(lats)//4, 1)
first_q = lats[:q]
last_q = lats[-q:]
avg_first = sum(first_q) // len(first_q)
avg_last = sum(last_q) // len(last_q)
if avg_last > avg_first * 1.5 and avg_last > 100:
    print(f"\n  \033[1;31mZPOMALENÍ v čase!\033[0m {avg_first}µs → {avg_last}µs ({100*(avg_last-avg_first)//max(avg_first,1)}% nárůst)")

# detect throttling
first_half = [l[3] for l in lines[:len(lines)//2]]
second_half = [l[3] for l in lines[len(lines)//2:]]
if first_half and second_half:
    avg1 = sum(first_half) // len(first_half)
    avg2 = sum(second_half) // len(second_half)
    if avg2 < avg1 * 0.85:
        print(f"\n  \033[1;31mTHROTTLING!\033[0m freq: {avg1}→{avg2} MHz ({100*(avg1-avg2)//avg1}% pokles)")
    elif avg2 < avg1 * 0.95:
        print(f"\n  \033[1;33mMírný throttling:\033[0m freq: {avg1}→{avg2} MHz ({100*(avg1-avg2)//avg1}% pokles)")

print(f"\n  Proot na jádrech: {dict(cores)}")
for c in sorted(freqs_by_core):
    fs = freqs_by_core[c]
    print(f"    jádro {c}: {min(fs)}-{max(fs)} MHz (avg {sum(fs)//len(fs)})")

# noise analysis: track CPU time DELTA per process across samples
proc_samples = collections.defaultdict(list)  # name -> [(sample_idx, cputime)]
for idx, l in enumerate(lines):
    if len(l) <= 5 or not l[5]: continue
    for tok in l[5].split():
        parts = tok.split(":")
        if len(parts) >= 3:
            name, pid, ticks = parts[0], parts[1], int(parts[2])
            proc_samples[f"{name}:{pid}"].append((idx, ticks))

print(f"\n  \033[1;33mCPU čas na pinovaném jádru\033[0m (delta za trace):")
deltas = []
for key, samples in proc_samples.items():
    if len(samples) >= 2:
        dt = samples[-1][1] - samples[0][1]
        name = key.split(":")[0]
        pid = key.split(":")[1]
        deltas.append((dt, name, pid, len(samples)))

deltas.sort(reverse=True)
total_delta = sum(d[0] for d in deltas) or 1
for dt, name, pid, cnt in deltas[:12]:
    pct = 100 * dt // total_delta
    bar = "█" * (pct // 3) + "░" * (10 - pct // 3)
    marker = ""
    if name in ("proot",): marker = " (tracer — OK)"
    elif dt > 0 and name not in ("sh", "zsh", "bash", "python3", "sleep", "nh", "cat"):
        if pct > 20:
            marker = f" ← \033[1;31mZABÍJÍ VÝKON\033[0m"
        elif pct > 5:
            marker = f" ← \033[1;33mšumí\033[0m"
    print(f"    {bar} {pct:3d}%  {dt:6d} ticks  {name:20s} pid:{pid} ({cnt}×){marker}")

# app process detection
app_delta = sum(dt for dt, name, pid, _ in deltas if "com.linux" in name or "linux_core" in name)
proot_delta = sum(dt for dt, name, pid, _ in deltas if name == "proot")
if app_delta > 0 and proot_delta > 0:
    ratio = app_delta * 100 // proot_delta
    if ratio > 50:
        print(f"\n  \033[1;31m⚠ APP PROCES žere {ratio}% CPU proot traceru na stejném jádru!\033[0m")
        print(f"    → Řešení: nh cpu isolate  (odstaví appku z proot jádra)")

# recommendation
avg_lat = sum(lats) // len(lats)
if avg_lat < 120:
    print(f"\n  \033[1;32m✓ Výkon OK\033[0m ({avg_lat}µs avg)")
elif avg_lat < 250:
    print(f"\n  \033[1;33m⚠ Mírně pomalé\033[0m ({avg_lat}µs avg)")
else:
    print(f"\n  \033[1;31m✗ Pomalé\033[0m ({avg_lat}µs avg)")

print(f"\n  Log: \033[1;36m{logfile}\033[0m")
PYSUM
}

cpu_isolate() {
    local tp mask all_mask avoid_mask
    tp=$(cpu_tracer)
    if [ -z "$tp" ] || [ "$tp" = "0" ]; then
        echo "  mimo proot, nelze"; return 1
    fi
    mask=$(cpu_getaff "$tp")
    all_mask=$(cpu_all_mask)
    avoid_mask=$(python3 -c "
m=int('$mask',16); a=int('$all_mask',16)
inv = a & ~m
print('%x' % inv if inv else '%x' % a)
" 2>/dev/null)
    printf "${WHITE}${BOLD}CPU ISOLATE${RST} — přesouvám šum z proot jádra\n"
    printf "  proot maska: 0x%s  zbytek: 0x%s\n\n" "$mask" "$avoid_mask"
    python3 - "$avoid_mask" "$tp" <<'PYEOF'
import os, sys

avoid = sys.argv[1]
proot_pid = sys.argv[2]
# host processes to move off proot core
noise_patterns = [
    "com.linux", "linux_core", "nethunter",
    "dropbear", "sshd", "ssh-agent",
    "busybox", "crond", "cron",
]
moved = 0
for d in os.listdir("/proc"):
    if not d.isdigit(): continue
    try:
        with open(f"/proc/{d}/comm") as f: comm = f.read().strip()
    except: continue
    if d == proot_pid: continue
    hit = any(p in comm for p in noise_patterns)
    if hit:
        if os.system(f"taskset -p {avoid} {d} >/dev/null 2>&1") == 0:
            print(f"  \033[1;32m✓\033[0m {comm} (pid {d}) → 0x{avoid}")
            moved += 1
        else:
            # fallback python
            try:
                m = int(avoid, 16)
                cores = [i for i in range(64) if m >> i & 1]
                os.sched_setaffinity(int(d), cores)
                print(f"  \033[1;32m✓\033[0m {comm} (pid {d}) → 0x{avoid}")
                moved += 1
            except: pass

if moved == 0:
    print("  žádné šumové procesy nenalezeny na proot jádru")
else:
    print(f"\n  přesunuto: {moved} procesů")
PYEOF
    echo ""
    printf "  Hotovo. Spusť ${CYAN}nh cpu trace${RST} pro ověření.\n"
}

cpu_dispatch() {
    case "${1:-status}" in
        status|st)      cpu_status ;;
        on)             shift; cpu_set on "$@" ;;
        off)            shift; cpu_set off "$@" ;;
        pin)            shift; cpu_live on "${1:-}" ;;
        unpin)          cpu_live off ;;
        all)            shift; cpu_exec_mask "$(cpu_all_mask)" "$@" ;;
        run)            shift; c=$1; shift; cpu_exec_mask "$(printf '%x' $((1 << c)))" "$@" ;;
        bench|benchmark) shift; cpu_bench "$@" ;;
        boost)          shift; cpu_boost "$@" ;;
        trace)          shift; cpu_trace "$@" ;;
        isolate)        cpu_isolate ;;
        help|--help|-h) help_cpu ;;
        *)              help_cpu; exit 1 ;;
    esac
}

