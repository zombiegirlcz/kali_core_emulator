# ─── USB Bridge (raw fd passthrough) ──────────────────────

usb_bridge() {
    local device="$1"
    local iface="${2:-0}"
    shift 2 2>/dev/null || true
    local uds_path="${USB_BRIDGE_SOCK:-/tmp/usb_bridge.sock}"

    if [ -z "$device" ] || [ $# -eq 0 ]; then
        echo "Usage: nh usb bridge <device> [iface] <cmd> [args...]"
        echo ""
        echo "  Bridge commands (direct USB ioctl via fd passthrough):"
        echo "    claim <iface>           Claim USB interface"
        echo "    release <iface>         Release USB interface"
        echo "    reset                    Reset USB device"
        echo "    bulk <ep> in <len> [ms]  Read from endpoint (raw bytes to stdout)"
        echo "    bulk <ep> out <hex> [ms] Write hex data to endpoint"
        echo "    control <bmReq> <bReq> <wVal> <wIdx> <wLen> [ms]  Control IN transfer"
        echo "    control-out <bmReq> <bReq> <wVal> <wIdx> <hex> [ms]  Control OUT transfer"
        echo ""
        echo "  Examples:"
        echo "    nh usb bridge /dev/bus/usb/001/002 claim 0"
        echo "    nh usb bridge /dev/bus/usb/001/002 bulk 0x81 in 4096 > dump.bin"
        echo "    nh usb bridge /dev/bus/usb/001/002 control 0x80 0x06 0x0100 0x0000 18"
        exit 1
    fi

    # First, trigger fd export via API (non-blocking — queues fd for next UDS client)
    local export_result
    export_result=$(api_post_json "/usb/export_fd" "{\"device_name\":\"$device\",\"interface_id\":$iface}" 2>/dev/null)

    # Check if the UDS socket exists (created by the app's UsbFdExporter)
    if [ ! -S "$uds_path" ]; then
        echo "ERROR: USB bridge socket not found: $uds_path"
        echo "  Make sure the NetHunter app is running and USB Host is active."
        exit 1
    fi

    # Run the bridge binary — it connects to UDS, receives USB fd, does ioctl
    exec usb_bridge "$uds_path" "$@"
}

# ─── USB GADGET (Magisk modul custom_usb_g2_setup) ─────────

usb_gadget() {
    if [ $# -eq 0 ]; then
        echo "Usage: nh usb gadget <command> [args...]"
        echo ""
        echo "  Spustí skript z Magisk modulu custom_usb_g2_setup na hostiteli"
        echo "  (real root, přes API /usbg2/exec)."
        echo ""
        echo "  Commands:"
        echo "    status            Stav gadgetů a UDC"
        echo "    g1 | g2           Přepnutí aktivního gadgetu (MTP+ADB ↔ HID+MS+RNDIS)"
        echo "    setup             Znovu vytvořit konfiguraci g2 v configfs"
        echo "    normal|brom|preloader  Režim g2 + setup"
        echo "    host | device     USB host (OTG) / gadget režim portu"
        echo "    detect            Výpis připojených USB zařízení"
        echo "    logs              Logy modulu"
        exit 1
    fi

    # JSON args pole (argy jsou jednoduchá slova)
    local ARGS="" a e
    for a in "$@"; do
        e=$(printf '%s' "$a" | sed 's/\\/\\\\/g; s/"/\\"/g')
        if [ -z "$ARGS" ]; then ARGS="\"$e\""; else ARGS="$ARGS,\"$e\""; fi
    done

    local resp
    resp=$(api_post_json "/usbg2/exec" "{\"args\":[$ARGS]}")
    if [ -z "$resp" ]; then
        echo "[-] LocalApiServer neodpovídá (${API_URL}/usbg2/exec)" >&2
        exit 1
    fi
    printf '%s' "$resp" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception as e:
    sys.stderr.write("[-] Neplatná odpověď API: %s\n" % e)
    sys.exit(1)
if "error" in d:
    sys.stderr.write("[-] %s\n" % d["error"])
    sys.exit(1)
out = d.get("output", "")
if out:
    print(out)
rc = d.get("rc", 1)
sys.exit(0 if d.get("ok") else (rc or 1))
'
}

# ─── ZKILL (host zombie cleanup) ──────────────────────────

zkill_dispatch() {
    # zkill je HOST nástroj (filesDir/usr/bin/zkill) — /shell API ho spustí na
    # hostiteli s app uid; zkill si sám eskaluje přes su (Magisk). Bez --root
    # je čistě bezpečný (systémové procesy a vlastní app se nikdy nezabíjí).
    ensure_token
    local cmd="zkill"
    [ $# -gt 0 ] && cmd="zkill $*"
    local resp
    resp=$(curl -s -X POST -H "Authorization: Bearer $TOKEN" --data "$cmd" "$API_URL/shell")
    if [ -z "$resp" ]; then
        echo "[-] LocalApiServer neodpovídá na ${API_URL}/shell" >&2
        exit 1
    fi
    printf '%s' "$resp" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
except Exception as e:
    sys.stderr.write('Chyba parsování odpovědi: %s\n' % e)
    sys.exit(1)
out = d.get('stdout',''); err = d.get('stderr','')
if out: sys.stdout.write(out)
if err: sys.stderr.write(err)
if not out and not err and 'error' in d:
    sys.stderr.write(d['error'] + '\n')
sys.exit(0 if d.get('exit_code', 0) == 0 else 1)
"
}

# ─── FLOAT (plovoucí terminál přes ostatní aplikace) ────────────

help_float() {
    banner
    echo ""
    echo "  ${WHITE}${BOLD}FLOAT${RST}  ${DIM}– plovoucí terminálové okno (overlay, Messenger-like)${RST}"
    separator
    echo "  ${GREEN}float${RST}             Nová session aktivního distro v plovoucím okně"
    echo "  ${GREEN}float here${RST}        Přesune AKTUÁLNÍ session do plovoucího okna"
    echo "  ${GREEN}float close${RST}       Zavře plovoucí okno (vypůjčená session se vrací)"
    echo ""
    echo "  ${YELLOW}Ovládání okna:${RST}"
    echo "    tažení za titulkovou lištu = přesun, roh ◢ = změna velikosti"
    echo "    ◐ = průhlednost (100/85/70/55/40 %), ▁ = minimalizovat do bubliny, ✕ = zavřít"
    echo "    bublina: tap = obnovit, dlouhý stisk = zavřít"
    echo ""
    echo "  ${DIM}Vyžaduje oprávnění 'Zobrazit přes ostatní aplikace' — při prvním"
    echo "  volání se otevře systémové nastavení.${RST}"
    echo ""
}

float_dispatch() {
    local mode="new" sid=""
    case "${1:-}" in
        here)
            sid="${NETHUNTER_SESSION_ID:-}"
            if [ -z "$sid" ]; then
                echo "[-] NETHUNTER_SESSION_ID není nastavené — spusť 'nh float here' uvnitř session" >&2
                exit 1
            fi
            mode="here" ;;
        close|stop)
            mode="close" ;;
        ""|new) mode="new" ;;
        help|-h|--help) help_float; exit 0 ;;
        *) echo "Usage: nh float [here|close|new]" >&2; exit 1 ;;
    esac
    ensure_token
    api_post_json "/terminal/float" "{\"mode\":\"$mode\",\"session_id\":\"$sid\"}" | fmt '
import sys, json
try:
    d = json.load(sys.stdin)
    st = d.get("status", "")
    if st == "overlay_permission_required":
        print("[!] Chybí oprávnění \u201eZobrazit přes ostatní aplikace\u201c.")
        print("    Otevřelo se systémové nastavení — povol ho a spusť nh float znovu.")
    elif st == "float_started":
        m = d.get("mode", "new")
        print(f"[+] Plovoucí terminál spuštěn (mode={m})")
    elif st == "float_closed":
        print("[+] Plovoucí terminál zavřen")
    elif "error" in d:
        sys.stderr.write("[-] " + d["error"] + chr(10))
        sys.exit(1)
    else:
        print(json.dumps(d))
except Exception as e:
    sys.stderr.write("Chyba: %s" % e + chr(10))
    sys.exit(1)
'
}

# ─── MAIN ──────────────────────────────────────────────────

# Check if invoked via compat symlink
case "$(basename "$0")" in
    nethunter-*|vpn-*|ignore-vpn|vpn-cli|nethunter-agent-cli)
        compat_dispatch "$0" "$@"
        exit $?
        ;;
esac

# Self-dispatch: "nethunter" and "nh" are the same
case "$(basename "$0")" in
    nethunter|nh) ;;
    *)
        # Also check if full path ends with nethunter or nh
        case "$0" in */nethunter|*/nh) ;; *)
            compat_dispatch "$0" "$@" && exit $?
        esac
        ;;
esac

# Normal dispatch
CMD="$1"
[ -z "$CMD" ] && { usage; exit 1; }
shift

case "$CMD" in
    system)     system_dispatch "$@" ;;
    network)    network_dispatch "$@" ;;
    vpn)        vpn_dispatch "$@" ;;
    agent)      agent_dispatch "$@" ;;
    log)        log_dispatch "$@" ;;
    device)     device_dispatch "$@" ;;
    api)        api_dispatch "$@" ;;
    desktop)    desktop_dispatch "$@" ;;
    fix)        fix_dispatch "$@" ;;
    apps)       apps_dispatch "$@" ;;
    usb)        usb_dispatch "$@" ;;
    distro)     distro_dispatch "$@" ;;
    zkill)      zkill_dispatch "$@" ;;
    float)      float_dispatch "$@" ;;
    ashell)     exec ashell ;;  # deleguje na standalone /usr/local/bin/ashell
    help|--help|-h) help_dispatch "$@" ;;
    list)       list_cmds ;;
    *)
        # Try compat as last resort
        compat_dispatch "nethunter-$CMD" "$@" 2>/dev/null && exit $?
        usage
        ;;
esac
