json.dump(data,open(f,'w'),indent=2)
print(f'[+] Configuration updated: {json.dumps(data,indent=2)}')
"
            ;;
        start)
            local pid_file="/tmp/nethunter_agent.pid"
            if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
                echo "[*] Agent daemon already running (PID: $(cat "$pid_file"))"
            else
                echo "[*] Starting Agent daemon..."
                nohup python3 /usr/local/bin/nethunter_agent.py > /tmp/nethunter_agent.log 2>&1 &
                echo $! > "$pid_file"
                sleep 1
                if kill -0 "$(cat "$pid_file")" 2>/dev/null; then
                    echo "[+] Agent daemon started (PID: $(cat "$pid_file"))"
                else
                    echo "[-] Daemon failed to start. Logs:"; cat /tmp/nethunter_agent.log
                fi
            fi
