apps_usage() {
    api_get "/apps/usage" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  {d[\"error\"]}{N}')
    elif 'apps' in d:
        from collections import defaultdict
        by_pkg=defaultdict(lambda: {'t':0,'n':''})
        for a in d['apps']:
            pkg=a.get('packageName','?').split('.')[-1]
            if not by_pkg[pkg]['n']: by_pkg[pkg]['n']=pkg
            by_pkg[pkg]['t']+=a.get('totalTimeInForeground',0)
        apps=sorted(by_pkg.values(), key=lambda x: -x['t'])
        apps=[a for a in apps if a['t']>60000][:10]
        print(f'{G}📊  App Usage Statistics (24h):{N}')
        for a in apps:
            pkg=a['n']; t=a['t']
            mins=t//60000; secs=(t//1000)%60
            print(f'   💠  {pkg}{Gy} - {mins}:{secs:02d} min{N}')
        if not apps: print(f'{Y}📊  No foreground app data{N}')
    else: print(f'{Y}📊  No app usage data{N}')
except Exception as e:
    print(f'{R}Parse error: {e}{N}')
"
}

