# ─── CPU (pin proot + guest na jedno jádro) ────────────────
# Každý syscall zachycený proot = ptrace výměna guest <-> proot. Na různých
# jádrech ~320 µs, na jednom velkém ~70-100 µs. Stav session sdílí s boot
# (cpu_pin_apply): $FILES_DIR/nh/cpu/pin.<proot pid> = maska, free.<pid> =
# PIDy, které hlídač nechá na všech jádrech (nh cpu all).

CPU_FILES_DIR="${FILES_DIR:-/data/user/0/com.linux_core/files}"
CPU_STATE_DIR="$CPU_FILES_DIR/nh/cpu"

cpu_tracer() { sed -n 's/^TracerPid:[[:space:]]*//p' /proc/$$/status 2>/dev/null; }

cpu_all_mask() {
    local m=0 c
    for c in /sys/devices/system/cpu/cpu[0-9]*; do
        [ "$(cat "$c/online" 2>/dev/null || echo 1)" = "1" ] && m=$(( m | (1 << ${c##*cpu}) ))
    done
    printf '%x' "$m"
}

cpu_fastest() {
    local best=0 core=0 c f
    for c in /sys/devices/system/cpu/cpu[0-9]*; do
        f=$(cat "$c/cpufreq/cpuinfo_max_freq" 2>/dev/null) || continue
        [ "$f" -ge "$best" ] && { best=$f; core=${c##*cpu}; }
    done
    echo "$core"
}

cpu_setaff() {  # <hexmask> <pid>
    if command -v taskset >/dev/null 2>&1; then
        taskset -p "$1" "$2" >/dev/null 2>&1
    else
        python3 -c "import os,sys; m=int(sys.argv[1],16); os.sched_setaffinity(int(sys.argv[2]), [i for i in range(64) if m>>i&1])" "$1" "$2" 2>/dev/null
    fi
}

cpu_getaff() {  # <pid> -> hex
    if command -v taskset >/dev/null 2>&1; then
        taskset -p "$1" 2>/dev/null | sed 's/.*: //'
    else
        python3 -c "import os,sys; print('%x' % sum(1<<c for c in os.sched_getaffinity(int(sys.argv[1]))))" "$1" 2>/dev/null
    fi
}

cpu_tree() {  # <pid> -> pid a všichni potomci
    local root=$1 all="" p pp line todo out
    for p in /proc/[0-9]*; do
        line=$(cat "$p/stat" 2>/dev/null) || continue
        line=${line##*) }
        set -- $line
        all="$all ${p#/proc/}:$2"
    done
    todo=$root out=""
    while [ -n "$todo" ]; do
        set -- $todo; p=$1; shift; todo="$*"
        out="$out $p"
        for pp in $all; do [ "${pp#*:}" = "$p" ] && todo="$todo ${pp%%:*}"; done
    done
    echo $out
}

cpu_all_list() {  # rozbalí $CPU_ALL stejně jako hlídač v boot
    local v w
    v=$(printf '%s' "$CPU_ALL" | sed 's/\$(cat[[:space:]]*\([^)]*\))/\1/g' | tr ',;' '  ')
    for w in $v; do
        case "$w" in "~/"*) w="$HOME/${w#??}" ;; esac
        case "$w" in
            /*) [ -f "$w" ] && tr ',;' '  ' < "$w" | tr -s ' \n' '\n\n' ;;
            *)  echo "$w" ;;
        esac
    done
}

cpu_distro() { echo "${1:-${NH_DISTRO:-parrot}}" | sed 's/^docker:.*/docker/'; }

cpu_status() {
    local tp mask c f cur max gov on
    printf "${WHITE}${BOLD}Jádra:${RST}\n"
    for c in /sys/devices/system/cpu/cpu[0-9]*; do
        on=$(cat "$c/online" 2>/dev/null || echo 1)
        cur=$(cat "$c/cpufreq/scaling_cur_freq" 2>/dev/null || echo 0)
        max=$(cat "$c/cpufreq/cpuinfo_max_freq" 2>/dev/null || echo 0)
        gov=$(cat "$c/cpufreq/scaling_governor" 2>/dev/null || echo "?")
        printf "  %-6s %5s/%-5s MHz  %-10s %s\n" "${c##*/}" $((cur / 1000)) $((max / 1000)) "$gov" \
            "$([ "$on" = 1 ] && echo online || echo offline)"
    done
    tp=$(cpu_tracer)
    echo ""
    printf "${WHITE}${BOLD}Tato session:${RST}\n"
    if [ -n "$tp" ] && [ "$tp" != "0" ]; then
        mask=$(cpu_getaff "$tp")
        printf "  proot pid %s  maska %s  (všechna jádra = %s)\n" "$tp" "$mask" "$(cpu_all_mask)"
        if [ "$mask" = "$(cpu_all_mask)" ]; then
            printf "  pin: ${YELLOW}vypnutý${RST}\n"
        else
            printf "  pin: ${GREEN}zapnutý${RST}%s\n" "$([ -f "$CPU_STATE_DIR/pin.$tp" ] && echo " (hlídač běží)")"
        fi
    else
        echo "  mimo proot (TracerPid 0)"
    fi
    echo ""
    printf "${WHITE}${BOLD}CPU_ALL (všechna jádra i při pinu):${RST}\n"
    if [ -n "${CPU_ALL:-}" ]; then
        printf "  CPU_ALL=%s\n  → %s\n" "$CPU_ALL" "$(cpu_all_list | tr '\n' ' ')"
    else
        echo "  nenastaveno (např. export CPU_ALL=\"make cargo john ~/cpu_all.txt\")"
    fi
    echo ""
    printf "${WHITE}${BOLD}Uloženo pro další boot:${RST}\n"
    api_get "/distro/cpupin" | fmt '
import sys, json
d = json.load(sys.stdin)
if not all(k in d for k in ("kali", "parrot", "docker")):
    sys.exit(1)
for k in ("kali", "parrot", "docker"):
    print("  %-7s %s" % (k, "ON (1 jádro)" if d.get(k) else "off"))
 ' || echo "  (API nedostupné nebo starší APK bez /distro/cpupin)"
    echo ""
    printf "${WHITE}${BOLD}Root CPU daemon (Magisk nh_cpuctl):${RST}\n"
    if [ -f "$CPU_STATE_DIR/cpuctld" ]; then
        local hb_pid hb_ts now_s hb_age
        read -r hb_pid hb_ts < "$CPU_STATE_DIR/cpuctld" 2>/dev/null || true
        now_s=$(date +%s)
        if [ -n "$hb_pid" ] && [ -n "$hb_ts" ]; then
            hb_age=$(( now_s - hb_ts ))
            if [ "$hb_age" -lt 15 ]; then
                printf "  ${GREEN}běží${RST} (pid %s, heartbeat %ss)\n" "$hb_pid" "$hb_age"
            else
                printf "  ${RED}neběží${RST} (starý heartbeat %ss)\n" "$hb_age"
            fi
        else
            printf "  ${RED}neběží${RST} (poškozený heartbeat)\n"
        fi
    else
        printf "  ${YELLOW}neinstallován${RST} (Magisk modul nh_cpuctl)\n"
    fi
}

cpu_live() {  # on|off — aplikuje na běžící session
    local tp mask t
    tp=$(cpu_tracer)
    [ -n "$tp" ] && [ "$tp" != "0" ] || { echo "  mimo proot, živě nelze"; return 0; }
    if [ "$1" = "on" ]; then
        mask=$(printf '%x' $((1 << ${2:-$(cpu_fastest)})))
        [ -d "$CPU_STATE_DIR" ] && echo "$mask" > "$CPU_STATE_DIR/pin.$tp" 2>/dev/null
    else
        mask=$(cpu_all_mask)
        rm -f "$CPU_STATE_DIR/pin.$tp" "$CPU_STATE_DIR/free.$tp" 2>/dev/null
    fi
    for t in $(cpu_tree "$tp"); do cpu_setaff "$mask" "$t"; done
    printf "  ${GREEN}✓${RST} běžící session (proot %s) → maska %s\n" "$tp" "$mask"
}

cpu_set() {  # on|off [distro] [--no-live]
    local state=$1 d live=1 a
    shift
    for a in "$@"; do case "$a" in --no-live) live=0 ;; *) d=$a ;; esac; done
    d=$(cpu_distro "$d")
    api_post_json "/distro/cpupin" "{\"distro\":\"$d\",\"enabled\":$([ "$state" = on ] && echo true || echo false)}" \
        | grep -q '"enabled"' \
        && printf "  ${GREEN}✓${RST} %s: CPU pin %s od dalšího bootu (ikona CPU na kartě)\n" "$d" "$state" \
        || echo "  [-] API nedostupné nebo starší APK — pro další boot neuloženo"
    if [ "$live" = 1 ]; then cpu_live "$state"; fi
}

cpu_exec_mask() {  # <hexmask> <cmd...> — exec se zachováním PID
    local mask=$1 tp
    shift
    [ $# -gt 0 ] || { echo "Použití: nh cpu all|run <cmd...>"; exit 1; }
    tp=$(cpu_tracer)
    # hlídač (boot) tenhle PID a jeho potomky nepřepne zpět na 1 jádro
    [ -n "$tp" ] && [ -d "$CPU_STATE_DIR" ] && echo $$ >> "$CPU_STATE_DIR/free.$tp" 2>/dev/null
    cpu_setaff "$mask" $$
    exec "$@"
}

cpu_bench() {
    command -v python3 >/dev/null 2>&1 || { echo "[-] nh cpu bench potřebuje python3"; exit 1; }
    local tp
    tp=$(cpu_tracer)
    [ -n "$tp" ] && [ "$tp" != "0" ] || { echo "[-] mimo proot (TracerPid 0) — není co měřit"; exit 1; }
    python3 - "$tp" "$@" <<'PYBENCH'
import os, sys, time, subprocess, statistics

tracer = int(sys.argv[1])
args = sys.argv[2:]
quick = "--quick" in args or "-q" in args
R, B, D = "\033[0m", "\033[1m", "\033[2m"
C = {"red": "\033[1;31m", "grn": "\033[1;32m", "yel": "\033[1;33m", "blu": "\033[1;34m",
     "mag": "\033[1;35m", "cya": "\033[1;36m", "wht": "\033[1;37m", "gry": "\033[0;90m"}

def online():
    cpus = []
    for n in sorted(os.listdir("/sys/devices/system/cpu")):
        if n.startswith("cpu") and n[3:].isdigit():
            try:
                on = open(f"/sys/devices/system/cpu/{n}/online").read().strip() == "1"
            except OSError:
                on = True
            if on:
                cpus.append(int(n[3:]))
    return cpus

def maxfreq(c):
    try:
        return int(open(f"/sys/devices/system/cpu/cpu{c}/cpufreq/cpuinfo_max_freq").read())
    except OSError:
        return 0

def tree(root):
    kids = {}
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            st = open(f"/proc/{p}/stat").read()
            ppid = int(st.rsplit(")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            continue
        kids.setdefault(ppid, []).append(int(p))
    out, todo = [], [root]
    while todo:
        p = todo.pop()
        out.append(p)
        todo += kids.get(p, [])
    return out

def setaff(pid, cpus):
    try:
        os.sched_setaffinity(pid, cpus)
        return True
    except OSError:
        return False

cpus = online()
freqs = {c: maxfreq(c) for c in cpus}
top = max(freqs.values())
big = [c for c in cpus if freqs[c] == top]
little = [c for c in cpus if freqs[c] == min(freqs.values())]
fast, slow = big[-1], little[0]
me = os.getpid()
orig_tracer = os.sched_getaffinity(tracer)
orig_me = os.sched_getaffinity(me)

combos = [
    ("bez pinu (všechna jádra)",       set(cpus),   set(cpus)),
    (f"proot cpu{fast}, guest volný",  {fast},      set(cpus)),
    (f"vše na cpu{fast} (big)",        {fast},      {fast}),
    (f"vše na big {'-'.join(map(str, big))}", set(big), set(big)),
    (f"proot cpu{big[0]}, guest cpu{fast}", {big[0]}, {fast}),
    (f"vše na cpu{slow} (little)",     {slow},      {slow}),
]
if len(big) < 2:
    combos = [c for c in combos if not c[0].startswith("vše na big") and "guest cpu" not in c[0]]

fd = os.open("/etc/hostname" if os.path.exists("/etc/hostname") else "/", os.O_RDONLY)
link = next((p for p in ("/usr/bin/python3", "/bin/sh", "/usr/bin/env") if os.path.exists(p)), "/")
true_bin = next((p for p in ("/bin/true", "/usr/bin/true") if os.path.exists(p)), None)
n_sys = 300 if quick else 1500
n_exec = 8 if quick else 25
reps = 2 if quick else 3

def t_loop(f, n):
    t = time.perf_counter()
    for _ in range(n):
        f()
    return (time.perf_counter() - t) / n * 1e6

tests = [
    ("fstat", "µs", lambda: t_loop(lambda: os.fstat(fd), n_sys)),
    ("stat symlink", "µs", lambda: t_loop(lambda: os.stat(link), n_sys)),
    ("open+close", "µs", lambda: t_loop(lambda: os.close(os.open(link, os.O_RDONLY)), n_sys)),
]
if true_bin:
    tests.append(("exec /bin/true", "ms",
                  lambda: t_loop(lambda: subprocess.run([true_bin]), n_exec) / 1000))

def bar(v, vmax, width, col):
    full = v / vmax * width if vmax else 0
    blocks = "▏▎▍▌▋▊▉█"
    n = int(full)
    frac = int((full - n) * 8)
    return col + "█" * n + (blocks[frac - 1] if frac else "") + R

print(f"\n{B}{C['mag']}⚡ nh cpu bench{R}  {D}proot pid {tracer} · jádra {cpus} · big {big} ({top//1000} MHz) · little {little} ({min(freqs.values())//1000} MHz){R}")
print(f"{D}Měří trasované syscally (ptrace výměna guest↔proot) pro různé přiřazení jader. "
      f"{'rychlý režim' if quick else 'plný režim (--quick = rychlejší)'}{R}\n")

results = []
try:
    for name, p_cpus, g_cpus in combos:
        setaff(tracer, p_cpus)
        setaff(me, g_cpus)
        time.sleep(0.2)
        row = []
        for tname, unit, fn in tests:
            fn()                                   # zahřátí (frekvence, cache)
            row.append(statistics.median(fn() for _ in range(reps)))
        results.append((name, row))
        sys.stdout.write(f"  {C['gry']}✓{R} {name}\n")
        sys.stdout.flush()
finally:
    for pid in tree(tracer):
        setaff(pid, orig_tracer)
    setaff(me, orig_me)

base = results[0][1]
print(f"\n{B}{C['wht']}{'kombinace':32s}" + "".join(f"{t[0]:>16s}" for t in tests) + f"{'zrychlení':>12s}{R}")
print(D + "─" * (32 + 16 * len(tests) + 12) + R)
scores = []
for name, row in results:
    sp = statistics.geometric_mean([b / v for b, v in zip(base, row) if v > 0])
    scores.append(sp)
for (name, row), sp in zip(results, scores):
    cells = ""
    for i, (v, (tname, unit, _)) in enumerate(zip(row, tests)):
        best = min(r[1][i] for r in results)
        worst = max(r[1][i] for r in results)
        col = C["grn"] if v == best else C["red"] if v == worst else C["yel"]
        cells += f"{col}{v:>11.1f} {unit:<3s}{R} "
    spc = C["grn"] if sp >= 1.5 else C["yel"] if sp >= 1.05 else C["red"] if sp < 0.95 else C["wht"]
    print(f"{name:32s}{cells}{spc}{sp:>9.2f}×{R}")

print(f"\n{B}{C['wht']}Zrychlení proti „bez pinu“ (geometrický průměr testů){R}")
smax = max(scores)
for (name, _), sp in zip(results, scores):
    col = C["grn"] if sp >= 1.5 else C["yel"] if sp >= 1.05 else C["red"] if sp < 0.95 else C["cya"]
    print(f"  {name:32s} {bar(sp, smax, 30, col)} {col}{sp:.2f}×{R}")

for i, (tname, unit, _) in enumerate(tests):
    vals = [r[1][i] for r in results]
    vmax = max(vals)
    print(f"\n{B}{C['wht']}{tname}{R} {D}({unit}, kratší = lepší){R}")
    for (name, row), v in zip(results, vals):
        col = C["grn"] if v == min(vals) else C["red"] if v == vmax else C["blu"]
        print(f"  {name:32s} {bar(v, vmax, 30, col)} {v:.1f}")

best_i = max(range(len(scores)), key=scores.__getitem__)
print(f"\n{B}Nejlepší:{R} {C['grn']}{results[best_i][0]}{R} ({scores[best_i]:.2f}× rychlejší než bez pinu)")
print(f"{D}Session vrácena na původní masku {sorted(orig_tracer)}. Zapnout trvale: nh cpu on · výpočty: nh cpu all <cmd>{R}\n")
PYBENCH
}

