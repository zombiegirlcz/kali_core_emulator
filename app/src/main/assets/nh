# ─── LOG ───────────────────────────────────────────────────

log_dispatch() {
    case "$1" in
        set) shift; log_set "$@" ;;
        help|-h|--help) help_log ;;
        *) log_view "$@" ;;
    esac
}

log_view() {
    local limit=500 grep_pattern="" filter_kb=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -n|--lines) limit="$2"; shift 2 ;;
            -g|--grep) grep_pattern="$2"; shift 2 ;;
            -K|--keyboard) filter_kb=1; shift ;;
            -h|--help) log_usage ;;
            *) limit="$1"; shift ;;
        esac
    done
    local url="/app/logs?limit=$limit&keyboard_only=$filter_kb"
    local body
    body=$(api_get "$url")
    if [ -z "$body" ]; then
        echo "[-] Cannot connect to LocalApiServer"
        exit 1
    fi
    echo "$body" | python3 -c "
import sys, re
RST, DIM, BOLD = '\033[0m', '\033[2m', '\033[1m'
RED, GREEN, YELLOW = '\033[1;31m', '\033[1;32m', '\033[1;33m'
BLUE, MAGENTA, CYAN = '\033[1;34m', '\033[1;35m', '\033[1;36m'
KEYBOARD_TAGS={'inputreader','inputdispatcher','inputmanager','keyboard','touchinjector'}
filter_kb=$filter_kb
LVL_COLORS = {'V': DIM, 'D': BLUE, 'I': GREEN, 'W': YELLOW, 'E': RED, 'F': BOLD + RED}
LOG_RE = re.compile(r'^(\d{2}-\d{2}\s\d{2}:\d{2}:\d{2}\.\d{3})\s+([VDIWEF])/([^(:\\s]+)\s*(?:\(\s*(\d+)\))?\s*:\s*(.*)$')
grep_pat = '$grep_pattern'.lower()
for line in sys.stdin:
    if grep_pat and grep_pat not in line.lower(): continue
    m = LOG_RE.match(line)
    if m:
        ts, lvl, tag, pid, msg = m.groups()
        tag_l = tag.lower()
        is_kb = any(t in tag_l for t in KEYBOARD_TAGS)
        if filter_kb and is_kb: continue
        lc = LVL_COLORS.get(lvl, RST)
        ps = f'({pid.strip()})' if pid else ''
        ml = msg.lower()
        if lvl in ('E','F') or 'denied' in ml or 'fail' in ml or 'error' in ml: msg = RED + msg + RST
        elif 'warn' in ml: msg = YELLOW + msg + RST
        elif 'success' in ml or 'established' in ml: msg = GREEN + msg + RST
        print(f'{DIM}{ts}{RST} {lc}{lvl}{RST} {MAGENTA}{tag}{CYAN}{ps}{RST}: {msg}')
    else: print(line)
"
}

log_set() {
    case "$1" in
        lvl)
            local level="${2:-3}"
            case "$level" in
                [1-5]) ;;
                *) echo "Usage: nh log set lvl 1-5 (1=Error, 2=Warn, 3=Info, 4=Debug, 5=Verbose)"
                    exit 1 ;;
            esac
            api_post "/app/logs/level" "$level" >/dev/null
            echo "Log level set to $level"
            ;;
        *) log_usage ;;
    esac
}

log_usage() {
    echo "Usage:"
    echo "  nh log [-n N] [-g P] [-K] [lines]  View logcat (colorized, -K = hide keyboard/touch)"
    echo "  nh log set lvl 1-5                  Set logging level (1=Error,5=Verbose)"
    exit 0
}

