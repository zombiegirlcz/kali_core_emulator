#!/bin/sh
# NetHunter Unified CLI — nh (alias: nethunter)
# Consolidated replacement for all nethunter-* and VPN shell scripts
# Talks to LocalApiServer on 127.0.0.1:1337
#
# Usage: nh <category> <action> [args...]
#        nethunter <category> <action> [args...]

API_HOST="${API_HOST:-127.0.0.1}"
API_PORT="${API_PORT:-1337}"
API_URL="http://${API_HOST}:${API_PORT}"

# ─── ANSI Colors ───────────────────────────────────────────
RST='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'
BLUE='\033[1;34m'; MAGENTA='\033[1;35m'; CYAN='\033[1;36m'; WHITE='\033[1;37m'
BG_RED='\033[41m'; BG_GREEN='\033[42m'; BG_BLUE='\033[44m'
GRAY='\033[0;90m'

# ─── Helpers ───────────────────────────────────────────────

get_token() {
    TOKEN=$(grep 'name="auth_token"' /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | \
        sed -n 's/.*<string name="auth_token">\([^<]*\)<\/string>.*/\1/p' | head -n 1)
    echo "$TOKEN"
}

TOKEN=""
ensure_token() {
    if [ -z "$TOKEN" ]; then
        TOKEN=$(get_token)
    fi
}

api_get() {
    ensure_token
    curl -s -H "Authorization: Bearer $TOKEN" "$API_URL$1"
}

api_post() {
    ensure_token
    curl -s -X POST -H "Authorization: Bearer $TOKEN" -d "$2" "$API_URL$1"
}

api_post_bin() {
    ensure_token
    echo "$2" | curl -s -X POST --data-binary @- -H "Authorization: Bearer $TOKEN" "$API_URL$1"
}

api_post_json() {
    ensure_token
    curl -s -X POST -H "Content-Type: application/json" -H "Authorization: Bearer $TOKEN" -d "$2" "$API_URL$1"
}

# Shortcut: pipe JSON through python3 formatter
# Usage: echo '{"key":"val"}' | fmt 'python code'
fmt() {
    python3 -c "$1" 2>/dev/null
}

# ─── UI Helpers ────────────────────────────────────────────

banner() {
    printf "${MAGENTA}${BOLD}"
    printf "╔══════════════════════════════════════════╗\n"
    printf "║   🛡️  NetHunter Unified CLI              ║\n"
    printf "╚══════════════════════════════════════════╝${RST}\n"
}

separator() {
    printf "${DIM}──────────────────────────────────────────────${RST}\n"
}

# ─── SYSTEM ────────────────────────────────────────────────

system_dispatch() {
    case "$1" in
        battery) system_battery ;;
        volume) shift; system_volume "$@" ;;
        torch) shift; system_torch "$@" ;;
        vibrate) shift; system_vibrate "$@" ;;
        toast) shift; system_toast "$@" ;;
        clipboard) shift; system_clipboard "$@" ;;
        notification) shift; system_notification "$@" ;;
        speech) system_speech ;;
        *) echo "Usage: nh system battery|volume|torch|vibrate|toast|clipboard|notification|speech"; exit 1 ;;
    esac
}

system_battery() {
    api_get "/battery" | fmt '
import sys, json
G,R,Y,N,Gy=chr(27)+"[92m",chr(27)+"[91m",chr(27)+"[93m",chr(27)+"[0m",chr(27)+"[90m"
try:
    d=json.load(sys.stdin)
    if "error" in d: print(d["error"]); sys.exit(0)
    pct=d.get("percentage",-1); st=d.get("status","?"); hl=d.get("health","?")
    temp=d.get("temperature",0); volt=d.get("voltage",0); pl=d.get("plugged","none")
    n=max(1,int(pct/10)) if pct>0 else 0; bar="█"*n+"░"*(10-n)
    c = G if st=="charging" else (G if pct>50 else (Y if pct>20 else R))
    ico = "🔌" if st=="charging" else "🔋"
    print(f"{c}{ico}  {pct}%  [{bar}]{N}")
    print(f"   Status:  {st}")
    print(f"   Health:  {hl}")
    print(f"   Teplota: {temp}°C")
    print(f"   Napětí:  {volt} mV")
    if pl!="none": print(f"   Nabíjení: {pl}")
except Exception as e: print(f"Chyba: {e}")
'
}

system_volume() {
    if [ -z "$1" ]; then
        api_get "/volume" | fmt '
import sys, json
G,R,Y,N=chr(27)+"[92m",chr(27)+"[91m",chr(27)+"[93m",chr(27)+"[0m"
try:
    d=json.load(sys.stdin)
    if "error" in d: print(d["error"]); sys.exit(0)
    cur=d.get("volume",0); mx=d.get("max_volume",15)
    n=max(1,int(cur/mx*10)) if mx>0 else 1; bar="█"*n+"░"*(10-n)
    print(f"{G}🔊  Hlasitost: {cur}/{mx}  [{bar}]{N}")
except: print("Chyba")
'
    else
        api_post "/volume" "$1" >/dev/null
        echo "${GREEN}✅ Hlasitost nastavena na $1${RST}"
    fi
}

system_torch() {
    local state="${1:-on}"
    api_post "/torch" "$state" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Flashlight: {d[\"error\"]}{N}')
    else:
        st = d.get('state', 'unknown')
        ico = '🔦' if st == 'on' else '🌙'
        c = G if st=='on' else Gy
        print(f'{c}{ico}  Flashlight: {st.upper()}{N}')
except: print(f'{Y}❓  Flashlight: unknown{N}')
"
}

system_vibrate() {
    local duration="${1:-500}"
    api_post "/vibrate" "$duration" | fmt "
import sys, json
G,R,Y,N=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Vibration failed: {d[\"error\"]}{N}')
    elif 'status' in d and d['status'] == 'no_vibrator': print(f'{Y}⚠  No vibrator hardware on this device{N}')
    else: print(f'{G}📳  Vibration: {d.get(\"duration\",\"$duration\")} ms{N}')
except Exception as e: print(f'{G}📳  Vibration sent ({e}){N}')
"
}

system_toast() {
    local text="$*"
    if [ -z "$text" ]; then
        if [ -p /dev/stdin ]; then text=$(cat); else echo "Usage: nh system toast <message>"; exit 1; fi
    fi
    api_post_bin "/toast" "$text" | fmt "
import sys, json
G,R,Y,N=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Toast failed: {d[\"error\"]}{N}')
    else: print(f'{G}✔  Toast sent to host engine{N}')
except: print(f'{G}✔  Toast sent to host engine{N}')
"
}

system_clipboard() {
    case "$1" in
        get)
            local raw_mode="$2"
            api_get "/clipboard" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
try:
    d=json.load(sys.stdin)
    if 'text' in d:
        txt = d['text']
        if '${raw_mode}' == '--raw': print(txt)
        else: print(f'{G}📋  Clipboard: {txt[:200]}{N}')
    else: print(f'{Y}📋  Clipboard: (empty){N}')
except: print(f'{R}✘  Error reading clipboard{N}')
" ;;
        set)
            shift
            local text="$*"
            if [ -z "$text" ]; then
                if [ -p /dev/stdin ]; then text=$(cat); else echo "Usage: nh system clipboard set <text>"; exit 1; fi
            fi
            api_post "/clipboard" "$text" | fmt "
import sys, json
G,R,Y,N=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Clipboard error: {d[\"error\"]}{N}')
    else: print(f'{G}📋  Clipboard: Text copied to host{N}')
except: print(f'{G}📋  Clipboard: Text copied to host{N}')
" ;;
        *)
            echo "Usage: nh system clipboard get|set [text]"
            exit 1 ;;
    esac
}

system_notification() {
    local title="NetHunter"
    local content=""
    while getopts "t:c:" opt; do
        case "$opt" in
            t) title="$OPTARG" ;;
            c) content="$OPTARG" ;;
        esac
    done
    shift $((OPTIND-1))
    if [ -z "$content" ]; then content="$*"; fi
    api_post_json "/notification" "{\"title\":\"$title\",\"content\":\"$content\"}" | fmt "
import sys, json
G,R,Y,N=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Notification failed: {d[\"error\"]}{N}')
    else: print(f'{G}🔔  Notification posted: {d.get(\"title\",\"\")}{N}')
except: print(f'{G}🔔  Notification posted to host{N}')
"
}

system_speech() {
    api_get "/voice_input" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
try:
    d=json.load(sys.stdin)
    if 'text' in d: print(f'{G}🎙️  Voice: {d[\"text\"]}{N}')
    else: print(f'{R}✘  {d.get(\"error\", \"No response\")}{N}')
except: print(f'{R}✘  Error parsing voice input{N}')
"
}

# ─── NETWORK ───────────────────────────────────────────────

network_dispatch() {
    case "$1" in
        wifi) shift; network_wifi "$@" ;;
        cell) network_cell ;;
        location) network_location ;;
        map) network_map ;;
        ifconfig) shift; network_ifconfig "$@" ;;
        *) echo "Usage: nh network wifi|cell|location|map|ifconfig"; exit 1 ;;
    esac
}

network_wifi() {
    local action="${1:-status}"
    if [ "$action" = "--help" ] || [ "$action" = "-h" ]; then
        echo "Usage: nh network wifi [on|off|scan|connect <ssid> [pass]|status]"
        return
    fi
    if [ "$action" = "connect" ]; then
        shift; local ssid="$*"
        [ -z "$ssid" ] && { echo "Usage: nh network wifi connect <ssid> [password]"; exit 1; }
        api_post "/wifi" "connect:$ssid" | fmt "
import sys, json
G,R,Y,N=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Wi-Fi: {d[\"error\"]}{N}')
    else: print(f'{G}📶  Connected to: {d.get(\"ssid\",\"\")}{N}')
except: print(f'{Y}📶  Wi-Fi connect: unknown{N}')
"
        return
    fi
    api_post "/wifi" "$action" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
def wifi_qual(rssi):
    if rssi is None: return ('N/A',0,chr(27)+'[0m')
    if rssi> -50: return ('Excelentní',10,chr(27)+'[92m')
    if rssi> -60: return ('Velmi dobrý',8,chr(27)+'[92m')
    if rssi> -70: return ('Dobrý',6,chr(27)+'[93m')
    if rssi> -80: return ('Střední',4,chr(27)+'[93m')
    if rssi> -90: return ('Slabý',2,chr(27)+'[91m')
    return ('Velmi slabý',1,chr(27)+'[91m')
def wifi_bar(nb): return '█'*nb + '░'*(10-nb)
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(d['error'])
    elif 'networks' in d:
        nets=d.get('networks',[])
        print(f'{G}📶  Nalezeno sítí: {len(nets)}{N}')
        for nw in nets:
            s=nw.get('ssid','?'); b=nw.get('bssid','?'); lv=nw.get('level',0); cap=nw.get('capabilities','')
            ql,nb,cl=wifi_qual(lv); bw=wifi_bar(nb)
            print(f'   {cl}{bw}{N} {s}  {Gy}({lv} dBm)  [{cap}]{N}')
    else:
        ssid=d.get('ssid','N/A'); bssid=d.get('bssid','N/A')
        rssi=d.get('rssi'); link=d.get('link_speed_mbps','?')
        if 'enabled' in d:
            en=d.get('enabled',False)
            print(f'{G if en else R}📶  Wi-Fi: {\"ENABLED\" if en else \"DISABLED\"}{N}')
        else:
            print(f'📡  SSID: {ssid}')
            print(f'🔗  BSSID: {bssid}')
            if rssi is not None:
                ql,nb,cl=wifi_qual(rssi)
                bw=wifi_bar(nb)
                print(f'{cl}📶  Signál: {rssi} dBm ({ql}){N}')
                print(f'   [{cl}{bw}{N}]')
            print(f'📶  Rychlost: {link} Mbps')
except Exception as e: print(f'{R}Chyba parsování: {e}{N}')
"
}

network_cell() {
    api_get "/cellinfo" | fmt "
import sys, json
def qual_dbm(dbm):
    if dbm is None or dbm <= -200: return ('Mimo dosah',0,'\033[0m')
    if dbm >  -75: return ('Excelentní',10,'\033[92m')
    if dbm >  -85: return ('Velmi dobrý',8,'\033[92m')
    if dbm >  -95: return ('Dobrý',6,'\033[93m')
    if dbm > -105: return ('Střední',4,'\033[93m')
    if dbm > -115: return ('Slabý',2,'\033[91m')
    return ('Velmi slabý',1,'\033[91m')
def bars(n): return '█'*n + '░'*(10-n)
try:
    d=json.load(sys.stdin)
    net=d.get('network_type','?'); carr=d.get('carrier','?')
    sim=d.get('sim_carrier','?'); data_st=d.get('data_state','?')
    roam=d.get('is_roaming',False); sig_dbm=d.get('signal_dbm')
    print(f'📶  {carr}  ({net})')
    print(f'📋  SIM: {sim}  |  Data: {data_st}  |  Roaming: {roam}')
    if d.get('signal_bar',''): print(f'{d[\"signal_bar\"]}')
    cells=d.get('cells',[])
    if not cells: print('\\nŽádné věže v dosahu.')
    else:
        for idx,c in enumerate(cells):
            print()
            reg=c.get('registered',False); stav='REGISTROVÁN' if reg else 'SOUSEDNÍ'
            print(f'Vysílač #{idx+1} [{stav}]')
            typ=c.get('type','N/A'); mcc=c.get('mcc','?'); mnc=c.get('mnc','?')
            print(f'Typ: {typ} | MCC: {mcc} | MNC: {mnc}')
            tac=c.get('tac_lac','N/A'); cid=c.get('cid','N/A'); pci=c.get('pci_psc')
            pci_txt=str(pci) if pci is not None else 'N/A'
            print(f'TAC/LAC: {tac} | CID: {cid} | PCI/PSC: {pci_txt}')
            sdbm=c.get('signal_dbm'); slev=c.get('signal_level',0)
            if sdbm is not None and sdbm > -200:
                w,n,c = qual_dbm(sdbm)
                print(f'{c}Síla signálu: {sdbm} dBm ({w})\033[0m')
                b=bars(n); print(f'Ukazatel: [{c}{b}\033[0m] ({c}{w}\033[0m)')
            else: print(f'Síla signálu: N/A')
            if idx < len(cells)-1: print('─'*50)
except Exception as e: print(f'Chyba: {e}')
"
}

