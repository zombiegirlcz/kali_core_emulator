# Materializuje PRoot link2symlink (.l2s) symlinky v .git na reálné soubory.
# PRoot `-L` převádí git hardlinky (pack/idx/rev i loose objekty) na symlinky
# do .l2s; když .l2s zmizí/vyčistí se, repa se rozbijí ("invalid object ...").
# Přístup přes host bind appky (/data/user/0/com.linux_core, starší /mnt/app),
# kde jsou symlinky skutečně vidět.
fix_git() {
    local repo="${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
    repo=$(readlink -f "$repo" 2>/dev/null || echo "$repo")
    [ -d "$repo/.git" ] || { echo "[-] '$repo' není git repo (.git nenalezen)" >&2; exit 1; }

    local host_repo="" app_dir
    for app_dir in /data/user/0/com.linux_core /mnt/app; do
        if [ -n "${NH_DISTRO:-}" ] && [ -d "$app_dir/files/nh/distro/$NH_DISTRO" ]; then
            host_repo="$app_dir/files/nh/distro/$NH_DISTRO$repo"
            break
        fi
    done
    if [ -z "$host_repo" ] || [ ! -d "$host_repo/.git" ]; then
        echo "[-] Nelze najít host pohled na repo (chybí bind App Data nebo NH_DISTRO)." >&2
        echo "    Zapni 'App Data' (Root Bridge) a spusť znovu." >&2
        exit 1
    fi

    echo "[*] Materializuji .git L2S symlinky: $repo"
    local pass
    for pass in 1 2 3; do
        find "$host_repo/.git" -type l 2>/dev/null | while read -r l; do
            local d b r d1 d2 dd
            d=$(dirname "$l"); b=$(basename "$l"); r=$(readlink "$l")
            d1="$d/$b.0001"
            d2="$d/$(basename "$r")"
            if [ -e "$d1" ] && [ ! -L "$d1" ]; then dd="$d1"
            elif [ -e "$d2" ] && [ ! -L "$d2" ]; then dd="$d2"
            else dd=""; fi
            [ -n "$dd" ] && { rm -f "$l" && cp "$dd" "$l"; }
        done
    done

    local left
    left=$(find "$host_repo/.git" -type l 2>/dev/null | wc -l)
    if [ "$left" = "0" ]; then
        echo "[+] Hotovo: všechny .git symlinky materializovány."
    else
        echo "[!] Zbývá $left symlinků (cíl chybí = objekt už ztracený)."
        echo "    Tip: repo znovu naklonuj a hned spusť 'nh fix git'."
    fi
}

fix_permission() {
    local path="$1"
    [ -z "$path" ] && { echo "Usage: nh fix permission <path>"; exit 1; }

    # Bind / host-mapped cesty se NIKDY neopravuji (guest rootfs je mimo).
    case "$path" in
        /|/dev/*|/proc/*|/sys/*|/run/*|/sdcard/*|/mnt/*|/system/*|/vendor/*|/product/*|/apex/*|/storage/*|/data/*)
            echo "[-] Odmítnuto: '$path' je bind/host mount nebo příliš široký cíl — fix běží jen v guest rootfs" >&2
            exit 126 ;;
    esac

    echo "[*] Oprava vlastnictví: $path -> uid aplikace (přes magisk daemon) ..."
    if [ -x /usr/local/bin/su_wrapper ]; then
        /usr/local/bin/su_wrapper --fix "$path"
        rc=$?
    else
        echo "[-] su_wrapper nenalezen — magisk daemon nedostupný" >&2
        exit 1
    fi
    if [ $rc -eq 0 ]; then
        echo "[+] Hotovo: $path"
    else
        echo "[-] Fix selhal (rc=$rc) — daemon běží? Zapněte Root Bridge v záložce Root Bridge (host root)." >&2
    fi
    exit $rc
}

fix_pkg() {
    local pkg="$1"
    [ -z "$pkg" ] && { echo "Usage: nh fix pkg <package-name>"; exit 1; }
    echo "[*] Mocking postinst for $pkg..."
    ln -sf /bin/true "/var/lib/dpkg/info/$pkg.postinst" 2>/dev/null || true
    echo "[*] Reconfiguring dpkg..."
    dpkg --configure -a
    echo "[+] Fixed postinst for $pkg!"
}

fix_auto() {
    echo "[*] Scanning for broken packages..."
    dpkg --configure -a 2>&1 || true
    # Find packages with failed postinst
    for info in /var/lib/dpkg/info/*.postinst; do
        [ -f "$info" ] || continue
        pkg=$(basename "$info" .postinst)
        if [ -x "$info" ] && ! "$info" configure 2>/dev/null; then
            echo "[*] Fixing $pkg..."
            ln -sf /bin/true "/var/lib/dpkg/info/$pkg.postinst" 2>/dev/null || true
        fi
    done
    dpkg --configure -a
    echo "[+] Auto-fix complete."
}

