# ─── MAIN ──────────────────────────────────────────────────

# Check if invoked via compat symlink
case "$(basename "$0")" in
    nethunter-*|vpn-*|ignore-vpn|vpn-cli|nethunter-agent-cli)
        compat_dispatch "$0" "$@"
        exit $?
        ;;
esac

# Self-dispatch: "nethunter" and "nh" are the same
case "$(basename "$0")" in
    nethunter|nh) ;;
    *)
        # Also check if full path ends with nethunter or nh
        case "$0" in */nethunter|*/nh) ;; *)
            compat_dispatch "$0" "$@" && exit $?
        esac
        ;;
esac

# Normal dispatch
CMD="$1"
[ -z "$CMD" ] && { help_dispatch; exit 1; }
shift

case "$CMD" in
    system|sys)             system_dispatch "$@" ;;
    network|net)            network_dispatch "$@" ;;
    vpn)                    vpn_dispatch "$@" ;;
    agent|ai)               agent_dispatch "$@" ;;
    log|logs)               log_dispatch "$@" ;;
    device|dev)             device_dispatch "$@" ;;
    api)                    api_dispatch "$@" ;;
    desktop|vnc)            desktop_dispatch "$@" ;;
    fix)                    fix_dispatch "$@" ;;
    apps)                   apps_dispatch "$@" ;;
    usb)                    usb_dispatch "$@" ;;
    distro)                 distro_dispatch "$@" ;;
    cpu)                    cpu_dispatch "$@" ;;
    zkill)                  zkill_dispatch "$@" ;;
    float)                  float_dispatch "$@" ;;
    ashell)                 exec ashell ;;  # deleguje na standalone /usr/local/bin/ashell
    docs|manual)            docs_open "$@" ;;
    stat)                   vpn_dispatch status "$@" ;;
    ps)                     distro_dispatch ps "$@" ;;
    ls)                     distro_dispatch list "$@" ;;
    help|--help|-h)         help_dispatch "$@" ;;
    list)                   list_cmds ;;
    *)
        # Try compat as last resort
        compat_dispatch "nethunter-$CMD" "$@" 2>/dev/null && exit $?
        help_dispatch
        ;;
esac
