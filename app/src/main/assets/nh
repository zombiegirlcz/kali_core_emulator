#!/bin/sh
# NetHunter Unified CLI — nh (alias: nethunter)
# Consolidated replacement for all nethunter-* and VPN shell scripts
# Talks to LocalApiServer on 127.0.0.1:1337
#
# Usage: nh <category> <action> [args...]
#        nethunter <category> <action> [args...]

API_HOST="${API_HOST:-127.0.0.1}"
API_PORT="${API_PORT:-1337}"
API_URL="http://${API_HOST}:${API_PORT}"

# ─── ANSI Colors ───────────────────────────────────────────
RST='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'
BLUE='\033[1;34m'; MAGENTA='\033[1;35m'; CYAN='\033[1;36m'; WHITE='\033[1;37m'
BG_RED='\033[41m'; BG_GREEN='\033[42m'; BG_BLUE='\033[44m'
GRAY='\033[0;90m'

# ─── Helpers ───────────────────────────────────────────────

get_token() {
    TOKEN=$(grep 'name="auth_token"' /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | \
        sed -n 's/.*<string name="auth_token">\([^<]*\)<\/string>.*/\1/p' | head -n 1)
    echo "$TOKEN"
}

TOKEN=""
ensure_token() {
    if [ -z "$TOKEN" ]; then
        TOKEN=$(get_token)
    fi
}

api_get() {
    ensure_token
    curl -s -H "Authorization: Bearer $TOKEN" "$API_URL$1"
}

api_post() {
    ensure_token
    curl -s -X POST -H "Authorization: Bearer $TOKEN" -d "$2" "$API_URL$1"
}

api_post_bin() {
    ensure_token
    echo "$2" | curl -s -X POST --data-binary @- -H "Authorization: Bearer $TOKEN" "$API_URL$1"
}

api_post_json() {
    ensure_token
    curl -s -X POST -H "Content-Type: application/json" -H "Authorization: Bearer $TOKEN" -d "$2" "$API_URL$1"
}

# Shortcut: pipe JSON through python3 formatter
# Usage: echo '{"key":"val"}' | fmt <python-code>
fmt() {
    python3 -c "$1" 2>/dev/null
}

# ─── UI Helpers ────────────────────────────────────────────

banner() {
    printf "${MAGENTA}${BOLD}"
    printf "╔══════════════════════════════════════════╗\n"
    printf "║   🛡️  NetHunter Unified CLI              ║\n"
    printf "╚══════════════════════════════════════════╝${RST}\n"
}

separator() {
    printf "${DIM}──────────────────────────────────────────────${RST}\n"
}

# ─── SYSTEM ────────────────────────────────────────────────

system_dispatch() {
    case "$1" in
        battery|bat) system_battery ;;
        volume|vol) shift; system_volume "$@" ;;
        torch) shift; system_torch "$@" ;;
        vibrate|vib) shift; system_vibrate "$@" ;;
        toast) shift; system_toast "$@" ;;
        clipboard|clip) shift; system_clipboard "$@" ;;
        notification|notif) shift; system_notification "$@" ;;
        speech|stt|tts-speak) system_speech ;;
        ashell) system_ashell ;;
        help|-h|--help) help_system ;;
        *) echo "Použití: nh system battery|volume|torch|vibrate|toast|clipboard|notification|speech|ashell"; echo "Pro nápovědu: nh system help"; exit 1 ;;
    esac
}

system_battery() {
    api_get "/battery" | fmt '
import sys, json
G,R,Y,N,Gy=chr(27)+"[92m",chr(27)+"[91m",chr(27)+"[93m",chr(27)+"[0m",chr(27)+"[90m"
try:
    d=json.load(sys.stdin)
    if "error" in d: print(d["error"]); sys.exit(0)
    pct=d.get("percentage",-1); st=d.get("status","?"); hl=d.get("health","?")
    temp=d.get("temperature",0); volt=d.get("voltage",0); pl=d.get("plugged","none")
    n=max(1,int(pct/10)) if pct>0 else 0; bar="█"*n+"░"*(10-n)
    c = G if st=="charging" else (G if pct>50 else (Y if pct>20 else R))
    ico = "🔌" if st=="charging" else "🔋"
    print(f"{c}{ico}  {pct}%  [{bar}]{N}")
    print(f"   Status:  {st}")
    print(f"   Health:  {hl}")
    print(f"   Teplota: {temp}°C")
    print(f"   Napětí:  {volt} mV")
    if pl!="none": print(f"   Nabíjení: {pl}")
except Exception as e: print(f"Chyba: {e}")
'
}

system_volume() {
    if [ -z "$1" ]; then
        api_get "/volume" | fmt '
import sys, json
G,R,Y,N=chr(27)+"[92m",chr(27)+"[91m",chr(27)+"[93m",chr(27)+"[0m"
try:
    d=json.load(sys.stdin)
    if "error" in d: print(d["error"]); sys.exit(0)
    cur=d.get("volume",0); mx=d.get("max_volume",15)
    n=max(1,int(cur/mx*10)) if mx>0 else 1; bar="█"*n+"░"*(10-n)
    print(f"{G}🔊  Hlasitost: {cur}/{mx}  [{bar}]{N}")
except: print("Chyba")
'
    else
        api_post "/volume" "$1" >/dev/null
        echo "${GREEN}✅ Hlasitost nastavena na $1${RST}"
    fi
}

system_torch() {
    local state="${1:-on}"
    api_post "/torch" "$state" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Flashlight: {d[\"error\"]}{N}')
    else:
        st = d.get('state', 'unknown')
        ico = '🔦' if st == 'on' else '🌙'
