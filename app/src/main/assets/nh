# ─── nh distro login: vstup do distro z host ashellu ────────────────────
# proot-distro-like: spustí univerzální boot skript (usr/bin/boot) přímo (sdílí stdin/stdout),
# takže se z ashellu (host shell) dostaneme do PRoot kontejneru. Extra bindy
# se předávají boot skriptu přes NH_EXTRA_BINDS env.
distro_login() {
    [ $# -lt 1 ] && { echo "[-] Usage: nh distro login <distro> [--bind src:dst ...]" >&2; exit 1; }
    local DISTRO="$1"; shift
    local EXTRA_BINDS=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bind|-b)
                [ $# -lt 2 ] && { echo "[-] --bind vyžaduje argument src:dst" >&2; exit 1; }
                EXTRA_BINDS="$EXTRA_BINDS -b $2"
                shift 2 ;;
            -h|--help)
                echo "Usage: nh distro login <distro> [--bind src:dst ...]"
                echo "  --bind src:dst   host cesta -> guest cesta (absolutní, vícekrát)"
                exit 0 ;;
            *)
                echo "[-] Neznámý argument: $1" >&2; exit 1 ;;
        esac
    done

    # Rootfs adresář: přesná shoda, jinak hledej prefix (kali → kali-arm64, ...).
    # Nyní robustní i proti prázdnému/neexpandovanému globu a překrývání
    # DISTRO_LAUNCHER podle skutečně nalezené složky.
    local FILES_DIR="/data/user/0/com.linux_core/files"
    local ROOTFS="$FILES_DIR/nh/distro/$DISTRO"
    local BOOT_SCRIPT="$FILES_DIR/usr/bin/boot"
    if [ ! -d "$ROOTFS" ]; then
        # Zkus legacy cesty: $FILES_DIR/$DISTRO nebo $FILES_DIR/$DISTRO-*
        ROOTFS="$FILES_DIR/$DISTRO"
        if [ ! -d "$ROOTFS" ]; then
            # explicitní iterace s fallbackem, pokud glob neexpanduje
            local cand=""
            local found_dir=""
            for cand in "$FILES_DIR"/*; do
                [ -e "$cand" ] || continue
                [ -d "$cand" ] || continue
                case "$(basename "$cand")" in
                    "$DISTRO"-*)
                        found_dir="$cand"
                        ROOTFS="$cand"
                        break
                        ;;
                esac
            done
            if [ -z "$found_dir" ]; then
                echo "[-] Distro '$DISTRO' nenalezeno v $FILES_DIR" >&2
                echo "    Dostupná: $(ls -d "$FILES_DIR"/* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')" >&2
                exit 1
            fi
        fi
    fi
    if [ ! -d "$ROOTFS" ]; then
        echo "[-] Distro '$DISTRO' nenalezeno v $FILES_DIR" >&2
        echo "    Dostupná: $(ls -d "$FILES_DIR"/* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')" >&2
        exit 1
    fi

    # Boot script: univerzální launcher (usr/bin/boot)
    if [ ! -x "$BOOT_SCRIPT" ]; then
        echo "[-] Boot script nenalezen (žádný kontejner ještě neběžel?) — otevři terminál se "$DISTRO" v aplikaci a zkus znovu" >&2
        exit 1
    fi

    # Zajisti, že extra bind cesty existují (proot na to nebude stěžovat)
    for b in $EXTRA_BINDS; do
        [ "$b" = "-b" ] && continue
        local src="${b%%:*}"
        if [ "$src" != "$b" ] && [ ! -e "$src" ]; then
            echo "[!] Varování: bind zdroj '$src' neexistuje — proot ho vytvoří jako prázdný" >&2
        fi
    done

    echo "[*] Vstup do $DISTRO (rootfs=$ROOTFS)"
    [ -n "$EXTRA_BINDS" ] && echo "[*] Extra bindy: $EXTRA_BINDS"
    echo "[*] Ukončení: exit / Ctrl+D"
    echo ""
    # Handle docker/imagename format for boot script
    case "$DISTRO" in
        docker/*)
            local IMAGE_NAME="${DISTRO#docker/}"
            NH_EXTRA_BINDS="$EXTRA_BINDS" exec "$BOOT_SCRIPT" docker "$IMAGE_NAME"
            ;;
        *)
            NH_EXTRA_BINDS="$EXTRA_BINDS" exec "$BOOT_SCRIPT" "$DISTRO"
            ;;
    esac
}

usb_list() {
    api_get "/usb/devices" | fmt '
import sys, json
try:
    data = json.load(sys.stdin)
    if isinstance(data, list) and len(data) == 0:
        print("No USB devices connected")
    elif isinstance(data, list):
        for d in data:
            name = d.get("device_name","?")
            vid = d.get("vendor_id",0)
            pid = d.get("product_id",0)
            mfg = d.get("manufacturer_name") or ""
            prod = d.get("product_name") or ""
            perm = "\u2713" if d.get("has_permission") else "\u2717"
            print(f"  {name}")
            print(f"    VID:PID  {vid:04x}:{pid:04x}")
            print(f"    Vendor:  {mfg}")
            print(f"    Product: {prod}")
            print(f"    Perm:    {perm}")
            ifaces = d.get("interfaces",[])
            for iface in ifaces:
                cls = iface.get("class",0)
                sub = iface.get("subclass",0)
                proto = iface.get("protocol",0)
                eps = iface.get("endpoints",[])
                ep_str = " ".join([f"ep{e.get(\"address\",\"?\")}:{e.get(\"direction\",\"?\")}:{e.get(\"type\",\"?\")}" for e in eps])
                print(f"    Iface {iface.get(\"id\",0)}: class={cls} sub={sub} proto={proto}  {ep_str}")
    else:
        print(f"Error: {data.get(\"error\",\"Unknown\")}")
except Exception as e:
    print(f"Parse error: {e}")
'
}

