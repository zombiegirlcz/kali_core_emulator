d=json.load(sys.stdin)
print(d.get('running',False))
" 2>/dev/null)
    PACKETS=$(echo "$BODY" | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(d.get('packets',0))
" 2>/dev/null)
    BYTES=$(echo "$BODY" | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(d.get('bytes','0'))
" 2>/dev/null)
    if [ "$RUNNING" = "True" ] || [ "$RUNNING" = "true" ]; then
        printf "  ${BOLD}VPN Status:${RST}  ${BG_GREEN}${WHITE}${BOLD} RUNNING ${RST}\n"
    else
        printf "  ${BOLD}VPN Status:${RST}  ${BG_RED}${WHITE}${BOLD} STOPPED ${RST}\n"
    fi
    VPN_IP=$(echo "$BODY" | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(d.get('vpn_ip','N/A'))
" 2>/dev/null)
    printf "  ${BOLD}TUN IP:${RST}      ${CYAN}${VPN_IP}${RST}\n"
    printf "  ${BOLD}Packets:${RST}     ${CYAN}${PACKETS}${RST}\n"
