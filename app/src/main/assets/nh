    [ -z "$device" ] && { echo "Usage: nh usb send <device_name> <file>"; exit 1; }
    if [ ! -f "$file" ]; then
        echo "File not found: $file"
        exit 1
    fi
    local b64=$(base64 -w0 < "$file" 2>/dev/null || cat "$file" | openssl base64 -A 2>/dev/null)
    api_post_json "/usb/send" "{\"device_name\":\"$device\",\"data_base64\":\"$b64\"}" | fmt '
import sys, json
try:
    d=json.load(sys.stdin)
    if d.get("success"):
        sent=d.get("total_transferred",0)
        req=d.get("total_requested",0)
        print(f"\u2713 Sent {sent}/{req} bytes")
    else:
        print(f"\u2717 {d.get(\"error\",\"Unknown error\")}")
except Exception as e:
    print(f"Parse error: {e}")
'
}

usb_bulk() {
    local device="$1"
    local ep="$2"
    local file="$3"
