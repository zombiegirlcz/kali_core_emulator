# ─── ASHELL (escape proot → host app user shell) ─────────

ashell() {
    # Spustí interaktivní shell v kontextu Android aplikace (mimo PRoot).
    # Použití: ashell
    # Běžně: ashell  → otevře novou TerminalActivity s /system/bin/sh
    #                        a HOME = /data/data/com.linux_core/files
    banner
    printf "${CYAN}${BOLD}  ⬡  ASHELL  –  ESCAPE TO HOST APP SHELL${RST}\n"
    printf "${DIM}  ─────────────────────────────────────────────────${RST}\n"
    printf "${WHITE}   Přepne tě z PRootu (root@kali) do kontextu${RST}\n"
    printf "${WHITE}   aplikace (uid=%s, HOME=%s)${RST}\n" \
        "$(id -u 2>/dev/null || echo '?')" \
        "/data/data/com.linux_core/files"
    printf "${DIM}  ─────────────────────────────────────────────────${RST}\n"
    api_post "/ashell" "open" | fmt "
import sys, json
G,R,Y,N,C=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[96m'
try:
    d=json.load(sys.stdin)
    if 'error' in d:
        print(f'{R}✘  ashell failed: {d[\"error\"]}{N}')
        sys.exit(1)
    print(f'{C}⬡  uid={d.get(\"uid\",\"?\")}  pwd={d.get(\"pwd\",\"?\")}{N}')
    print(f'{G}✔  Host shell otevřen v novém okně.{N}')
    print(f'{G}   Návrat zpět do prootu: zavři okno nebo exit.{N}')
except Exception as e:
    print(f'{R}✘  ashell parse error: {e}{N}')
"
}

# ─── COMPAT DISPATCH (for symlinked old names) ────────────

compat_dispatch() {
    local invoked="$1"
    shift
    local name
    name=$(basename "$invoked")
    case "$name" in
        nethunter-battery-status)       exec "$0" system battery "$@" ;;
        nethunter-toast)                exec "$0" system toast "$@" ;;
        nethunter-vibrate)              exec "$0" system vibrate "$@" ;;
        nethunter-tts-speak)            exec "$0" system tts-speak "$@" ;;
        nethunter-clipboard-get)        exec "$0" system clipboard get "$@" ;;
        nethunter-clipboard-set)        exec "$0" system clipboard set "$@" ;;
        nethunter-notification)         exec "$0" system notification "$@" ;;
        nethunter-wifi-connectioninfo)  exec "$0" network wifi status "$@" ;;
        nethunter-wifi-control)         exec "$0" network wifi "$@" ;;
        nethunter-cellinfo)             exec "$0" network cell "$@" ;;
        nethunter-location)             exec "$0" network location "$@" ;;
        nethunter-map)                  exec "$0" network map "$@" ;;
        nethunter-terminalmap)          exec "$0" network map "$@" ;;
        nethunter-battery-optimize)     exec "$0" device battery-optimize "$@" ;;
        nethunter-device-admin)         exec "$0" device admin "$@" ;;
        nethunter-volume)               exec "$0" system volume "$@" ;;
        nethunter-torch)                exec "$0" system torch "$@" ;;
        nethunter-log)                  exec "$0" log "$@" ;;
        nethunter-speech-input)         exec "$0" system speech "$@" ;;
        nethunter-notifications-active) exec "$0" device notifications "$@" ;;
        nethunter-apps-usage)           exec "$0" apps usage "$@" ;;
        nethunter-accessibility-hierarchy) exec "$0" device accessibility "$@" ;;
        nethunter-fix-postinst)         exec "$0" fix pkg "$@" ;;
        nethunter-desktop)              exec "$0" desktop "$@" ;;
        nethunter-api)                  exec "$0" api share "$@" ;;
        nethunter-usb-list)             exec "$0" usb list "$@" ;;
