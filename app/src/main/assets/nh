network_map() {
    echo "[*] Fetching current location..."
    api_get "/map" | fmt "
import sys, json
try:
    d=json.load(sys.stdin)
    if d.get('success'):
        print(f'📍 Location: {d[\"latitude\"]}, {d[\"longitude\"]}')
        print('🗺️  Starting TerminalMap...')
    else: print(d.get('error','Unknown error'))
