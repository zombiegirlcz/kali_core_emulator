}

system_ashell() {
    # Deleguje na samostatný /usr/local/bin/ashell skript
    if command -v ashell >/dev/null 2>&1; then
        exec ashell
    else
        echo "[-] ashell script not found in PATH" >&2
        echo "    Zkuste: /usr/local/bin/ashell" >&2
        exit 1
    fi
}

# ─── NETWORK ───────────────────────────────────────────────

network_dispatch() {
    case "$1" in
        wifi) shift; network_wifi "$@" ;;
        cell) network_cell ;;
        location|loc|gps) network_location ;;
        map) network_map ;;
        ifconfig|if) shift; network_ifconfig "$@" ;;
        help|-h|--help) help_network ;;
        *) echo "Použití: nh network wifi|cell|location|map|ifconfig"; echo "Pro nápovědu: nh network help"; exit 1 ;;
    esac
}

network_wifi() {
    local action="${1:-status}"
    if [ "$action" = "--help" ] || [ "$action" = "-h" ]; then
        echo "Usage: nh network wifi [on|off|scan|connect <ssid> [pass]|status]"
        return
    fi
    if [ "$action" = "connect" ]; then
        shift; local ssid="$*"
        [ -z "$ssid" ] && { echo "Usage: nh network wifi connect <ssid> [password]"; exit 1; }
        api_post "/wifi" "connect:$ssid" | fmt "
import sys, json
G,R,Y,N=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  Wi-Fi: {d[\"error\"]}{N}')
    else: print(f'{G}📶  Connected to: {d.get(\"ssid\",\"\")}{N}')
except: print(f'{Y}📶  Wi-Fi connect: unknown{N}')
"
        return
    fi
    api_post "/wifi" "$action" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
def wifi_qual(rssi):
    if rssi is None: return ('N/A',0,chr(27)+'[0m')
    if rssi> -50: return ('Excelentní',10,chr(27)+'[92m')
    if rssi> -60: return ('Velmi dobrý',8,chr(27)+'[92m')
    if rssi> -70: return ('Dobrý',6,chr(27)+'[93m')
    if rssi> -80: return ('Střední',4,chr(27)+'[93m')
    if rssi> -90: return ('Slabý',2,chr(27)+'[91m')
    return ('Velmi slabý',1,chr(27)+'[91m')
def wifi_bar(nb): return '█'*nb + '░'*(10-nb)
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(d['error'])
    elif 'networks' in d:
        nets=d.get('networks',[])
        print(f'{G}📶  Nalezeno sítí: {len(nets)}{N}')
        for nw in nets:
            s=nw.get('ssid','?'); b=nw.get('bssid','?'); lv=nw.get('level',0); cap=nw.get('capabilities','')
            ql,nb,cl=wifi_qual(lv); bw=wifi_bar(nb)
            print(f'   {cl}{bw}{N} {s}  {Gy}({lv} dBm)  [{cap}]{N}')
    else:
        ssid=d.get('ssid','N/A'); bssid=d.get('bssid','N/A')
        rssi=d.get('rssi'); link=d.get('link_speed_mbps','?')
        if 'enabled' in d:
            en=d.get('enabled',False)
            print(f'{G if en else R}📶  Wi-Fi: {\"ENABLED\" if en else \"DISABLED\"}{N}')
        else:
            print(f'📡  SSID: {ssid}')
            print(f'🔗  BSSID: {bssid}')
            if rssi is not None:
                ql,nb,cl=wifi_qual(rssi)
                bw=wifi_bar(nb)
                print(f'{cl}📶  Signál: {rssi} dBm ({ql}){N}')
                print(f'   [{cl}{bw}{N}]')
            print(f'📶  Rychlost: {link} Mbps')
except Exception as e: print(f'{R}Chyba parsování: {e}{N}')
"
}

network_cell() {
    api_get "/cellinfo" | fmt "
import sys, json
def qual_dbm(dbm):
    if dbm is None or dbm <= -200: return ('Mimo dosah',0,'\033[0m')
    if dbm >  -75: return ('Excelentní',10,'\033[92m')
    if dbm >  -85: return ('Velmi dobrý',8,'\033[92m')
    if dbm >  -95: return ('Dobrý',6,'\033[93m')
    if dbm > -105: return ('Střední',4,'\033[93m')
    if dbm > -115: return ('Slabý',2,'\033[91m')
    return ('Velmi slabý',1,'\033[91m')
def bars(n): return '█'*n + '░'*(10-n)
try:
    d=json.load(sys.stdin)
    net=d.get('network_type','?'); carr=d.get('carrier','?')
    sim=d.get('sim_carrier','?'); data_st=d.get('data_state','?')
    roam=d.get('is_roaming',False); sig_dbm=d.get('signal_dbm')
    print(f'📶  {carr}  ({net})')
    print(f'📋  SIM: {sim}  |  Data: {data_st}  |  Roaming: {roam}')
    if d.get('signal_bar',''): print(f'{d[\"signal_bar\"]}')
    cells=d.get('cells',[])
    if not cells: print('\\nŽádné věže v dosahu.')
    else:
        for idx,c in enumerate(cells):
            print()
            reg=c.get('registered',False); stav='REGISTROVÁN' if reg else 'SOUSEDNÍ'
            print(f'Vysílač #{idx+1} [{stav}]')
            typ=c.get('type','N/A'); mcc=c.get('mcc','?'); mnc=c.get('mnc','?')
            print(f'Typ: {typ} | MCC: {mcc} | MNC: {mnc}')
            tac=c.get('tac_lac','N/A'); cid=c.get('cid','N/A'); pci=c.get('pci_psc')
            pci_txt=str(pci) if pci is not None else 'N/A'
            print(f'TAC/LAC: {tac} | CID: {cid} | PCI/PSC: {pci_txt}')
            sdbm=c.get('signal_dbm'); slev=c.get('signal_level',0)
            if sdbm is not None and sdbm > -200:
                w,n,c = qual_dbm(sdbm)
                print(f'{c}Síla signálu: {sdbm} dBm ({w})\033[0m')
                b=bars(n); print(f'Ukazatel: [{c}{b}\033[0m] ({c}{w}\033[0m)')
            else: print(f'Síla signálu: N/A')
            if idx < len(cells)-1: print('─'*50)
except Exception as e: print(f'Chyba: {e}')
"
}

