            mkdir -p "$config_dir"
            if [ ! -f "$config_dir/agent.json" ]; then
                echo '{"provider":"gemini","key":"","model":"gemini-2.0-flash"}' > "$config_dir/agent.json"
            fi
            python3 -c "
import json, os
f='$config_dir/agent.json'
data=json.load(open(f))
if '$provider': data['provider']='$provider'
if '$key': data['key']='$key'
if '$model': data['model']='$model'
elif '$provider':
    m={'gemini':'gemini-2.0-flash','openai':'gpt-4o-mini','anthropic':'claude-3-5-sonnet-20240620','ollama':'llama3'}
