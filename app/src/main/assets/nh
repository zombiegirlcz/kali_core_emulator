network_ifconfig() {
    local iface="$1"
    if [ -n "$iface" ]; then
        local cmd="ip addr show $iface"
        api_post "/shell" "$cmd" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
BOLD=chr(27)+'[1m'; DIM=chr(27)+'[2m'
try:
    d=json.load(sys.stdin)
    if 'stdout' in d:
        for line in d['stdout'].split(chr(10)):
            if 'inet ' in line or 'inet6 ' in line:
                print(f'{G}  {line.strip()}{N}')
            elif line.strip().startswith('mtu') or 'link/' in line:
                print(f'{Gy}  {line.strip()}{N}')
            elif line.strip().endswith(':'):
                print(f'{Y}{BOLD}  {line.strip()}{N}')
            else: print(f'{DIM}  {line}{N}')
    elif 'error' in d: print(f'{R}Error: {d[\"error\"]}{N}')
    else: print(d)
except Exception as e:
    print(f'{R}Error: {e}{N}')
"
        return
    fi

    local wifi vpn
    # RAW JSON z API (ne `nh network wifi`, který vrací text s emoji a nejde parsovat)
    wifi=$(api_get "/wifi" 2>/dev/null)
    vpn=$(api_get "/vpn" 2>/dev/null)
    printf "${YELLOW}${BOLD}=== Custom NetHunter Net-Bridge ===${RST}\n\n"
    if [ -n "$wifi" ]; then
        local ip mac ssid netmask gw
        ip=$(echo "$wifi" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('ip',''))" 2>/dev/null)
        mac=$(echo "$wifi" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('mac',''))" 2>/dev/null)
        ssid=$(echo "$wifi" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('ssid',''))" 2>/dev/null)
        netmask=$(echo "$wifi" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('netmask','255.255.255.0'))" 2>/dev/null)
        gw=$(echo "$wifi" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('gateway',''))" 2>/dev/null)
        printf "${CYAN}wlan0${RST}: flags=4163<UP,BROADCAST,RUNNING,MULTICAST>  mtu 1500\n"
        printf "        inet ${GREEN}%s${RST}  netmask %s\n" "${ip:-N/A}" "${netmask:-255.255.255.0}"
        printf "        ether ${DIM}%s${RST}  txqueuelen 3000  (Wi-Fi Network: ${YELLOW}%s${RST})\n" "${mac:-N/A}" "${ssid:-N/A}"
        if [ -n "$gw" ]; then
            printf "        default via ${GREEN}%s${RST}\n" "$gw"
        fi
        printf "\n"
    fi
    if [ -n "$vpn" ]; then
        local vpn_status vpn_ip
        vpn_status=$(echo "$vpn" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('running',False))" 2>/dev/null)
        vpn_ip=$(echo "$vpn" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('vpn_ip',''))" 2>/dev/null)
        # tun0 zobrazit i když VPN je jen nakonfigurovaná (STOPPED) — vrací IP konfiguraci
        if [ "$vpn_status" = "True" ] || [ "$vpn_status" = "true" ]; then
            printf "${CYAN}tun0${RST}: flags=4305<UP,POINTOPOINT,RUNNING,NOARP,MULTICAST>  mtu 1500\n"
            printf "        inet ${GREEN}%s${RST}  netmask 255.255.255.0\n" "${vpn_ip:-N/A}"
            printf "        status: ${GREEN}RUNNING${RST}\n"
            printf "        options: AdGuard VPN Firewall Active\n"
        elif [ -n "$vpn_ip" ]; then
            printf "${CYAN}tun0${RST}: flags=4243<UP,POINTOPOINT,NOARP,MULTICAST>  mtu 1500\n"
            printf "        inet ${GREEN}%s${RST}  netmask 255.255.255.0\n" "${vpn_ip:-N/A}"
            printf "        status: ${RED}STOPPED${RST}\n"
            printf "        options: VPN nakonfigurována, ale neběží (nh vpn start)\n"
        fi
        printf "\n"
    fi
}

# ─── VPN ───────────────────────────────────────────────────

vpn_dispatch() {
    case "$1" in
        status) vpn_status ;;
        start) vpn_start ;;
        stop) vpn_stop ;;
        on) shift; vpn_on "$@" ;;
        off) shift; vpn_off "$@" ;;
        logs) shift; vpn_logs "$@" ;;
        ai) shift; vpn_ai "$@" ;;
        mitm) shift; vpn_mitm "$@" ;;
        bypass) shift; vpn_bypass "$@" ;;
        ignore) shift; vpn_ignore "$@" ;;
        sni-fallback) shift; vpn_sni_fallback "$@" ;;
        *) echo "Usage: nh vpn status|start|stop|on|off|logs|mitm|bypass|ignore|sni-fallback"; exit 1 ;;
    esac
}

vpn_status() {
    RESP=$(api_get "/vpn")
    HTTP_CODE=$(echo "$RESP" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('_http_code',200))" 2>/dev/null || echo 200)
    BODY="$RESP"
    separator
    RUNNING=$(echo "$BODY" | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(d.get('running',False))
" 2>/dev/null)
    PACKETS=$(echo "$BODY" | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(d.get('packets',0))
" 2>/dev/null)
    BYTES=$(echo "$BODY" | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(d.get('bytes','0'))
" 2>/dev/null)
    if [ "$RUNNING" = "True" ] || [ "$RUNNING" = "true" ]; then
        printf "  ${BOLD}VPN Status:${RST}  ${BG_GREEN}${WHITE}${BOLD} RUNNING ${RST}\n"
    else
        printf "  ${BOLD}VPN Status:${RST}  ${BG_RED}${WHITE}${BOLD} STOPPED ${RST}\n"
    fi
    VPN_IP=$(echo "$BODY" | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(d.get('vpn_ip','N/A'))
" 2>/dev/null)
    printf "  ${BOLD}TUN IP:${RST}      ${CYAN}${VPN_IP}${RST}\n"
    printf "  ${BOLD}Packets:${RST}     ${CYAN}${PACKETS}${RST}\n"
    # Human-readable bytes
    HR_BYTES=$(python3 -c "
b=int('$BYTES')
if b>1073741824: print(f'{b/1073741824:.1f} GB')
elif b>1048576: print(f'{b/1048576:.1f} MB')
elif b>1024: print(f'{b/1024:.1f} KB')
else: print(f'{b} B')
" 2>/dev/null)
    printf "  ${BOLD}Traffic:${RST}     ${CYAN}${HR_BYTES}${RST}\n"
    separator
}

vpn_start() {
    api_post "/vpn/start" "" >/dev/null
    printf "${GREEN}${BOLD}▶ VPN starting...${RST}\n"
    sleep 1
    local vresp vpn_ip
    vresp=$(api_get "/vpn" 2>/dev/null)
    vpn_ip=$(echo "$vresp" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('vpn_ip',''))" 2>/dev/null)
    if [ -n "$vpn_ip" ] && [ "$vpn_ip" != "N/A" ]; then
        printf "${DIM}  TUN IP: ${CYAN}%s${RST}\n" "$vpn_ip"
    fi
}

vpn_stop() {
    api_post "/vpn/stop" "" >/dev/null
    printf "${YELLOW}${BOLD}■ VPN stopping...${RST}\n"
}

vpn_on() {
    if [ $# -eq 0 ]; then
        vpn_start
        return
    fi
    if ! echo "$(api_get '/vpn')" | python3 -c "import sys,json; d=json.load(sys.stdin); exit(0 if d.get('running') else 1)" 2>/dev/null; then
        vpn_start
        sleep 1
    fi
    echo "[*] Executing (VPN on): $@"
    "$@"
}

vpn_off() {
    if [ $# -eq 0 ]; then
        vpn_stop
        return
    fi
    was_running=false
    if echo "$(api_get '/vpn')" | python3 -c "import sys,json; d=json.load(sys.stdin); exit(0 if d.get('running') else 1)" 2>/dev/null; then
        was_running=true
        echo "[*] Temporarily disabling VPN"
        vpn_stop
        sleep 1
    fi
    echo "[*] Executing (VPN off): $@"
    "$@"
    exit_code=$?
    if [ "$was_running" = "true" ]; then
        echo "[*] Restoring VPN"
        vpn_start
    fi
    exit $exit_code
}

vpn_logs() {
    local FORMAT="pretty" LIMIT=50 SINCE=0 HOST="" GREP="" FOLLOW=0
    while [ $# -gt 0 ]; do
        case "$1" in
            json) FORMAT="json"; shift ;;
            legacy) FORMAT="legacy"; shift ;;
            -f|--follow) FOLLOW=1; shift ;;
            -n) LIMIT="$2"; shift 2 ;;
            -g|--grep) GREP="$2"; shift 2 ;;
            --host) HOST="$2"; shift 2 ;;
            *) echo "Unknown logs option: $1"; exit 1 ;;
        esac
    done

    fetch_mitm_logs() {
        local query="format=$FORMAT&limit=$LIMIT&since=$SINCE"
        if [ -n "$HOST" ]; then
            query="${query}&host=$(printf '%s' "$HOST" | python3 -c "import sys, urllib.parse; print(urllib.parse.quote_plus(sys.stdin.read().strip()))")"
        fi
        if [ -n "$GREP" ]; then
            query="${query}&grep=$(printf '%s' "$GREP" | python3 -c "import sys, urllib.parse; print(urllib.parse.quote_plus(sys.stdin.read().strip()))")"
        fi
        ensure_token
        curl -s -H "Authorization: Bearer $TOKEN" "${API_URL}/vpn/mitm/logs?${query}" 2>/dev/null
    }

    show_once() {
        local body
        body=$(fetch_mitm_logs)
        if [ -z "$body" ]; then
            [ $FOLLOW -eq 0 ] && { separator; printf "  ${YELLOW}⏹  No decrypted traffic yet.${RST}\n"; separator; }
            return
        fi
        if [ "$FORMAT" = "json" ]; then
            echo "$body" | python3 -m json.tool 2>/dev/null || echo "$body"
            return
        fi
        if [ "$FORMAT" = "legacy" ]; then
            echo "$body"
            return
        fi
        # Pretty format
        echo "$body" | python3 -c "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
try:
    data=json.load(sys.stdin)
    records=data if isinstance(data,list) else data.get('records',data.get('logs',[]))
    for r in records:
        src=r.get('srcIp','?'); dst=r.get('dstIp','?')
        dp=r.get('dstPort','?'); method=r.get('method','')
        host=r.get('host',''); path=r.get('path',''); code=r.get('statusCode','')
        ts=r.get('timestamp','')
        print(f'{Gy}{ts}{N} {G}▶ {method}{N} {host}{path}')
        if code: print(f'  {BOLD}◀ {code}{N}')
        print(f'  {Gy}{src} → {dst}:{dp}{N}')
except: print(data)
" 2>/dev/null || echo "$body"
    }

    if [ $FOLLOW -eq 1 ]; then
        banner
        printf "${DIM}  Following MITM traffic (Ctrl+C to stop)${RST}\n"
        separator
        while true; do show_once; sleep 2; done
    else
        banner
        printf "${DIM}  Decrypted HTTP traffic${RST}\n"
        separator
        show_once
        printf "\n"
        separator
    fi
}

