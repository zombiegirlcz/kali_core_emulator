}

# ─── DESKTOP ───────────────────────────────────────────────

desktop_dispatch() {
    case "$1" in
        start) desktop_start ;;
        stop) desktop_stop ;;
        status) desktop_status ;;
        *) echo "Usage: nh desktop start|stop|status"; exit 1 ;;
    esac
}

desktop_start() {
    echo "[*] Clearing package locks..."
    rm -f /var/lib/dpkg/lock* /var/cache/apt/archives/lock /var/lib/apt/lists/lock 2>/dev/null || true
    export DEBIAN_FRONTEND=noninteractive
    dpkg --configure -a 2>/dev/null || true
    echo "[*] Checking desktop dependencies..."
    if ! command -v vncserver >/dev/null 2>&1 || ! command -v websockify >/dev/null 2>&1 || ! command -v dbus-launch >/dev/null 2>&1; then
        echo "[*] Installing XFCE4, VNC and noVNC..."
        apt-get update && apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" xfce4 xfce4-terminal tigervnc-standalone-server dbus-x11 novnc websockify curl procps </dev/null
    fi
    echo "[*] Stopping existing sessions..."
    vncserver -kill :1 2>/dev/null || true
    pkill -9 -f Xvnc 2>/dev/null || true; pkill -f websockify 2>/dev/null || true
    rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true
    echo "[*] Configuring VNC..."
    mkdir -p ~/.vnc
    echo "kali_operator" | vncpasswd -f > ~/.vnc/passwd
    chmod 600 ~/.vnc/passwd
    cat > ~/.vnc/xstartup << 'EOF'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
startxfce4 &
EOF
    chmod +x ~/.vnc/xstartup
    echo "[*] Starting VNC server :1 (5901)..."
    vncserver :1 -geometry 1280x720 -depth 24 2>&1 | tee /tmp/vnc.log
    echo "[*] Starting noVNC on :6080..."
    websockify --web=/usr/share/novnc/ 6080 127.0.0.1:5901 >/dev/null 2>&1 &
    echo "[+] Desktop ready! http://127.0.0.1:6080/vnc.html"
}

desktop_stop() {
    vncserver -kill :1 2>/dev/null || true
    pkill -9 -f Xvnc 2>/dev/null || true; pkill -f websockify 2>/dev/null || true
    rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true
    echo "[-] Desktop stopped."
}

desktop_status() {
    echo "=== DESKTOP STATUS ==="
    if pgrep -f "Xvnc|Xtightvnc|Xtigervnc" >/dev/null 2>&1; then echo "[+] VNC Server: RUNNING"; else echo "[-] VNC Server: STOPPED"; fi
    if pgrep -f "websockify" >/dev/null 2>&1; then echo "[+] noVNC: RUNNING"; else echo "[-] noVNC: STOPPED"; fi
}

# ─── FIX ───────────────────────────────────────────────────

fix_dispatch() {
    case "$1" in
        pkg) fix_pkg "$2" ;;
        auto) fix_auto ;;
        *) echo "Usage: nh fix pkg <name>|auto"; exit 1 ;;
    esac
}

fix_pkg() {
    local pkg="$1"
    [ -z "$pkg" ] && { echo "Usage: nh fix pkg <package-name>"; exit 1; }
    echo "[*] Mocking postinst for $pkg..."
    ln -sf /bin/true "/var/lib/dpkg/info/$pkg.postinst" 2>/dev/null || true
    echo "[*] Reconfiguring dpkg..."
    dpkg --configure -a
    echo "[+] Fixed postinst for $pkg!"
}

fix_auto() {
    echo "[*] Scanning for broken packages..."
    dpkg --configure -a 2>&1 || true
    # Find packages with failed postinst
    for info in /var/lib/dpkg/info/*.postinst; do
        [ -f "$info" ] || continue
        pkg=$(basename "$info" .postinst)
        if [ -x "$info" ] && ! "$info" configure 2>/dev/null; then
            echo "[*] Fixing $pkg..."
            ln -sf /bin/true "/var/lib/dpkg/info/$pkg.postinst" 2>/dev/null || true
        fi
    done
    dpkg --configure -a
    echo "[+] Auto-fix complete."
}

# ─── APPS ──────────────────────────────────────────────────

apps_dispatch() {
    case "$1" in
        usage) apps_usage ;;
        *) echo "Usage: nh apps usage"; exit 1 ;;
    esac
}

apps_usage() {
    api_get "/apps/usage" | fmt "
import sys, json
G,R,Y,N,Gy=chr(27)+'[92m',chr(27)+'[91m',chr(27)+'[93m',chr(27)+'[0m',chr(27)+'[90m'
try:
    d=json.load(sys.stdin)
    if 'error' in d: print(f'{R}✘  {d[\"error\"]}{N}')
    elif 'apps' in d:
        from collections import defaultdict
        by_pkg=defaultdict(lambda: {'t':0,'n':''})
        for a in d['apps']:
            pkg=a.get('packageName','?').split('.')[-1]
            if not by_pkg[pkg]['n']: by_pkg[pkg]['n']=pkg
            by_pkg[pkg]['t']+=a.get('totalTimeInForeground',0)
        apps=sorted(by_pkg.values(), key=lambda x: -x['t'])
        apps=[a for a in apps if a['t']>60000][:10]
        print(f'{G}📊  App Usage Statistics (24h):{N}')
        for a in apps:
            pkg=a['n']; t=a['t']
            mins=t//60000; secs=(t//1000)%60
            print(f'   💠  {pkg}{Gy} - {mins}:{secs:02d} min{N}')
        if not apps: print(f'{Y}📊  No foreground app data{N}')
    else: print(f'{Y}📊  No app usage data{N}')
except Exception as e:
    print(f'{R}Parse error: {e}{N}')
"
}

