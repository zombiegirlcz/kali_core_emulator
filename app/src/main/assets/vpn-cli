#!/bin/sh
# VPN CLI for NetHunter AI Operator
# Talks to LocalApiServer on port 1337

API_HOST="${API_HOST:-127.0.0.1}"
API_PORT="${API_PORT:-1337}"
API_URL="http://${API_HOST}:${API_PORT}"

# Colors
RST="\033[0m"
BOLD="\033[1m"
DIM="\033[2m"
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
MAGENTA="\033[1;35m"
CYAN="\033[1;36m"
WHITE="\033[1;37m"
BG_RED="\033[41m"
BG_GREEN="\033[42m"
BG_BLUE="\033[44m"
BG_MAGENTA="\033[45m"
GRAY="\033[0;90m"

get_token() {
    TOKEN=$(cat /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | grep 'name="auth_token"' | sed 's/.*value="\([^"]*\)".*/\1/' | head -n 1)
    if [ -z "$TOKEN" ]; then
        TOKEN=$(cat /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | grep 'name="auth_token"' | sed "s/.*value='\([^']*\)'.*/\1/" | head -n 1)
    fi
    echo "$TOKEN"
}

banner() {
    printf "${MAGENTA}${BOLD}"
    printf "╔══════════════════════════════════════════╗\n"
    printf "║   🛡️  NetHunter VPN Control Interface    ║\n"
    printf "╚══════════════════════════════════════════╝${RST}\n"
}

separator() {
    printf "${DIM}──────────────────────────────────────────────${RST}\n"
}

format_logs() {
    # Read stdin and colorize MITM log output
    while IFS= read -r line; do
        case "$line" in
            "=== Port"*)
                PORT=$(echo "$line" | sed 's/=== Port \([0-9]*\) ===/\1/')
                printf "\n${CYAN}${BOLD}┌─── 🔗 Session Port ${WHITE}${PORT}${CYAN} ───┐${RST}\n"
                ;;
            *"[CLIENT->SERVER]"*)
                DATA=$(echo "$line" | sed 's/\[CLIENT->SERVER\] //')
                # Detect HTTP method
                case "$DATA" in
                    GET\ *|POST\ *|PUT\ *|DELETE\ *|PATCH\ *|HEAD\ *|OPTIONS\ *)
                        METHOD=$(echo "$DATA" | cut -d' ' -f1)
                        REST=$(echo "$DATA" | cut -d' ' -f2-)
                        printf "${GREEN}  ▶ ${BOLD}${METHOD}${RST}${GREEN} ${REST}${RST}\n"
                        ;;
                    Host:*)
                        printf "${YELLOW}    🌐 ${DATA}${RST}\n"
                        ;;
                    Content-Type:*|Accept:*|User-Agent:*|Authorization:*|Cookie:*)
                        HNAME=$(echo "$DATA" | cut -d: -f1)
                        HVAL=$(echo "$DATA" | cut -d: -f2-)
                        printf "${DIM}    📋 ${BOLD}${HNAME}:${RST}${DIM}${HVAL}${RST}\n"
                        ;;
                    *)
                        printf "${GREEN}  ▶ ${DATA}${RST}\n"
                        ;;
                esac
                ;;
            *"[SERVER->CLIENT]"*)
                DATA=$(echo "$line" | sed 's/\[SERVER->CLIENT\] //')
                # Detect HTTP status
                case "$DATA" in
                    HTTP/*)
                        CODE=$(echo "$DATA" | cut -d' ' -f2)
                        REST=$(echo "$DATA" | cut -d' ' -f3-)
                        case "$CODE" in
                            2*)  printf "${BLUE}  ◀ ${BG_GREEN}${WHITE}${BOLD} ${CODE} ${RST} ${GREEN}${REST}${RST}\n" ;;
                            3*)  printf "${BLUE}  ◀ ${BG_BLUE}${WHITE}${BOLD} ${CODE} ${RST} ${YELLOW}${REST}${RST}\n" ;;
                            4*)  printf "${BLUE}  ◀ ${BG_RED}${WHITE}${BOLD} ${CODE} ${RST} ${RED}${REST}${RST}\n" ;;
                            5*)  printf "${BLUE}  ◀ ${BG_RED}${WHITE}${BOLD} ${CODE} ${RST} ${RED}${BOLD}${REST}${RST}\n" ;;
                            *)   printf "${BLUE}  ◀ ${BOLD}${DATA}${RST}\n" ;;
                        esac
                        ;;
                    Content-Type:*|Content-Length:*|Server:*|Date:*|Set-Cookie:*)
                        HNAME=$(echo "$DATA" | cut -d: -f1)
                        HVAL=$(echo "$DATA" | cut -d: -f2-)
                        printf "${DIM}    📋 ${BOLD}${HNAME}:${RST}${DIM}${HVAL}${RST}\n"
                        ;;
                    *)
                        printf "${BLUE}  ◀ ${DATA}${RST}\n"
                        ;;
                esac
                ;;
            "")
                ;;
            *)
                printf "${DIM}  ${line}${RST}\n"
                ;;
        esac
    done
}

usage() {
    banner
    printf "\n${WHITE}${BOLD}Usage:${RST} vpn-cli ${CYAN}<command>${RST}\n\n"
    printf "${WHITE}${BOLD}Commands:${RST}\n"
    printf "  ${GREEN}start${RST}              Start VPN capture\n"
    printf "  ${RED}stop${RST}               Stop VPN capture\n"
    printf "  ${CYAN}status${RST}             Show VPN status\n"
    printf "  ${YELLOW}logs${RST}               Show formatted MITM decrypted traffic\n"
    printf "  ${YELLOW}logs json${RST}          Show MITM logs as raw JSON\n"
    printf "  ${MAGENTA}mitm on${RST}            Enable TLS MITM inspection\n"
    printf "  ${MAGENTA}mitm off${RST}           Disable TLS MITM inspection\n"
    printf "  ${MAGENTA}mitm status${RST}        Show MITM status & active sessions\n"
    printf "  ${MAGENTA}mitm ca${RST}            Show/export Root CA certificate\n"
    printf "\n"
    exit 1
}

case "$1" in
    mitm)
        shift
        if [ $# -eq 0 ]; then
            printf "${RED}${BOLD}Error:${RST} specify ${CYAN}on${RST}, ${CYAN}off${RST}, ${CYAN}status${RST} or ${CYAN}ca${RST}\n"
            usage
        fi
        ACTION="$1"

        if [ "$ACTION" = "ca" ]; then
            curl -s -H "Authorization: Bearer $(get_token)" "${API_URL}/vpn/mitm/ca" 2>/dev/null
            exit 0
        fi

        if [ "$ACTION" = "status" ]; then
            RESP=$(curl -s -w "\n%{http_code}" -H "Authorization: Bearer $(get_token)" "${API_URL}/vpn/mitm" 2>/dev/null)
            HTTP_CODE=$(echo "$RESP" | tail -n1)
            BODY=$(echo "$RESP" | sed '$d')
            if [ "$HTTP_CODE" = "200" ]; then
                # Parse simple JSON fields
                MITM_STATE=$(echo "$BODY" | sed 's/.*"mitm":"\([^"]*\)".*/\1/')
                ACTIVE=$(echo "$BODY" | sed 's/.*"active_sessions":\([0-9]*\).*/\1/')
                separator
                if [ "$MITM_STATE" = "on" ]; then
                    printf "  ${BOLD}TLS MITM:${RST}        ${BG_GREEN}${WHITE}${BOLD} ON ${RST}\n"
                else
                    printf "  ${BOLD}TLS MITM:${RST}        ${BG_RED}${WHITE}${BOLD} OFF ${RST}\n"
                fi
                printf "  ${BOLD}Active Sessions:${RST} ${CYAN}${ACTIVE}${RST}\n"
                separator
            else
                printf "${RED}${BOLD}Error:${RST} API returned HTTP ${HTTP_CODE}\n"
                exit 1
            fi
            exit 0
        fi

        if [ "$ACTION" != "on" ] && [ "$ACTION" != "off" ]; then
            printf "${RED}${BOLD}Error:${RST} use ${CYAN}on${RST}, ${CYAN}off${RST} or ${CYAN}status${RST}\n"
            usage
        fi
        RESP=$(curl -s -w "\n%{http_code}" -X POST -H "Authorization: Bearer $(get_token)" -d "$ACTION" "${API_URL}/vpn/mitm" 2>/dev/null)
        HTTP_CODE=$(echo "$RESP" | tail -n1)
        BODY=$(echo "$RESP" | sed '$d')
        if [ "$HTTP_CODE" = "200" ]; then
            if [ "$ACTION" = "on" ]; then
                printf "${GREEN}${BOLD}✓${RST} TLS MITM inspection ${GREEN}${BOLD}enabled${RST}\n"
            else
                printf "${YELLOW}${BOLD}✓${RST} TLS MITM inspection ${YELLOW}${BOLD}disabled${RST}\n"
            fi
        else
            printf "${RED}${BOLD}✗${RST} Failed (HTTP ${HTTP_CODE})\n"
            exit 1
        fi
        ;;
    logs)
        shift
        FORMAT="text"
        if [ $# -gt 0 ] && [ "$1" = "json" ]; then
            FORMAT="json"
        fi
        RESP=$(curl -s -w "\n%{http_code}" -H "Authorization: Bearer $(get_token)" "${API_URL}/vpn/mitm/logs?format=${FORMAT}" 2>/dev/null)
        HTTP_CODE=$(echo "$RESP" | tail -n1)
        BODY=$(echo "$RESP" | sed '$d')

        if [ "$HTTP_CODE" != "200" ]; then
            printf "${RED}${BOLD}✗ Error:${RST} API returned HTTP ${HTTP_CODE} (Is the app running?)\n"
            exit 1
        fi

        if [ -z "$BODY" ]; then
            # Check MITM state to give helpful message
            STATUS=$(curl -s -H "Authorization: Bearer $(get_token)" "${API_URL}/vpn/mitm" 2>/dev/null)
            MITM_STATE=$(echo "$STATUS" | sed 's/.*"mitm":"\([^"]*\)".*/\1/')
            separator
            if [ "$MITM_STATE" = "off" ]; then
                printf "  ${YELLOW}${BOLD}⚠  MITM is OFF${RST} — no traffic is being intercepted.\n"
                printf "  ${DIM}Enable with:${RST} ${CYAN}vpn-cli mitm on${RST}\n"
            else
                printf "  ${DIM}📭 No decrypted traffic yet.${RST}\n"
                printf "  ${DIM}Open a website or app to generate HTTPS traffic.${RST}\n"
            fi
            separator
            exit 0
        fi

        if [ "$FORMAT" = "json" ]; then
            echo "$BODY" | python3 -m json.tool 2>/dev/null || echo "$BODY"
        else
            banner
            printf "${DIM}  Live decrypted TLS traffic${RST}\n"
            separator
            echo "$BODY" | format_logs
            printf "\n"
            separator
        fi
        ;;
    status)
        RESP=$(curl -s -w "\n%{http_code}" -H "Authorization: Bearer $(get_token)" "${API_URL}/vpn" 2>/dev/null)
        HTTP_CODE=$(echo "$RESP" | tail -n1)
        BODY=$(echo "$RESP" | sed '$d')
        if [ "$HTTP_CODE" = "200" ]; then
            RUNNING=$(echo "$BODY" | sed 's/.*"running":\([a-z]*\).*/\1/')
            PACKETS=$(echo "$BODY" | sed 's/.*"packets":\([0-9]*\).*/\1/')
            BYTES=$(echo "$BODY" | sed 's/.*"bytes":\([0-9]*\).*/\1/')
            # Human-readable bytes
            if [ "$BYTES" -gt 1073741824 ] 2>/dev/null; then
                HR_BYTES="$(echo "$BYTES" | awk '{printf "%.1f GB", $1/1073741824}')"
            elif [ "$BYTES" -gt 1048576 ] 2>/dev/null; then
                HR_BYTES="$(echo "$BYTES" | awk '{printf "%.1f MB", $1/1048576}')"
            elif [ "$BYTES" -gt 1024 ] 2>/dev/null; then
                HR_BYTES="$(echo "$BYTES" | awk '{printf "%.1f KB", $1/1024}')"
            else
                HR_BYTES="${BYTES} B"
            fi
            separator
            if [ "$RUNNING" = "true" ]; then
                printf "  ${BOLD}VPN Status:${RST}  ${BG_GREEN}${WHITE}${BOLD} RUNNING ${RST}\n"
            else
                printf "  ${BOLD}VPN Status:${RST}  ${BG_RED}${WHITE}${BOLD} STOPPED ${RST}\n"
            fi
            printf "  ${BOLD}Packets:${RST}     ${CYAN}${PACKETS}${RST}\n"
            printf "  ${BOLD}Traffic:${RST}     ${CYAN}${HR_BYTES}${RST}\n"
            separator
        else
            printf "${RED}${BOLD}✗ Error:${RST} API returned HTTP ${HTTP_CODE}\n"
            exit 1
        fi
        ;;
    start)
        RESP=$(curl -s -w "\n%{http_code}" -X POST -H "Authorization: Bearer $(get_token)" "${API_URL}/vpn/start" 2>/dev/null)
        HTTP_CODE=$(echo "$RESP" | tail -n1)
        if [ "$HTTP_CODE" = "200" ]; then
            printf "${GREEN}${BOLD}▶ VPN starting...${RST}\n"
        else
            printf "${RED}${BOLD}✗ Failed to start VPN${RST} (HTTP ${HTTP_CODE})\n"
            exit 1
        fi
        ;;
    stop)
        RESP=$(curl -s -w "\n%{http_code}" -X POST -H "Authorization: Bearer $(get_token)" "${API_URL}/vpn/stop" 2>/dev/null)
        HTTP_CODE=$(echo "$RESP" | tail -n1)
        if [ "$HTTP_CODE" = "200" ]; then
            printf "${YELLOW}${BOLD}■ VPN stopping...${RST}\n"
        else
            printf "${RED}${BOLD}✗ Failed to stop VPN${RST} (HTTP ${HTTP_CODE})\n"
            exit 1
        fi
        ;;
    *)
        usage
        ;;
esac
