#!/bin/sh
# code-server-ctl — control script for code-server (VS Code in browser)
# Talks to LocalApiServer on port 1337 for shared state, but runs the actual
# code-server process locally inside the PRoot guest.
#
# Commands:
#   start    — spawn code-server in background if not already running
#   stop     — kill running code-server process
#   status   — report running state
#   password — print the generated password
#   install  — install code-server into /opt/code-server if missing
#   info     — print port and workspace path
#
# Security:
#   - bind-addr is HARDCODED to 127.0.0.1:8443 (no CLI override)
#   - password is auto-generated and stored in ~/.config/code-server/config.yaml (chmod 600)
#   - password is never passed as command-line argument (would leak via `ps aux`)

set -e

CODE_SERVER_BIN="${CODE_SERVER_BIN:-/opt/code-server/bin/code-server}"
CODE_SERVER_HOME="${CODE_SERVER_HOME:-/root/.local/share/code-server}"
CODE_SERVER_CONFIG="${CODE_SERVER_CONFIG:-/root/.config/code-server/config.yaml}"
CODE_SERVER_PORT="${CODE_SERVER_PORT:-8443}"
CODE_SERVER_BIND="${CODE_SERVER_BIND:-127.0.0.1}"
CODE_SERVER_WORKSPACE="${CODE_SERVER_WORKSPACE:-/root/projects}"
CODE_SERVER_PIDFILE="${CODE_SERVER_PIDFILE:-/tmp/code-server.pid}"
CODE_SERVER_LOGFILE="${CODE_SERVER_LOGFILE:-/tmp/code-server.log}"

mkdir -p "$(dirname "$CODE_SERVER_CONFIG")" "$CODE_SERVER_HOME" "$CODE_SERVER_WORKSPACE" 2>/dev/null || true

RST=$(printf '\033[0m'); BOLD=$(printf '\033[1m'); DIM=$(printf '\033[2m')
GRN=$(printf '\033[1;32m'); YEL=$(printf '\033[1;33m'); RED=$(printf '\033[1;31m'); CYN=$(printf '\033[1;36m')

banner() {
    printf "${CYN}${BOLD}"; printf "code-server control\n"; printf "${RST}"
}

is_running() {
    if [ -f "$CODE_SERVER_PIDFILE" ]; then
        local pid
        pid=$(cat "$CODE_SERVER_PIDFILE" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        # Stale pidfile
        rm -f "$CODE_SERVER_PIDFILE" 2>/dev/null || true
    fi
    return 1
}

generate_password() {
    # 12 random base64 chars (≈72 bits of entropy), tr to safe alphabet
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 12 | tr -d '/+=' | head -c 16
    else
        # Fallback: read from /dev/urandom
        head -c 24 /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 16
    fi
}

write_config() {
    local password="$1"
    cat > "$CODE_SERVER_CONFIG" <<EOF
bind-addr: ${CODE_SERVER_BIND}:${CODE_SERVER_PORT}
auth: password
password: ${password}
cert: false
EOF
    chmod 600 "$CODE_SERVER_CONFIG" 2>/dev/null || true
}

read_password() {
    if [ -f "$CODE_SERVER_CONFIG" ]; then
        awk '/^password:/{print $2; exit}' "$CODE_SERVER_CONFIG" 2>/dev/null
    fi
}

ensure_password() {
    local pw
    pw=$(read_password)
    if [ -z "$pw" ]; then
        pw=$(generate_password)
        write_config "$pw"
    fi
    printf "%s" "$pw"
}

# Resolve code-server binary path (official installer uses /usr/lib/code-server or /usr/bin)
resolve_code_server_bin() {
    if command -v code-server >/dev/null 2>&1; then
        command -v code-server
    elif [ -x /usr/lib/code-server/lib/vscode/bin/code-server ]; then
        echo /usr/lib/code-server/lib/vscode/bin/code-server
    elif [ -x /usr/bin/code-server ]; then
        echo /usr/bin/code-server
    else
        echo "$CODE_SERVER_BIN"
    fi
}

cmd_start() {
    banner
    if is_running; then
        printf "%s[=] code-server is already running (pid %s)%s\n" "$YEL" "$(cat "$CODE_SERVER_PIDFILE")" "$RST"
        return 0
    fi

    local bin
    bin=$(resolve_code_server_bin)
    if [ ! -x "$bin" ]; then
        printf "%s[!] code-server binary not found at %s%s\n" "$RED" "$bin" "$RST"
        printf "%s    Run: code-server-ctl install%s\n" "$DIM" "$RST"
        return 1
    fi

    ensure_password >/dev/null

    # Start in background, log to file. Use nohup to survive PRoot exit.
    nohup "$bin" \
        --config "$CODE_SERVER_CONFIG" \
        --user-data-dir "$CODE_SERVER_HOME" \
        --extensions-dir "$CODE_SERVER_HOME/extensions" \
        "$CODE_SERVER_WORKSPACE" \
        >"$CODE_SERVER_LOGFILE" 2>&1 &

    local pid=$!
    echo "$pid" > "$CODE_SERVER_PIDFILE"

    # Wait a moment and verify the process is still alive
    sleep 1
    if ! kill -0 "$pid" 2>/dev/null; then
        printf "%s[!] code-server failed to start. Last log lines:%s\n" "$RED" "$RST"
        tail -n 20 "$CODE_SERVER_LOGFILE" 2>/dev/null || true
        rm -f "$CODE_SERVER_PIDFILE" 2>/dev/null || true
        return 1
    fi

    printf "%s[+] code-server started (pid %s, port %s)%s\n" "$GRN" "$pid" "$CODE_SERVER_PORT" "$RST"
    printf "%s    Open: http://127.0.0.1:%s/%s\n" "$DIM" "$CODE_SERVER_PORT" "$RST"
    return 0
}

cmd_stop() {
    banner
    if ! is_running; then
        printf "%s[=] code-server is not running%s\n" "$DIM" "$RST"
        return 0
    fi
    local pid
    pid=$(cat "$CODE_SERVER_PIDFILE")
    # SIGTERM first
    kill -TERM "$pid" 2>/dev/null || true
    # Wait up to 5s for graceful shutdown
    local i=0
    while [ $i -lt 50 ] && kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        i=$((i + 1))
    done
    # Force kill if still alive
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
    fi
    # Also kill children (node spawns workers)
    pkill -P "$pid" 2>/dev/null || true
    pkill -f "code-server" 2>/dev/null || true
    rm -f "$CODE_SERVER_PIDFILE" 2>/dev/null || true
    printf "%s[-] code-server stopped%s\n" "$YEL" "$RST"
    return 0
}

cmd_status() {
    if is_running; then
        printf '{"status":"running","port":%s,"pid":%s}\n' \
            "$CODE_SERVER_PORT" "$(cat "$CODE_SERVER_PIDFILE")"
        return 0
    fi
    # Check if port is bound by some other process
    if command -v ss >/dev/null 2>&1; then
        if ss -ltn 2>/dev/null | grep -q ":${CODE_SERVER_PORT} "; then
            printf '{"status":"port_busy","port":%s}\n' "$CODE_SERVER_PORT"
            return 0
        fi
    fi
    printf '{"status":"stopped","port":%s}\n' "$CODE_SERVER_PORT"
    return 0
}

cmd_password() {
    if [ -f "$CODE_SERVER_CONFIG" ]; then
        local pw
        pw=$(read_password)
        if [ -n "$pw" ]; then
            printf '{"password":"%s"}\n' "$pw"
            return 0
        fi
    fi
    printf '{"error":"password not yet generated — start the editor first"}\n'
    return 1
}

cmd_info() {
    local bin
    bin=$(resolve_code_server_bin)
    printf '{"bind":"%s","port":%s,"workspace":"%s","config":"%s","binary":"%s"}\n' \
        "$CODE_SERVER_BIND" "$CODE_SERVER_PORT" "$CODE_SERVER_WORKSPACE" \
        "$CODE_SERVER_CONFIG" "$bin"
    return 0
}

cmd_install() {
    banner
    local bin
    bin=$(resolve_code_server_bin)
    if [ -x "$bin" ]; then
        printf "%s[=] code-server already installed at %s%s\n" "$GRN" "$bin" "$RST"
        return 0
    fi
    printf "%s[*] Installing code-server via official script...%s\n" "$CYN" "$RST"
    if ! command -v curl >/dev/null 2>&1; then
        printf "%s[!] curl is required%s\n" "$RED" "$RST"
        return 1
    fi
    printf "%s[*] Downloading install.sh...%s\n" "$CYN" "$RST"
    curl -#fSL https://code-server.dev/install.sh -o /tmp/code-server-install.sh 2>&1 || {
        printf "%s[!] Download failed. Try: npm install -g code-server%s\n" "$RED" "$RST"
        return 1
    }
    printf "%s[*] Running installer (output follows)...%s\n" "$CYN" "$RST"
    sh /tmp/code-server-install.sh 2>&1
    rm -f /tmp/code-server-install.sh

    # Official installer puts binary in /usr/lib/code-server/lib/vscode/bin/code-server
    # with symlink at /usr/bin/code-server
    if command -v code-server >/dev/null 2>&1; then
        # Update config to point to the actual binary
        CODE_SERVER_BIN="$(command -v code-server)"
        printf "\n%s[+] Installed: %s%s\n" "$GRN" "$CODE_SERVER_BIN" "$RST"
        return 0
    elif [ -x /usr/lib/code-server/lib/vscode/bin/code-server ]; then
        CODE_SERVER_BIN="/usr/lib/code-server/lib/vscode/bin/code-server"
        printf "\n%s[+] Installed: %s%s\n" "$GRN" "$CODE_SERVER_BIN" "$RST"
        return 0
    else
        printf "\n%s[!] Install script ran but binary not found in PATH or /usr/lib/code-server%s\n" "$YEL" "$RST"
        printf "%s    Search: find / -name code-server -type f 2>/dev/null%s\n" "$DIM" "$RST"
        return 1
    fi
}

cmd_log() {
    if [ -f "$CODE_SERVER_LOGFILE" ]; then
        tail -n 50 "$CODE_SERVER_LOGFILE"
    else
        echo "No log file at $CODE_SERVER_LOGFILE"
    fi
}

usage() {
    cat <<EOF
Usage: code-server-ctl {start|stop|status|password|install|info|log}

  start    Start code-server in background
  stop     Stop running code-server
  status   Print JSON status (running|stopped|port_busy)
  password Print JSON with current auto-generated password
  install  Install code-server if missing
  info     Print JSON config (bind, port, workspace, paths)
  log      Tail last 50 log lines

All state lives at:
  config: $CODE_SERVER_CONFIG
  pid:    $CODE_SERVER_PIDFILE
  log:    $CODE_SERVER_LOGFILE
EOF
    return 1
}

case "${1:-}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    status)  cmd_status ;;
    password) cmd_password ;;
    install) cmd_install ;;
    info)    cmd_info ;;
    log)     cmd_log ;;
    *)       usage ;;
esac
