#!/bin/sh
# ashell — escape PRoot container → host Android app shell
#
# Bez argumentů:    otevře novou TerminalActivity mimo PRoot (host app shell)
# ashell -c <cmd>:  spustí příkaz na HOSTITELI (uid aplikace) a vrátí
#                   stdout/stderr zpět do aktuálního terminálu (přes /shell API)
#                   — před příkazem se aplikuje konfigurace z ashell.conf
# ashell -e:        otevře konfiguraci (ashell.conf: proměnné prostředí + blocklist)
#                   v $EDITOR; pokud není nastaven, vypíše hlášku
# ashell --add <cmd> | --remove <cmd> | --list: správa blokovaných příkazů
#
# Konfigurace: <filesDir>/ashell.conf — řádky `block <cmd>` zakazují příkazy,
# ostatní neprázdné řádky jsou sh příkazy vykonané před KAŽDÝM `ashell -c`
# (jako .zshrc: export FOO=bar, unset LD_LIBRARY_PATH, ...).
# Placeholder ${FILES_DIR} se expanduje na filesDir aplikace.
#
# Primární metoda: cmd activity (ActivityManager) — nepotřebuje curl/wget ani token
# Fallback metoda:  POST /ashell na LocalApiServer (127.0.0.1:1337)

APP_PKG="com.linux_core"
ACTIVITY="${APP_PKG}/com.linux_core.ui.terminal.TerminalActivity"
API_URL="http://127.0.0.1:1337"

# ── ashell adb start|stop|status|shell|-c — shell_daemon (uid 2000) ──
# Persistentní démon běžící pod uid 2000 (shell). Deploy je cestou jniLibs
# (vzor libshizuku.so): Android extrahuje libshelldaemon.so do
# nativeLibraryDir; appka publikuje plnou cestu do /mnt/app/shelldaemon.path.
# `ashell adb start` ji spustí pres `adb shell` pod uid 2000 (ZADNY su).
# Pak drží do rebootu. `ashell adb -c` spouští příkazy pod uid 2000.
# `ashell adb shell` otevře nové terminálové okno pod uid 2000.
if [ "$1" = "adb" ]; then
    shift
    SUBCMD="${1:-status}"

    # Helper: zavolat LocalApiServer endpoint (GET/POST, volitelný body)
    api_call() {
        _method="$1"; _endpoint="$2"; _body="${3:-}"
        _token=$(grep 'name="auth_token"' /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null |             sed -n 's/.*<string name="auth_token">\([^<]*\)<\/string>.*//p' | head -n 1)
        if command -v curl >/dev/null 2>&1; then
            if [ "$_method" = "GET" ]; then
                if [ -n "$_token" ]; then
                    curl -s -H "Authorization: Bearer $_token" "${API_URL}${_endpoint}" 2>/dev/null
                else
                    curl -s "${API_URL}${_endpoint}" 2>/dev/null
                fi
            else
                if [ -n "$_token" ]; then
                    if [ -n "$_body" ]; then
                        curl -s -X POST -H "Authorization: Bearer $_token" --data "$_body" "${API_URL}${_endpoint}" 2>/dev/null
                    else
                        curl -s -X POST -H "Authorization: Bearer $_token" "${API_URL}${_endpoint}" 2>/dev/null
                    fi
                else
                    if [ -n "$_body" ]; then
                        curl -s -X POST --data "$_body" "${API_URL}${_endpoint}" 2>/dev/null
                    else
                        curl -s -X POST "${API_URL}${_endpoint}" 2>/dev/null
                    fi
                fi
            fi
        elif command -v wget >/dev/null 2>&1; then
            if [ "$_method" = "GET" ]; then
                if [ -n "$_token" ]; then
                    wget -q -O - --header="Authorization: Bearer $_token" "${API_URL}${_endpoint}" 2>/dev/null
                else
                    wget -q -O - "${API_URL}${_endpoint}" 2>/dev/null
                fi
            else
                if [ -n "$_token" ]; then
                    if [ -n "$_body" ]; then
                        wget -q -O - --header="Authorization: Bearer $_token" --post-data="$_body" "${API_URL}${_endpoint}" 2>/dev/null
                    else
                        wget -q -O - --header="Authorization: Bearer $_token" --post-data="" "${API_URL}${_endpoint}" 2>/dev/null
                    fi
                else
                    if [ -n "$_body" ]; then
                        wget -q -O - --post-data="$_body" "${API_URL}${_endpoint}" 2>/dev/null
                    else
                        wget -q -O - --post-data="" "${API_URL}${_endpoint}" 2>/dev/null
                    fi
                fi
            fi
        else
            echo "[-] Error: curl ani wget nejsou k dispozici." >&2
            return 1
        fi
    }

    # Cesta k extrahované binárce.
    #
    # Zdroje v poradi priorit:
    #   1) $SHELLDAEMON_PATH (explicitni override z prostredi)
    #   2) /mnt/app/shelldaemon.path — appka publikuje pri startu; v guestu
    #      viditelne JEN kdyz je zapnuty bind_app (RootBridge -> "App Data")
    #   3) $HOME/shelldaemon.path — fallback pro pripad, ze si ji tam user zkopiruje
    #
    # Kdyz nic z toho neni, vratime prazdno a `start` vypise presny navod.
    daemon_path() {
        if [ -n "${SHELLDAEMON_PATH:-}" ] && [ -x "$SHELLDAEMON_PATH" ]; then
            printf '%s' "$SHELLDAEMON_PATH"
            return 0
        fi
        _p=""
        for f in /mnt/app/shelldaemon.path "$HOME/shelldaemon.path"; do
            if [ -f "$f" ]; then
                _p=$(tr -d '
 ' < "$f")
                [ -n "$_p" ] && break
            fi
        done
        printf '%s' "$_p"
    }

    # Token: guest ho vidi jako /mnt/app/shell_daemon.token
    daemon_token() {
        for f in /mnt/app/shell_daemon.token "$HOME/shell_daemon.token"; do
            if [ -f "$f" ]; then
                tr -d '
 ' < "$f"
                return 0
            fi
        done
        return 1
    }

    case "$SUBCMD" in
        start)
            if ! command -v adb >/dev/null 2>&1; then
                echo "[-] adb neni v guestu k dispozici." >&2
                echo "    (guest rootfs by mel mit /usr/bin/adb; jinak adb pripoj zvenku)" >&2
                exit 1
            fi
            if ! adb devices 2>/dev/null | grep -q "device$"; then
                echo "[-] adb neni pripojeny. Nejdřív spáruj:" >&2
                echo "      adb pair <host>:<port> <pairing-code>" >&2
                echo "      adb connect <host>:<port>" >&2
                exit 1
            fi
            DAEMON=$(daemon_path)
            if [ -z "$DAEMON" ]; then
                echo "[-] Neznám cestu k libshelldaemon.so." >&2
                echo "" >&2
                echo "    Duvod: v guestu neni videt /mnt/app (bind_app je vypnuty)." >&2
                echo "    Řešení (vyber jedno):" >&2
                echo "      a) V appce: Root Bridge -> zapni 'App Data' (bind_app)," >&2
                echo "         pak restartuj session (nh distro kill && nh distro start)." >&2
                echo "      b) Zjisti cestu z hostu:" >&2
                echo "           adb shell cat /data/data/com.linux_core/files/shelldaemon.path" >&2
                echo "         a nastav ji v guestu:" >&2
                echo "           export SHELLDAEMON_PATH=<ta cesta>" >&2
                exit 1
            fi
            if ! adb shell "test -x $DAEMON" 2>/dev/null; then
                echo "[-] Binarka neni spustitelna v host kontextu: $DAEMON" >&2
                echo "    Zkontroluj, ze APK ma extractNativeLibs (useLegacyPackaging=true)." >&2
                exit 1
            fi
            TOKEN=$(daemon_token) || {
                echo "[-] Chybí token /mnt/app/shell_daemon.token (spusť appku)." >&2
                exit 1
            }
            if [ -z "$TOKEN" ]; then
                echo "[-] Token je prázdný." >&2
                exit 1
            fi

            # Uz bezi? Cteme PID file, ktery daemon zapisuje do
            # /data/local/tmp/shelldaemon.pid. `pidof libshelldaemon.so`
            # nefunguje — Android comm je orezany na 15 znaku.
            PIDFILE=/data/local/tmp/shelldaemon.pid
            daemon_pid() {
                adb shell "cat $PIDFILE 2>/dev/null" 2>/dev/null | tr -d '\r\n '
            }
            daemon_alive() {
                _p=$(daemon_pid)
                [ -n "$_p" ] || return 1
                # over, ze proces opravdu existuje a je to nas daemon
                adb shell "test -d /proc/$_p && grep -q shell_daemon /proc/$_p/cmdline 2>/dev/null || grep -q libshelldaemon /proc/$_p/cmdline 2>/dev/null" 2>/dev/null
            }

            pid=$(daemon_pid)
            if ! daemon_alive; then
                echo "[*] Startuji libshelldaemon.so pod shell UID (non-root) ..."
                adb shell "nohup $DAEMON --port=13341 --token=$TOKEN >/dev/null 2>&1 &" >/dev/null 2>&1
                sleep 2
                pid=$(daemon_pid)
            fi

            if [ -n "$pid" ] && daemon_alive; then
                duid=$(adb shell "cat /proc/$pid/status 2>/dev/null | grep '^Uid:' | awk '{print \$2}'" 2>/dev/null | tr -d '\r\n ')
                echo "[+] shell_daemon běží (pid=$pid, uid=${duid:-?}, non-root)"
                echo '    Příkazy: ashell adb -c "<cmd>"  (TCP 127.0.0.1:13341)'
                exit 0
            fi
            echo "[-] shell_daemon nenabehl." >&2
            echo "    Binarka: $DAEMON" >&2
            echo "    Zkus: adb shell $DAEMON --no-fork --port=13341 --token=$TOKEN" >&2
            exit 1
            ;;
        stop)
            if ! command -v adb >/dev/null 2>&1; then
                echo "[-] adb neni v guestu k dispozici." >&2
                exit 1
            fi
            PIDFILE=/data/local/tmp/shelldaemon.pid
            _p=$(adb shell "cat $PIDFILE 2>/dev/null" 2>/dev/null | tr -d '\r\n ')
            if [ -n "$_p" ]; then
                adb shell "kill $_p 2>/dev/null || true" >/dev/null 2>&1
                adb shell "rm -f $PIDFILE" >/dev/null 2>&1
            fi
            # fallback pro pripad, ze pid file chybi
            adb shell "pkill -f libshelldaemon 2>/dev/null || true" >/dev/null 2>&1
            echo "[+] shell_daemon stopped"
            ;;
        status)
            # Status zjistíme TCP probem z appky (app se jen připojí, nic nespouští).
            RESPONSE=$(api_call GET "/shelldaemon/status")
            if [ -z "$RESPONSE" ]; then
                echo "[-] LocalApiServer neodpovídá na ${API_URL}/shelldaemon/status" >&2
                exit 1
            fi
            printf '%s' "$RESPONSE" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    running = d.get('running', False)
    pid = d.get('pid', '?')
    port = d.get('port', 13341)
    if running:
        print(f'[+] shell_daemon běží (pid={pid}, port={port})')
    else:
        print('[-] shell_daemon neběží')
except Exception:
    print('[-] Neplatná odpověď ze serveru')
" 2>/dev/null || echo "[-] Chyba parsování odpovědi" >&2
            ;;
        shell)
            echo "[*] Otevírám nové terminálové okno pod uid 2000 (shell_daemon)..."
            if command -v cmd >/dev/null 2>&1; then
                cmd activity start-activity -n "$ACTIVITY"                     --es rootfsDirName "ashell-adb"                     --ez mountStorage false                     --ez ashellMode true                     >/dev/null 2>&1
                RC=$?
                if [ $RC -eq 0 ]; then
                    echo "[+] ADB shell opened (via cmd activity)"
                    exit 0
                fi
                echo "[!] cmd activity selhal (RC=$RC), zkouším fallback..." >&2
            fi
            RESPONSE=$(api_call POST "/ashell" '{"mode":"adb-shell"}')
            if [ -z "$RESPONSE" ]; then
                echo "[-] LocalApiServer neodpovídá na ${API_URL}/ashell" >&2
                exit 1
            fi
            echo "[+] ADB shell opened (via API)"
            ;;
        -c|--cmd)
            shift
            CMD="$*"
            [ -z "$CMD" ] && { echo "[-] Usage: ashell adb -c '<prikaz>'" >&2; echo "    Např: ashell adb -c "pm list packages"" >&2; exit 1; }
            RESPONSE=$(api_call POST "/shelldaemon/exec" "$CMD")
            if [ -z "$RESPONSE" ]; then
                echo "[-] LocalApiServer neodpovídá na ${API_URL}/shelldaemon/exec" >&2
                exit 1
            fi
            printf '%s' "$RESPONSE" | python3 -c "
import sys, json
data = sys.stdin.read()
try:
    d = json.loads(data)
except Exception as e:
    sys.stderr.write('Chyba parsování odpovědi: %s
' % e)
    sys.stderr.write('Raw: %s
' % data[:400])
    sys.exit(1)
if 'error' in d and 'exit_code' not in d:
    out = d.get('stdout',''); err = d.get('stderr','')
    if out: sys.stdout.write(out)
    if err: sys.stderr.write(err)
    if not out and not err:
        sys.stderr.write(d['error'] + '
')
    sys.exit(1)
out = d.get('stdout',''); err = d.get('stderr','')
rc = d.get('exit_code', 0)
if out: sys.stdout.write(out)
if err: sys.stderr.write(err)
if not isinstance(rc, int): rc = 0
sys.exit(rc if 0 <= rc <= 255 else (1 if rc != 0 else 0))
" 2>/dev/null
            RC=$?
            exit $RC
            ;;
        *)
            echo "[-] Neznámý adb subcommand: $SUBCMD" >&2
            echo "    Usage: ashell adb start|stop|status|shell|-c '<cmd>'" >&2
            exit 1
            ;;
    esac
    exit $?
fi

# ── ashell -c '<prikaz>' — spustit na hostiteli a vrátit výstup ──
if [ "$1" = "-c" ] || [ "$1" = "--cmd" ]; then
    shift
    CMD="$*"
    [ -z "$CMD" ] && { echo "[-] Usage: ashell -c '<prikaz>'" >&2; echo "    Pro multi-command: ashell -c \"ls -la && echo ok\"" >&2; exit 1; }

    # Host rootfs (pro překlad cwd guestu → host): PROOT_L2S_DIR bez přípony /.l2s
    ROOTFS_HOST=""
    if [ -n "${PROOT_L2S_DIR:-}" ]; then
        ROOTFS_HOST="${PROOT_L2S_DIR%/.l2s}"
    fi
    TERM_GUEST="${TERM:-xterm-256color}"

    # 1) Streaming PTY most (python3 socket → ashell_pty na 127.0.0.1:13340)
    if command -v python3 >/dev/null 2>&1; then
        # Klient se píše do temp SOUBORU (ne `python3 - <<EOF`), aby
        # python zdědil PŮVODNÍ stdin (pipe/tty) a mohl forwardovat vstup.
        cat > /tmp/.ashell_pty_$$.py <<'PYEOF'
import sys, os, select, struct, socket, termios, tty

port = 13340
cmd = sys.argv[1] if len(sys.argv) > 1 else ""
cwd = sys.argv[2] if len(sys.argv) > 2 else ""
rootfs = sys.argv[3] if len(sys.argv) > 3 else ""
term = sys.argv[4] if len(sys.argv) > 4 else "xterm-256color"

try:
    s = socket.create_connection(("127.0.0.1", port), timeout=2)
except Exception:
    sys.exit(125)  # ashell_pty nedostupný → fallback na HTTP

def send(t, payload=b""):
    try:
        s.sendall(bytes([t]) + struct.pack(">I", len(payload)) + payload)
    except Exception:
        pass

stdin_fd = sys.stdin.fileno()
is_tty = os.isatty(stdin_fd)
old = None
if is_tty:
    try:
        old = termios.tcgetattr(stdin_fd)
        tty.setraw(stdin_fd)
    except Exception:
        old = None
        is_tty = False

hello = ("%s\0%s\0%s\0%s\0%s\0" % (cmd, cwd, rootfs, term, "1" if is_tty else "0")).encode("utf-8", "replace")
send(0x05, hello)

last_size = None
def maybe_winch():
    global last_size
    try:
        sz = os.get_terminal_size()
        cur = (sz.columns, sz.lines)
    except Exception:
        cur = (80, 24)
    if cur != last_size:
        last_size = cur
        send(0x03, struct.pack(">II", cur[0], cur[1]))

if is_tty:
    maybe_winch()

exit_code = 0
stdin_open = True

def handle_server():
    global exit_code
    hdr = b""
    while len(hdr) < 5:
        chunk = s.recv(5 - len(hdr))
        if not chunk:
            return False
        hdr += chunk
    t = hdr[0]
    ln = struct.unpack(">I", hdr[1:])[0]
    payload = b""
    while len(payload) < ln:
        chunk = s.recv(ln - len(payload))
        if not chunk:
            return False
        payload += chunk
    if t == 0x02:
        os.write(sys.stdout.fileno(), payload)
    elif t == 0x04 and len(payload) >= 4:
        exit_code = struct.unpack(">I", payload[:4])[0] & 0xFF
    elif t == 0xFF:
        return False
    return True

try:
    while True:
        rlist = [s] if not stdin_open else [s, sys.stdin]
        r, _, _ = select.select(rlist, [], [], 0.2)
        for x in r:
            if x is s:
                if not handle_server():
                    raise EOFError
            else:
                data = os.read(stdin_fd, 8192)
                if not data:
                    # EOF na stdin (pipe) → STDIN_EOF frame (server zavře child stdin)
                    send(0x06)
                    stdin_open = False
                else:
                    send(0x01, data)
        if is_tty:
            maybe_winch()
except EOFError:
    pass
except Exception:
    pass
finally:
    if old is not None:
        try:
            termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old)
        except Exception:
            pass
    try:
        s.close()
    except Exception:
        pass
sys.exit(exit_code)
PYEOF
        python3 /tmp/.ashell_pty_$$.py "$CMD" "$PWD" "$ROOTFS_HOST" "$TERM_GUEST"
        RC=$?
        rm -f /tmp/.ashell_pty_$$.py
        if [ "$RC" -ne 125 ]; then
            exit $RC
        fi
        # 125 = ashell_pty nedostupný → pokračuj na HTTP fallback
    fi

    # 2) HTTP fallback (původní JSON most přes LocalApiServer)
    TOKEN=$(grep 'name="auth_token"' /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | \
        sed -n 's/.*<string name="auth_token">\([^<]*\)<\/string>.*/\1/p' | head -n 1)

    if command -v curl >/dev/null 2>&1; then
        if [ -n "$TOKEN" ]; then
            RESPONSE=$(curl -s -X POST -H "Authorization: Bearer $TOKEN" --data "$CMD" "${API_URL}/shell" 2>/dev/null)
        else
            RESPONSE=$(curl -s -X POST --data "$CMD" "${API_URL}/shell" 2>/dev/null)
        fi
    elif command -v wget >/dev/null 2>&1; then
        if [ -n "$TOKEN" ]; then
            RESPONSE=$(wget -q -O - --header="Authorization: Bearer $TOKEN" --post-data="$CMD" "${API_URL}/shell" 2>/dev/null)
        else
            RESPONSE=$(wget -q -O - --post-data="$CMD" "${API_URL}/shell" 2>/dev/null)
        fi
    else
        echo "[-] Error: curl ani wget nejsou k dispozici." >&2
        exit 1
    fi

    if [ -z "$RESPONSE" ]; then
        echo "[-] Error: LocalApiServer neodpovídá na ${API_URL}/shell" >&2
        exit 1
    fi

    # DEBUG: ukaž raw odpověď (jen když ASHELL_DEBUG=1)
    if [ -n "${ASHELL_DEBUG:-}" ]; then
        echo "[ASHELL_DEBUG] RESPONSE[${#RESPONSE}]: $(echo "$RESPONSE" | cat -v | head -c 500)" >&2
    fi

    # Vytisknout stdout + stderr a vrátit exit code
    cat > /tmp/.ashell_parse_$$.py <<'PYEOF'
import sys, json
data = sys.stdin.read()
try:
    d = json.loads(data)
except Exception as e:
    try:
        fix = str.maketrans({10: '\\n', 13: '\\r', 9: '\\t'})
        d = json.loads(data.translate(fix))
    except Exception:
        sys.stderr.write('Chyba parsování odpovědi: %s\n' % e)
        sys.stderr.write('Raw: %s\n' % data[:400])
        sys.exit(1)
# Odmítnutí / vnitřní chyba (JSON bez exit_code) → stderr + rc=1
if 'error' in d and 'exit_code' not in d:
    out = d.get('stdout',''); err = d.get('stderr','')
    if out: sys.stdout.write(out)
    if err: sys.stderr.write(err)
    if not out and not err:
        sys.stderr.write(d['error'] + '\n')
    sys.exit(1)
out = d.get('stdout',''); err = d.get('stderr','')
rc = d.get('exit_code', 0)
if out: sys.stdout.write(out)
if err: sys.stderr.write(err)
if not isinstance(rc, int): rc = 0
# Propaguj skutečný exit code (0..255; timeout -1 → 1)
sys.exit(rc if 0 <= rc <= 255 else (1 if rc != 0 else 0))
PYEOF
    printf '%s' "$RESPONSE" | python3 /tmp/.ashell_parse_$$.py
    RC=$?
    rm -f /tmp/.ashell_parse_$$.py
    exit $RC
fi

# ── Konfigurace (ashell.conf: env proměnné + blocklist) ─────────────────
#   ashell --add <cmd>      Přidá příkaz do blocklistu (zakazuje spuštění)
#   ashell --remove <cmd>   Odebere příkaz z blocklistu
#   ashell --list           Zobrazí aktuální blocklist
#   ashell -e / --edit      Otevře celý ashell.conf v $EDITOR (proměnné + blokace).
#                           EDITOR musí být nastaven (export EDITOR=nano|vi|...),
#                           jinak se jen vypíše hláška.
if [ "$1" = "--add" ] || [ "$1" = "--remove" ] || [ "$1" = "--list" ] || [ "$1" = "-e" ] || [ "$1" = "--edit" ]; then
    ACTION="$1"; shift
    TOKEN=$(grep 'name="auth_token"' /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | \
        sed -n 's/.*<string name="auth_token">\([^<]*\)<\/string>.*/\1/p' | head -n 1)

    # Auth args (poziční parametry) se staví AŽ po zachycení <cmd>
    # (set -- by původní argumenty smazal)

    case "$ACTION" in
        --add)
            [ $# -lt 1 ] && { echo "[-] Usage: ashell --add <cmd>" >&2; exit 1; }
            CMD="$1"
            set --
            [ -n "$TOKEN" ] && set -- "$@" --header "Authorization: Bearer $TOKEN"
            curl -s -X POST "$@" -H "Content-Type: application/json" \
                -d "{\"cmd\":\"$CMD\",\"action\":\"add\"}" "${API_URL}/ashell/blocklist" 2>/dev/null | \
                python3 -c 'import sys,json; d=json.load(sys.stdin); print("[+] " + d.get("status","?") + " " + sys.argv[1] + " (blocked_count=" + str(d.get("blocked_count",0)) + ")")' "$CMD" 2>/dev/null \
                || { echo "[-] LocalApiServer neodpovídá na ${API_URL}/ashell/blocklist" >&2; exit 1; }
            ;;
        --remove)
            [ $# -lt 1 ] && { echo "[-] Usage: ashell --remove <cmd>" >&2; exit 1; }
            CMD="$1"
            set --
            [ -n "$TOKEN" ] && set -- "$@" --header "Authorization: Bearer $TOKEN"
            curl -s -X POST "$@" -H "Content-Type: application/json" \
                -d "{\"cmd\":\"$CMD\",\"action\":\"remove\"}" "${API_URL}/ashell/blocklist" 2>/dev/null | \
                python3 -c 'import sys,json; d=json.load(sys.stdin); print("[+] " + d.get("status","?") + " " + sys.argv[1] + " (blocked_count=" + str(d.get("blocked_count",0)) + ")")' "$CMD" 2>/dev/null \
                || { echo "[-] LocalApiServer neodpovídá na ${API_URL}/ashell/blocklist" >&2; exit 1; }
            ;;
        --list)
            set --
            [ -n "$TOKEN" ] && set -- "$@" --header "Authorization: Bearer $TOKEN"
            RESPONSE=$(curl -s "$@" "${API_URL}/ashell/blocklist" 2>/dev/null)
            if [ -z "$RESPONSE" ]; then
                echo "[-] LocalApiServer neodpovídá na ${API_URL}/ashell/blocklist"
                exit 1
            fi
            printf '%s' "$RESPONSE" | python3 -c 'import sys,json; d=json.load(sys.stdin); cmds=d.get("commands",[]); print("Blocklist (" + str(len(cmds)) + ") — zdroj: " + d.get("source","ashell.conf")); [print("  - " + c) for c in cmds] if cmds else print("  (empty — všechny příkazy povoleny)")'
            ;;
        -e|--edit)
            if [ -z "${EDITOR:-}" ]; then
                echo "[-] Proměnná EDITOR není nastavena." >&2
                echo "    Nastav ji např.:  export EDITOR=nano    (nebo vi/vim)" >&2
                echo "    Pak znovu spusť:  ashell -e" >&2
                exit 1
            fi
            set --
            [ -n "$TOKEN" ] && set -- "$@" --header "Authorization: Bearer $TOKEN"
            TMPFILE="/tmp/.ashell_conf_$$.conf"
            curl -s "$@" "${API_URL}/ashell/config" > "$TMPFILE" 2>/dev/null
            if [ ! -s "$TMPFILE" ]; then
                echo "[-] Nelze stáhnout konfiguraci z ${API_URL}/ashell/config" >&2
                rm -f "$TMPFILE"; exit 1
            fi
            echo "[*] Otevírám konfiguraci v $EDITOR (ulož + ukonči pro aplikaci)..." >&2
            echo "    Řádky 'block <cmd>' = blokace, ostatní řádky = env před každým příkazem." >&2
            "$EDITOR" "$TMPFILE"
            RC=$?
            if [ $RC -ne 0 ]; then
                echo "[-] Editor skončil s chybou (RC=$RC) — změny NEbyly uloženy." >&2
                rm -f "$TMPFILE"; exit $RC
            fi
            RESULT=$(curl -s -X POST "$@" -H "Content-Type: text/plain" \
                --data-binary @"$TMPFILE" "${API_URL}/ashell/config" 2>/dev/null)
            if printf '%s' "$RESULT" | grep -q '"config_saved"'; then
                echo "[+] Konfigurace uložena — aplikuje se od dalšího ashell -c / nového host shellu."
            else
                echo "[-] Uložení selhalo: $RESULT" >&2
                rm -f "$TMPFILE"; exit 1
            fi
            rm -f "$TMPFILE"
            ;;
    esac
    exit $?
fi

echo "[*] Opouštím PRoot container → host app shell..."

# ── Metoda 1: cmd/am start (ActivityManager, nepotřebuje curl) ──
if command -v cmd >/dev/null 2>&1; then
    cmd activity start-activity -n "$ACTIVITY" \
        --es rootfsDirName "ashell-host" \
        --ez mountStorage false \
        --ez ashellMode true \
        >/dev/null 2>&1
    RC=$?
    if [ $RC -eq 0 ]; then
        echo "[+] Host shell started (via cmd activity)"
        echo "    Nový terminál otevřen — jste v Android host shellu."
        exit 0
    fi
    echo "[!] cmd activity se nezdařil (RC=$RC), zkouším fallback..." >&2
fi

# ── Metoda 2: curl/wget POST na LocalApiServer (fallback) ──
API_URL="http://127.0.0.1:1337"
HTTP_CLIENT=""

if command -v curl >/dev/null 2>&1; then
    HTTP_CLIENT="curl"
elif command -v wget >/dev/null 2>&1; then
    HTTP_CLIENT="wget"
fi

if [ -z "$HTTP_CLIENT" ]; then
    # Ani curl, ani wget, ani am -> zkusit busybox
    if busybox wget --help >/dev/null 2>&1; then
        HTTP_CLIENT="busybox-wget"
    fi
fi

if [ -z "$HTTP_CLIENT" ]; then
    echo "[-] Error: cmd, curl, ani wget nejsou k dispozici." >&2
    echo "    Nainstaluj curl: apt update && apt install curl -y" >&2
    echo "    nebo spusť ručně:" >&2
    echo "      cmd activity start-activity -n ${ACTIVITY} --es rootfsDirName ashell-host --ez ashellMode true" >&2
    exit 1
fi

# Volitelně přečíst token (není vyžadován pro localhost /ashell)
TOKEN=$(grep 'name="auth_token"' /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | \
    sed -n 's/.*<string name="auth_token">\([^<]*\)<\/string>.*/\1/p' | head -n 1)

case "$HTTP_CLIENT" in
    curl)
        if [ -n "$TOKEN" ]; then
            RESPONSE=$(curl -s -X POST \
                -H "Authorization: Bearer $TOKEN" \
                "${API_URL}/ashell" 2>/dev/null)
        else
            RESPONSE=$(curl -s -X POST "${API_URL}/ashell" 2>/dev/null)
        fi
        ;;
    wget)
        if [ -n "$TOKEN" ]; then
            RESPONSE=$(wget -q -O - --header="Authorization: Bearer $TOKEN" \
                --post-data="" "${API_URL}/ashell" 2>/dev/null)
        else
            RESPONSE=$(wget -q -O - --post-data="" "${API_URL}/ashell" 2>/dev/null)
        fi
        ;;
    busybox-wget)
        if [ -n "$TOKEN" ]; then
            RESPONSE=$(busybox wget -q -O - --header="Authorization: Bearer $TOKEN" \
                --post-data="" "${API_URL}/ashell" 2>/dev/null)
        else
            RESPONSE=$(busybox wget -q -O - --post-data="" "${API_URL}/ashell" 2>/dev/null)
        fi
        ;;
esac

if [ -z "$RESPONSE" ]; then
    echo "[-] Error: LocalApiServer neodpovídá na ${API_URL}/ashell" >&2
    echo "    Zkus ručně: cmd activity start-activity -n ${ACTIVITY} --es rootfsDirName ashell-host --ez ashellMode true" >&2
    exit 1
fi

# Zpracovat JSON odpověď
if command -v python3 >/dev/null 2>&1; then
    echo "$RESPONSE" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    s = d.get('status', 'done')
    u = d.get('uid', '?')
    us = d.get('user', '?')
    pw = d.get('pwd', '?')
    print(f'[+] {s} (uid={u}, user={us})')
    print(f'    Host filesDir: {pw}')
    print()
    print('    Nový terminál otevřen — jste v Android host shellu.')
except Exception:
    print(f'[+] Host shell started!')
    print(f'    (raw: {sys.stdin.read().strip()})')
"
else
    echo "[+] Odpověď ze serveru:"
    echo "$RESPONSE" | sed 's/^/    /'
fi
