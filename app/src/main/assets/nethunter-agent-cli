#!/bin/sh
# NetHunter AI Operator Agent CLI Tool

CONFIG_DIR="$HOME/.config/nethunter"
CONFIG_FILE="$CONFIG_DIR/agent.json"
PID_FILE="/tmp/nethunter_agent.pid"

usage() {
    echo "Usage: nethunter-agent-cli [config|start|stop|status|ask|chat]"
    echo "Commands:"
    echo "  config --provider <gemini|openai|anthropic|ollama> --key <key> [--model <model_name>]"
    echo "  start               Start the background Agent daemon"
    echo "  stop                Stop the Agent daemon"
    echo "  status              Check daemon status"
    echo "  ask <prompt...>     Send a query directly to the agent (synchronous CLI)"
    echo "  chat                Start the interactive Voice & Text Chat TUI Console"
    exit 1
}

ensure_config() {
    mkdir -p "$CONFIG_DIR"
    if [ ! -f "$CONFIG_FILE" ]; then
        echo '{"provider":"gemini","key":"","model":"gemini-2.0-flash"}' > "$CONFIG_FILE"
    fi
}

case "$1" in
    config)
        shift
        provider=""
        key=""
        model=""
        
        while [ $# -gt 0 ]; do
            case "$1" in
                --provider) provider="$2"; shift 2 ;;
                --key) key="$2"; shift 2 ;;
                --model) model="$2"; shift 2 ;;
                *) echo "Unknown parameter: $1"; usage ;;
            esac
        done
        
        if [ -z "$provider" ] && [ -z "$key" ] && [ -z "$model" ]; then
            echo "Error: Specify at least one configuration value to update."
            usage
        fi
        
        ensure_config
        
        # Temp parse/merge json via primitive python command to avoid external jq dependency
        python3 -c "
import json, sys
data = json.load(open('$CONFIG_FILE'))
if '$provider': data['provider'] = '$provider'
if '$key': data['key'] = '$key'
if '$model': data['model'] = '$model'
else:
    # Set default model if provider changed and model not specified
    if '$provider' == 'gemini': data['model'] = 'gemini-2.0-flash'
    elif '$provider' == 'openai': data['model'] = 'gpt-4o-mini'
    elif '$provider' == 'anthropic': data['model'] = 'claude-3-5-sonnet-20240620'
    elif '$provider' == 'ollama': data['model'] = 'llama3'
json.dump(data, open('$CONFIG_FILE', 'w'), indent=2)
"
        echo "[+] Configuration updated successfully in $CONFIG_FILE"
        cat "$CONFIG_FILE"
        ;;
        
    start)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "[*] NetHunter Agent Daemon is already running (PID: $(cat $PID_FILE))"
            exit 0
        fi
        
        echo "[*] Launching NetHunter Agent Daemon..."
        nohup python3 /usr/local/bin/nethunter_agent.py > /tmp/nethunter_agent.log 2>&1 &
        echo $! > "$PID_FILE"
        sleep 1
        if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "[+] Agent daemon successfully started on background (PID: $(cat $PID_FILE))"
        else
            echo "[-] Error: Daemon failed to start. Logs:"
            cat /tmp/nethunter_agent.log
        fi
        ;;
        
    stop)
        if [ -f "$PID_FILE" ]; then
            pid=$(cat "$PID_FILE")
            echo "[*] Stopping NetHunter Agent Daemon (PID: $pid)..."
            kill "$pid" 2>/dev/null
            rm -f "$PID_FILE"
            echo "[-] Agent daemon stopped."
        else
            # Fallback
            pkill -f nethunter_agent.py
            echo "[-] Checked and stopped any running instances of agent."
        fi
        ;;
        
    status)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "🟢 NetHunter Agent Daemon is RUNNING (PID: $(cat $PID_FILE))"
        else
            echo "🔴 NetHunter Agent Daemon is STOPPED"
        fi
        ;;
        
    ask)
        shift
        if [ $# -eq 0 ]; then
            echo "Error: Prompt cannot be empty."
            usage
        fi
        python3 /usr/local/bin/nethunter_agent.py run-direct "$*"
        ;;
        
    chat)
        python3 /usr/local/bin/nethunter_agent.py chat
        ;;
        
    *)
        usage
        ;;
esac
