#!/bin/sh
# usbtool — guest wrapper pro Magisk modul custom_usb_g2_setup.
#
# Ovládá USB gadget g2 (HID + MassStorage + RNDIS) PŘÍMO — bez LocalApiServer
# a bez API tokenu. V guestu spouští hostitelskou binárku /system/bin/usbtool
# pod real rootem přes `sudo` (su_daemon re-entry do PRoot jako root 0).
#
# configfs /config/usb_gadget je do guesta bindnutý (ProotManager bind_usb),
# takže skripty modulu vidí gadgety na standardní cestě.
#
# Na hostu (mimo guest) se používá přímo /system/bin/usbtool.

MODULE_USBTOOL="/system/bin/usbtool"

usage() {
    echo "Usage: usbtool <command> [args...]"
    echo ""
    echo "Ovládání USB gadget modulu (běží pod real rootem):"
    echo "  status                Stav gadgetů, UDC, USB režimu"
    echo "  g1 | g2               Přepnutí aktivního gadgetu"
    echo "  setup                 Znovu vytvořit konfiguraci g2 v configfs"
    echo "  normal|brom|preloader Režim g2 + setup"
    echo "  host | device         USB host (OTG) / gadget režim portu"
    echo "  detect                Výpis připojených USB zařízení"
    echo "  logs                  Logy modulu"
    exit 1
}

[ $# -eq 0 ] && usage
case "$1" in
    help|--help|-h) usage ;;
esac

# Najdi modulovou binárku
if [ ! -x "$MODULE_USBTOOL" ]; then
    echo "usbtool: $MODULE_USBTOOL nenalezen — je nainstalovaný Magisk modul custom_usb_g2_setup?" >&2
    exit 127
fi

# Už root? (např. jsme už pod sudo) → spusť přímo.
if [ "$(id -u)" = "0" ]; then
    exec "$MODULE_USBTOOL" "$@"
fi

# Jinak eskaluj přes sudo (su_daemon re-entry do PRoot jako real root).
if command -v sudo >/dev/null 2>&1; then
    exec sudo "$MODULE_USBTOOL" "$@"
fi

# Fallback: přímé su (mimo PRoot, např. z host shellu)
if command -v su >/dev/null 2>&1; then
    exec su -c "$MODULE_USBTOOL $*"
fi

echo "usbtool: ani sudo ani su k dispozici — nelze získat root" >&2
exit 126