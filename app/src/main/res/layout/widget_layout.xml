<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Hlavička: název widgetu + status -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● 0 aktivních session"
        android:textColor="#00FF41"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingBottom="4dp" />

    <!-- Hlavní oblast: cube face render area (bude se do ní pushovat bitmapa) -->
    <ImageView
        android:id="@+id/cube_face"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="Cube face" />

    <!-- 2x2 grid buněk notebooku (překrývá cube_face, používá se jako klikací zóny) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/cell_1"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_button_bg"
                android:gravity="center"
                android:text="SÍŤ: ip addr show..."
                android:textColor="#00FF41"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/cell_2"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_bg"
                android:gravity="center"
                android:text="VPN: curl vpn..."
                android:textColor="#00FF41"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cell_3"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_button_bg"
                android:gravity="center"
                android:text="LOGY: tail syslog..."
                android:textColor="#00FF41"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/cell_4"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_bg"
                android:gravity="center"
                android:text="SKEN: nmap scan..."
                android:textColor="#00FF41"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dolní lišta: šipky pro rotaci + akční tlačítka -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center">

        <TextView
            android:id="@+id/arrow_prev"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="◀"
            android:textColor="#00FF41"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/widget_button_bg" />

        <TextView
            android:id="@+id/action_btn_1"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="VPN"
            android:textColor="#00FF41"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/widget_button_bg"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/action_btn_2"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="KALI"
            android:textColor="#00FF41"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/widget_button_bg"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/action_btn_3"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="PARROT"
            android:textColor="#00FF41"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/widget_button_bg"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/action_btn_4"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="STOP"
            android:textColor="#FF4444"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/widget_button_bg" />

        <TextView
            android:id="@+id/arrow_next"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#00FF41"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/widget_button_bg"
            android:layout_marginStart="2dp" />
    </LinearLayout>

</LinearLayout>
