<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only MITM network security configuration.

  This file is NOT referenced by the production AndroidManifest. To enable the
  system-wide MITM Root CA:

    1. Generate a CA (e.g. `openssl req -x509 -newkey rsa:2048 -nodes -keyout mitm-ca.key
       -out mitm-ca.crt -days 3650 -subj "/CN=NetHunter MITM (debug)"`).
    2. Drop the DER-encoded cert at `app/src/main/res/raw/mitm_ca.der`.
    3. Uncomment the <debug-overrides> block below and the
       <certificates src="@raw/mitm_ca"/> entry.
    4. Call RootCaInstaller.requestSystemInstall() in MainActivity.onCreate.
    5. Ship a debug build only.

  Kept separate so a stray merge never pushes it into the release build.
-->
<network-security-config>
    <!--
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/mitm_ca"/>
        </trust-anchors>
    </debug-overrides>
    -->
</network-security-config>
