#!/bin/zsh
# mbuild — NetHunter full build pipeline
# Usage: zsh mbuild [all|native|build]
#   all      = upload + native compile + APK build (complete flow)
#   native   = NDK-only compile (no APK rebuild)
#   build    = pull binaries → upload → APK build
#
# ⚠️ PRAVIDLO (AGENTS.md): Nativní binárky se VŽDY nejdřív stáhnou
#    z Volume do lokálního app/src/main/assets/, pak teprve proběhne
#    upload_src a APK build. Bez pull by rsync --delete v upload_src
#    smazal binárky z Volume (nejsou v baked image) → APK by byl bez
#    su_daemon/su_wrapper/usb_bridge. Viz AGENTS.md „Native build pipeline“.
set -e

SRC="${KALI_PROJECT_DIR:-.}"
CMD="${1:-all}"

cd "$SRC"

# Nativní binárky, které musí být vždy v app/src/main/assets/ před upload+build.
# Při přidání nového native modulu: přidej jeho výstup sem A do build_native.
NATIVE_BINARIES=(su_daemon su_wrapper usb_bridge)

pull_binaries() {
    echo "  → pull native binaries from Volume to assets"
    for bin in $NATIVE_BINARIES; do
        if modal volume get --force kali-build-data "src/app/src/main/assets/$bin" "app/src/main/assets/$bin" >/dev/null 2>&1; then
            echo "    ✓ $bin ($(stat -c%s "app/src/main/assets/$bin" 2>/dev/null || echo '?') B)"
        else
            echo "    ⚠ $bin nenalezen na Volume — zkompiluje ho build_native"
        fi
    done
}

case "$CMD" in
    all)
        echo "=== FULL BUILD ==="
        echo "  → upload source"
        modal run modal_build.py::upload_src 2>&1 | tail -3
        echo "  → NDK compile"
        modal run modal_build.py::build_native > build.log | cat
        echo "  → Gradle build"
        modal run modal_build.py::build > build.log | cat
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download 2>&1
        ;;
    native)
        modal run modal_build.py::upload_src 2>&1 | tail -3
        modal run modal_build.py::build_native > build.log | cat
        echo "  → pull binaries to local assets (aby APK build je měl)"
        pull_binaries
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download 2>&1
        ;;
    build)
        echo "=== APK BUILD ==="
        echo "  1) pull native binaries → assets"
        pull_binaries
        echo "  2) upload source"
        modal run modal_build.py::upload_src 2>&1 | tail -3
        echo "  3) Gradle build"
        modal run modal_build.py::build > build.log | cat
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download 2>&1
        ;;
    *)
        echo "Usage: zsh mbuild [all|native|build]"
        exit 1
        ;;
esac