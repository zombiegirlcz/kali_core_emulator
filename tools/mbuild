#!/bin/zsh
# mbuild — NetHunter build pipeline
# Usage: zsh mbuild <command>
#
# SYNC (vždy samostatně, před buildem):
#   sync  = git clone/pull PŘÍMO Z GITHUBU na Modal straně (žádný upload z telefonu)
#   clean = smaže src + gradle-cache na Volume (builds zůstávají)
#
# Než spustíš sync, musíš mít lokální commity na GitHubu:
#   git add -A && git commit -m "..." && git push
#
# BUILD (předpokládá, že sync už proběhl):
#   all       = sync + SMART inkrementální build (proot/native/gradle, -f=force)
#   native    = native compile + pull assets
#   build     = APK build + pull APK
#   usrtools  = native compile (usrtools) + pull assets
#   proot     = proot static build + pull assets
#
# PRAVIDLO: Sync se VŽDY dělá zvlášť. Build nikdy nevolá sync.
# Zdroj pravdy je teď GitHub, ne lokální disk. Native binárky se po
# build_native pořád stahují zpět do lokálního repa (pull_full_assets),
# musíš je jen commitnout + pushnout, ať je má i GitHub.
set -e
set -o pipefail

SRC="${KALI_PROJECT_DIR:-$PWD}"
CMD="${1:-}"

cd "$SRC"

# Aktuální lokální branch — jde vždy explicitně jako --branch do modal_build.py::sync.
# `modal run modal_build.py::sync` volá funkci PŘÍMO a obchází local_entrypoint (main()),
# takže _detect_branch() uvnitř modal_build.py se v tomto volání nikdy nespustí — bez
# tohoto by sync vždy spadl na fallback GITHUB_BRANCH bez ohledu na to, na jaké branch jsi.
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo dev)"

# ── Pull celého assets z Volume do lokálního app/src/main/assets ──
pull_full_assets() {
    echo "  -> pull CELÝ assets z Volume -> app/src/main/assets/"
    if modal volume get --force  kali-build-data src/app/src/main/assets $SRC/app/src/main/ >/dev/null 2>&1; then
        echo "    [OK] assets/ ($(du -sh $SRC/app/src/main/assets 2>/dev/null | cut -f1))"
        echo "    [OK] su_daemon ($(stat -c%s $SRC/app/src/main/assets/su_daemon 2>/dev/null || echo '?') B)"
        echo "    [OK] su_wrapper ($(stat -c%s $SRC/app/src/main/assets/su_wrapper 2>/dev/null || echo '?') B)"
        echo "    [OK] usb_bridge ($(stat -c%s $SRC/app/src/main/assets/usb_bridge 2>/dev/null || echo '?') B)"
    else
        echo "    [WARN] assets nenalezen na Volume — zkompiluje je build_native"
    fi
    echo "  -> pull jniLibs z Volume -> app/src/main/jniLibs/"
    if modal volume get --force  kali-build-data src/app/src/main/jniLibs $SRC/app/src/main/ >/dev/null 2>&1; then
        echo "    [OK] jniLibs/ ($(du -sh $SRC/app/src/main/jniLibs 2>/dev/null | cut -f1))"
        local shelld_size=$(stat -c%s $SRC/app/src/main/jniLibs/arm64-v8a/libshelldaemon.so 2>/dev/null || echo '0')
        echo "    [OK] libshelldaemon.so ($shelld_size B)"
        if [ "$shelld_size" -lt 1000 ]; then
            echo "    [FATAL] libshelldaemon.so je příliš malý nebo neexistuje (< 1000 B)"
            exit 1
        fi
    else
        echo "    [WARN] jniLibs nenalezen na Volume — zkompiluje je build_native"
    fi
    echo "  -> pull magisk-modules z Volume -> magisk-modules/"
    if modal volume get --force  kali-build-data src/magisk-modules $SRC/ >/dev/null 2>&1; then
        echo "    [OK] magisk-modules/ ($(du -sh $SRC/magisk-modules 2>/dev/null | cut -f1))"
        echo "    [OK] custom_usb_g2_setup ($(du -sh $SRC/magisk-modules/custom_usb_g2_setup 2>/dev/null | cut -f1 || echo '?'))"
    else
        echo "    [WARN] magisk-modules nenalezen na Volume"
    fi
}

# ── Ochrana lokálních změn před pull_full_assets ──
# `modal volume get --force` přepíše assets/jniLibs/magisk-modules verzí z Volume
# (= poslední push na GitHub + build artefakty). Necommitnuté lokální úpravy
# (např. assets/nh, usr/bin/boot) by se tiše ztratily → zastavit PŘED buildem.
# Přebití: MBUILD_FORCE_PULL=1.
check_pull_paths_clean() {
    [ "${MBUILD_FORCE_PULL:-0}" = "1" ] && return 0
    local dirty
    dirty="$(git -C "$SRC" status --porcelain --untracked-files=no -- \
        app/src/main/assets app/src/main/jniLibs magisk-modules 2>/dev/null || true)"
    if [ -n "$dirty" ]; then
        echo "  [FATAL] Necommitnuté změny v cestách, které pull_full_assets přepíše:"
        echo "$dirty" | sed 's/^/      /'
        echo "  Commitni + pushni (pak sync), nebo spusť s MBUILD_FORCE_PULL=1."
        exit 1
    fi
}

# ── Fail-fast check před buildem ──
check_native_binaries() {
    echo "  -> Kontrola přítomnosti kritických binárek..."
    local shelld="$SRC/app/src/main/jniLibs/arm64-v8a/libshelldaemon.so"
    if [ ! -f "$shelld" ]; then
        echo "    [FATAL] libshelldaemon.so neexistuje — spusť nejdřív 'zsh mbuild native'"
        exit 1
    fi
    local size=$(stat -c%s "$shelld" 2>/dev/null || echo '0')
    if [ "$size" -lt 1000 ]; then
        echo "    [FATAL] libshelldaemon.so je příliš malý ($size B) — build selhal"
        exit 1
    fi
    echo "    [OK] libshelldaemon.so ($size B)"
}

case "$CMD" in
    all|native|smart|pull|proot) check_pull_paths_clean ;;
esac

case "$CMD" in
    # ── SYNC příkazy ──
    sync)
        echo "=== SYNC (git fetch + reset --hard origin/${BRANCH}) ==="
        modal run modal_build.py::sync --branch "$BRANCH" 2>&1 | tail -10
        ;;
    clean)
        echo "=== CLEAN (smaže src + gradle-cache na Volume) ==="
        modal run modal_build.py::clean 2>&1 | tail -5
        ;;

    # ── BUILD příkazy (předpokládají, že sync proběhl) ──
    all)
        FORCE=""
        for a in "$@"; do
            case "$a" in -f|--force) FORCE="--force";; esac
        done
        echo "=== SMART BUILD (sync + inkrementální proot/native/gradle, branch: ${BRANCH})${FORCE:+ [FORCE]} ==="
        modal run modal_build.py::sync --branch "$BRANCH" 2>&1 | tee build.log
        if [ -n "$FORCE" ]; then
            modal run modal_build.py::smart_build --force 2>&1 | tee -a build.log
        else
            modal run modal_build.py::smart_build 2>&1 | tee -a build.log
        fi
        echo "  -> pull CELÝ assets"
        pull_full_assets
        echo "  -> APK download"
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download/kali_core.apk 2>&1 \
            || echo "    [WARN] stažení APK selhalo (builds/app-debug.apk na Volume?)"
        ;;

    native)
        echo "=== NATIVE BUILD ==="
        echo "  -> NDK compile"
        modal run modal_build.py::build_native 2>&1 | tee build.log
        echo "  -> pull CELÝ assets"
        pull_full_assets
        ;;
    build)
        echo "=== APK BUILD ==="
        check_native_binaries
        echo "  -> Gradle build"
        modal run modal_build.py::build 2>&1 | tee build.log
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download/kali_core.apk 2>&1 \
            || { echo "    [FATAL] stažení APK selhalo (builds/app-debug.apk na Volume?)"; exit 1; }
        ;;

    smart)
        echo "=== SMART BUILD (inkrementální proot/native/gradle) ==="
        modal run modal_build.py::smart_build 2>&1 | tee build.log
        echo "  -> pull CELÝ assets"
        pull_full_assets
        echo "  -> APK download"
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download/kali_core.apk 2>&1 \
            || echo "    [WARN] stažení APK selhalo (builds/app-debug.apk na Volume?)"
        ;;
     pull)
	pull_full_assets
	;;
# usrtools)
    #    echo "=== USRTOOLS BUILD (nano/rsync/sed/rg) ==="
     #   echo "  -> native build (usrtools)"
      #  modal run modal_build.py::build_native 2>&1 | tee build.log
       # echo "  -> pull CELÝ assets"
       # pull_full_assets
     #   ;;
  proot)
        echo "=== PROOT STATIC BUILD (termux fork, talloc linked in) ==="
        echo "  -> proot + loader cross-compile (4 ABI)"
        modal run tools/modal_build.py::build_proot_static 2>&1 | cat
        echo "  -> pull CELÝ assets"
        pull_full_assets
        ;;
    *)
        echo "Usage: zsh mbuild [sync|clean|all|native|build|usrtools|proot]"
        exit 1
        ;;
esac
