#!/bin/zsh
# mbuild — NetHunter build pipeline
# Usage: zsh mbuild <command>
#
# UPLOAD (vždy samostatně, před buildem):
#   upload       = rsync bez --delete (jen přidá/aktualizuje)
#   upload_force = rsync --delete (plná synchronizace, smaže co není lokálně)
#   upload_clean = smaže src + gradle-cache na Volume (builds zůstávají)
#
# BUILD (předpokládá, že upload už proběhl):
#   all       = native compile + pull assets + APK build
#   native    = native compile + pull assets
#   build     = APK build + pull APK
#   usrtools  = native compile (usrtools) + pull assets
#   usbtools  = USB tools build + pull assets
#   proot     = proot static build + pull assets
#
# PRAVIDLO: Upload se VŽDY dělá zvlášť. Build nikdy nevolá upload.
# Zdroj pravdy pro native binárky je Volume (build_native je tam kompiluje).
# Po native buildu se dělá pull_full_assets zpět do lokálního repa.
set -e

SRC="${KALI_PROJECT_DIR:-.}"
CMD="${1:-}"

cd "$SRC"

# ── Pull celého assets z Volume do lokálního app/src/main/assets ──
pull_full_assets() {
    echo "  -> pull CELÝ assets z Volume -> app/src/main/assets/"
    if modal volume get --force kali-build-data "src/app/src/main/assets" "app/src/main/" >/dev/null 2>&1; then
        echo "    [OK] assets/ ($(du -sh app/src/main/assets 2>/dev/null | cut -f1))"
        echo "    [OK] su_daemon ($(stat -c%s app/src/main/assets/su_daemon 2>/dev/null || echo '?') B)"
        echo "    [OK] su_wrapper ($(stat -c%s app/src/main/assets/su_wrapper 2>/dev/null || echo '?') B)"
        echo "    [OK] usb_bridge ($(stat -c%s app/src/main/assets/usb_bridge 2>/dev/null || echo '?') B)"
    else
        echo "    [WARN] assets nenalezen na Volume — zkompiluje je build_native"
    fi
}

case "$CMD" in
    # ── UPLOAD příkazy ──
    upload)
        echo "=== UPLOAD (basic, bez --delete) ==="
        modal run modal_build.py::upload_basic 2>&1 | tail -5
        ;;
    upload_force)
        echo "=== UPLOAD FORCE (rsync --delete) ==="
        modal run modal_build.py::upload_force 2>&1 | tail -5
        ;;
    upload_clean)
        echo "=== UPLOAD CLEAN (smaže src + gradle-cache) ==="
        modal run modal_build.py::upload_clean 2>&1 | tail -5
        ;;

    # ── BUILD příkazy (předpokládají, že upload proběhl) ──
    all)
        echo "=== FULL BUILD (native + APK) ==="
        echo "  -> NDK compile"
        modal run modal_build.py::build_native > build.log | cat
        echo "  -> pull CELÝ assets ihned po build_native"
        pull_full_assets
        echo "  -> Gradle build"
        modal run modal_build.py::build > build.log | cat
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download 2>&1
        ;;
    native)
        echo "=== NATIVE BUILD ==="
        echo "  -> NDK compile"
        modal run modal_build.py::build_native > build.log | cat
        echo "  -> pull CELÝ assets"
        pull_full_assets
        ;;
    build)
        echo "=== APK BUILD ==="
        echo "  -> Gradle build"
        modal run modal_build.py::build > build.log | cat
        modal volume get --force kali-build-data builds/app-debug.apk ~/Download 2>&1 || true
        ;;
    usrtools)
        echo "=== USRTOOLS BUILD (nano/rsync/sed/rg) ==="
        echo "  -> native build (usrtools)"
        modal run modal_build.py::build_native > build.log | cat
        echo "  -> pull CELÝ assets"
        pull_full_assets
        ;;
    usbtools)
        echo "=== USBTOOLS BUILD (libusbgx/usbutils/usbrelayd) ==="
        echo "  -> usb tools build"
        modal run modal_build.py::build_usb_tools > build.log | cat
        echo "  -> pull CELÝ assets"
        pull_full_assets
        ;;
    proot)
        echo "=== PROOT STATIC BUILD (termux fork, talloc linked in) ==="
        echo "  -> proot + loader cross-compile (4 ABI)"
        modal run modal_build.py::build_proot_static > build.log | cat
        echo "  -> pull CELÝ assets"
        pull_full_assets
        ;;
    *)
        echo "Usage: zsh mbuild [upload|upload_force|upload_clean|all|native|build|usrtools|usbtools|proot]"
        exit 1
        ;;
esac
