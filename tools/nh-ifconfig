#!/bin/sh
# nh-ifconfig - nice network interface info for NetHunter PRoot
# Uses the LocalApiServer (/shell endpoint) to run Android binaries
# Usage: nh-ifconfig [interface]

RST='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'

API_URL="http://127.0.0.1:1337"

get_token() {
    TOKEN=$(cat /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | \
        grep 'name="auth_token"' | sed 's/.*value="\([^"]*\)".*/\1/' | head -n 1)
    if [ -z "$TOKEN" ]; then
        TOKEN=$(cat /data/data/com.linux_core/shared_prefs/api_security.xml 2>/dev/null | \
            grep 'name="auth_token"' | sed "s/.*value='\([^']*\)'.*/\1/" | head -n 1)
    fi
    echo "$TOKEN"
}

TOKEN=$(get_token)

run_android_cmd() {
    cmd="$1"
    data=$(curl -s -H "Authorization: Bearer $TOKEN" -X POST -d "$cmd" "${API_URL}/shell" 2>/dev/null)
    echo "$data" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    exit_code = d.get('exit_code', 1)
    stdout = d.get('stdout', '')
    stderr = d.get('stderr', '')
    if exit_code == 0:
        print(stdout, end='')
    else:
        print(stderr, end='', file=sys.stderr)
        sys.exit(exit_code)
except Exception as e:
    print(f'Error: {e}', file=sys.stderr)
    sys.exit(1)
"
}

banner() {
  printf "${MAGENTA}${BOLD}"
  printf "  ╔══════════════════════════════════════╗\n"
  printf "  ║     🌐  NetHunter Interface Info      ║\n"
  printf "  ╚══════════════════════════════════════╝\n"
  printf "${RST}\n"
}

format_bytes() {
  val=$1
  if [ "$val" -ge 1073741824 ]; then
    printf "%.2f GB" $(echo "scale=2; $val / 1073741824" | bc -l 2>/dev/null || echo 0)
  elif [ "$val" -ge 1048576 ]; then
    printf "%.2f MB" $(echo "scale=2; $val / 1048576" | bc -l 2>/dev/null || echo 0)
  elif [ "$val" -ge 1024 ]; then
    printf "%.2f KB" $(echo "scale=2; $val / 1024" | bc -l 2>/dev/null || echo 0)
  else
    printf "%d B" $val
  fi
}

show_iface() {
  iface=$1

  # Determine emoji
  case "$iface" in
    lo*)  emoji="🔗" ;;
    wlan*|wifi*|wl*) emoji="📶" ;;
    eth*|en*) emoji="🔌" ;;
    rmnet*|ccmni*|wwan*) emoji="📱" ;;
    tun*|tap*) emoji="🔐" ;;
    bnep*|bt*) emoji="🔵" ;;
    docker*|br-*) emoji="🐳" ;;
    *) emoji="🔌" ;;
  esac

  printf "\n"
  printf "  ${BOLD}$emoji  $iface${RST}\n"

  # Run ifconfig for this interface to get details
  ifconfig_out=$(run_android_cmd "ifconfig $iface" 2>/dev/null)
  ip_out=$(run_android_cmd "ip addr show $iface" 2>/dev/null)
  iw_out=$(run_android_cmd "iw dev $iface info 2>/dev/null || iwconfig $iface 2>/dev/null" 2>/dev/null)

  # Extract info from ifconfig output
  mac=""
  state="unknown"
  mtu=""
  ips=""
  mask=""
  rx_b=0
  tx_b=0
  rx_p=0
  tx_p=0
  rx_e=0
  tx_e=0

  # Parse ifconfig output
  while IFS= read -r line; do
    case "$line" in
      *Link\ encap*|*flags=*)
        # Get MAC
        mac=$(echo "$line" | grep -oE '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' | head -1)
        [ -z "$mac" ] && mac=$(echo "$line" | grep -oE 'ether [0-9a-f:]+' | awk '{print $2}')
        # Get state from flags
        if echo "$line" | grep -qi "UP\|RUNNING" >/dev/null 2>&1; then
          state="up"
        else
          state="down"
        fi
        # Get MTU
        mtu=$(echo "$line" | grep -oE 'mtu [0-9]+' | awk '{print $2}')
        ;;
      *inet\ *)
        ip=$(echo "$line" | awk '{print $2}')
        [ -z "$ips" ] && ips="$ip" || ips="$ips $ip"
        ;;
      *inet6\ *)
        ipv6=$(echo "$line" | awk '{print $2}' | cut -d% -f1)
        [ -z "$ipv6s" ] && ipv6s="$ipv6" || ipv6s="$ipv6s $ipv6"
        ;;
      *RX\ packets*|*RX:*)
        rxp=$(echo "$line" | grep -oE '[0-9]+' | head -1)
        rxb=$(echo "$line" | grep -oE '[0-9]+' | tail -1)
        [ -n "$rxp" ] && rx_p=$rxp
        [ -n "$rxb" ] && [ "$rxb" != "0" ] && rx_b=$rxb
        ;;
      *TX\ packets*|*TX:*)
        txp=$(echo "$line" | grep -oE '[0-9]+' | head -1)
        txb=$(echo "$line" | grep -oE '[0-9]+' | tail -1)
        [ -n "$txp" ] && tx_p=$txp
        [ -n "$txb" ] && [ "$txb" != "0" ] && tx_b=$txb
        ;;
      *errors*)
        re=$(echo "$line" | grep -oE 'errors:[0-9]+' | cut -d: -f2)
        te=$(echo "$line" | grep -oE 'errors:[0-9]+' | cut -d: -f2)
        [ -n "$re" ] && rx_e=$re
        [ -n "$te" ] && tx_e=$te
        ;;
    esac
  done <<EOF
$ifconfig_out
EOF

  # Parse ip addr output for IPs if ifconfig didn't give them
  if [ -z "$ips" ]; then
    ips=$(echo "$ip_out" | grep -oE 'inet [0-9.]+/[0-9]+' | awk '{print $2}' | tr '\n' ' ')
  fi
  if [ -z "$ipv6s" ]; then
    ipv6s=$(echo "$ip_out" | grep -oE 'inet6 [0-9a-f:]+' | awk '{print $2}' | cut -d% -f1 | tr '\n' ' ')
  fi

  # Get SSID for WiFi interfaces
  ssid=""
  if echo "$iface" | grep -qiE "wlan|wifi|wl" >/dev/null 2>&1; then
    if echo "$iw_out" | grep -qi "ssid" >/dev/null 2>&1; then
      ssid=$(echo "$iw_out" | grep -i "ssid" | head -1 | sed 's/.*SSID:\s*//; s/^"//; s/"$//')
    fi
    # Also try from API
    if [ -z "$ssid" ]; then
      wifi_data=$(curl -s -H "Authorization: Bearer $TOKEN" "${API_URL}/wifi" 2>/dev/null)
      ssid=$(echo "$wifi_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('ssid',''))" 2>/dev/null)
    fi
  fi

  # State badge
  if [ "$state" = "up" ]; then
    state_colored="${GREEN}UP${RST}"
  else
    state_colored="${RED}DOWN${RST}"
  fi

  # Print
  printf "  ${DIM}│${RST} ${DIM}State:${RST}    ${state_colored}\n"
  [ -n "$mac" ] && printf "  ${DIM}│${RST} ${DIM}MAC:${RST}       ${GRAY}$mac${RST}\n"
  [ -n "$mtu" ] && printf "  ${DIM}│${RST} ${DIM}MTU:${RST}       $mtu\n"

  if [ -n "$ssid" ]; then
    printf "  ${DIM}│${RST} ${DIM}SSID:${RST}      ${CYAN}$ssid${RST}\n"
  fi

  # IPs
  if [ -n "$ips" ]; then
    for ip in $ips; do
      # Hide link-local and loopback
      case "$ip" in
        127.*|::1|fe80:*) continue ;;
      esac
      printf "  ${DIM}│${RST} ${DIM}IPv4:${RST}      ${CYAN}$ip${RST}\n"
    done
  fi
  if [ -n "$ipv6s" ]; then
    for v6 in $ipv6s; do
      case "$v6" in
        ::1|fe80:*) continue ;;
      esac
      printf "  ${DIM}│${RST} ${DIM}IPv6:${RST}      ${YELLOW}$v6${RST}\n"
    done
  fi

  # Traffic
  if [ "$rx_b" -gt 0 ] || [ "$tx_b" -gt 0 ]; then
    printf "  ${DIM}│${RST} ${DIM}RX:${RST}        $(format_bytes $rx_b)  ($rx_p pkts, $rx_e err)\n"
    printf "  ${DIM}│${RST} ${DIM}TX:${RST}        $(format_bytes $tx_b)  ($tx_p pkts, $tx_e err)\n"
  fi
}

# --- MAIN ---
banner

# Check API connectivity
api_check=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 "${API_URL}/" 2>/dev/null)
if [ "$api_check" != "200" ] && [ "$api_check" != "302" ]; then
  printf "  ${RED}✗ LocalApiServer not reachable (HTTP $api_check)${RST}\n"
  printf "  ${DIM}  Make sure the NetHunter app is running.${RST}\n"
  printf "  ${DIM}  Falling back to local /sys/class/net/...${RST}\n\n"

  # Fallback: try reading /sys/class/net/ directly
  if [ -d /sys/class/net ]; then
    if [ -n "$1" ]; then
      iface_dir="/sys/class/net/$1"
      if [ -d "$iface_dir" ]; then
        show_iface "$1"
      else
        echo "Interface '$1' not found"
        exit 1
      fi
    else
      for iface_dir in /sys/class/net/*/; do
        show_iface "$(basename "$iface_dir")"
      done
    fi
  else
    printf "  ${RED}✗ /sys/class/net/ not accessible${RST}\n"
    printf "  ${DIM}  Try: curl -4 ifconfig.me${RST}\n"
    exit 1
  fi
  exit 0
fi

# Get list of interfaces
if [ -n "$1" ]; then
  show_iface "$1"
else
  # Get all interfaces from Android
  ifconfig_out=$(run_android_cmd "ifconfig -a 2>/dev/null || ifconfig 2>/dev/null")
  interfaces=$(echo "$ifconfig_out" | grep -E '^[a-zA-Z0-9_]+' | grep -oE '^[^ ]+' | sort -u)

  for iface in $interfaces; do
    show_iface "$iface"
  done
fi

# Public IP at the end
printf "\n"
public_ip=$(curl -s -H "Authorization: Bearer $TOKEN" -X POST -d "curl -4 -s --max-time 3 ifconfig.me" "${API_URL}/shell" 2>/dev/null | \
  python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('stdout','').strip())" 2>/dev/null)
if [ -n "$public_ip" ]; then
  printf "  ${DIM}│${RST} ${GRAY}💡 ${DIM}Public IP:${RST}  ${GREEN}$public_ip${RST}\n"
fi
printf "\n"
